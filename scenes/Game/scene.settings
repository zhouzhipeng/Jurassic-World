"PartPillar",
"PartWall",
"PartDoorframe",
"PartCeiling",
"PartDoor",
"PartStairs",
"BuiltShelter",
"BuiltPalisade",
"BuiltCampfire"
]
Buildings = [ "BuiltShelter", "BuiltPalisade", "BuiltCampfire" ]
BuildGhosts = [
"PartFoundationValid",
"PartFoundationInvalid",
"PartPillarValid",
"PartPillarInvalid",
"PartWallValid",
"PartWallInvalid",
"PartDoorframeValid",
"PartDoorframeInvalid",
"PartCeilingValid",
"PartCeilingInvalid",
"PartDoorValid",
"PartDoorInvalid",
"PartStairsValid",
"PartStairsInvalid",
"BuiltShelterValid",
"BuiltShelterInvalid",
"BuiltPalisadeValid",
"BuiltPalisadeInvalid",
"BuiltCampfireValid",
"BuiltCampfireInvalid"
]
Wildlife = [ "Triceratops", "Stegosaur", "Raptor", "Tyrannosaur" ]
Predators = [ "Raptor", "Tyrannosaur" ]
HarvestNodes = [
"BerryBush",
"FiberFern",
"WoodSapling",
"StoneDeposit",
"MetalDeposit"
]
SurvivalFires = [ "CampHearth", "BuiltCampfire" ]

[[variables]]
name = "JumpVelocity"
type = "number"
value = 0

[[variables]]
name = "JumpPreviousZ"
type = "number"
value = 0

[[variables]]
name = "JumpStartTime"
type = "number"
value = 0

[[variables]]
name = "JumpLandTime"
type = "number"
value = 0

[layout]
version = 1
background = "#72BBDD"

[layout.editor]
grid = false
grid_type = "rectangular"
grid_size = [32, 32, 32]
grid_offset = [0, 0, 0]
grid_color = "#9EB4FF"
grid_alpha = 0.8
snap = false
zoom = 0.21802879174183437
window_mask = false
selected_layer = ""
mode = "instances-editor"

[[layout.layers]]
id = "base"
name = ""
rendering = "2d"
cameras = [{ size = "default", viewport = "default" }]

[[layout.layers]]
id = "world3d"
name = "World3D"
rendering = "3d"
camera_type = "perspective"
camera_behavior = "do-nothing"
near = 5
far = 60000
fov = 58
cameras = [{ size = "default", viewport = "default" }]

[[layout.layers]]
id = "world"
name = "World"
rendering = "2d"
cameras = [{ size = "default", viewport = "default" }]

[[layout.layers]]
id = "weather"
name = "Weather"
rendering = "2d"
cameras = [{ size = "default", viewport = "default" }]

[[layout.layers]]
id = "hud"
name = "HUD"
rendering = "2d"
cameras = [{ size = "default", viewport = "default" }]

[[layout.layers]]
id = "inventory"
name = "Inventory"
rendering = "2d"
visible = false
cameras = [{ size = "default", viewport = "default" }]

[[layout.layers]]
id = "pause"
name = "Pause"
rendering = "2d"
visible = false
cameras = [{ size = "default", viewport = "default" }]

[[layout.layers]]
id = "settings"
name = "Settings"
rendering = "2d"
visible = false
cameras = [{ size = "default", viewport = "default" }]

[[layout.layers]]
id = "title"
name = "Title"
rendering = "2d"
visible = false
cameras = [{ size = "default", viewport = "default" }]

[[layout.layers]]
id = "photo"
name = "Photo"
rendering = "2d"
visible = false
cameras = [{ size = "default", viewport = "default" }]

[[layout.layers]]
id = "quests"
name = "Quests"
rendering = "2d"
visible = false
cameras = [{ size = "default", viewport = "default" }]

[[layout.layers]]
id = "touch"
name = "Touch"
rendering = "2d"
cameras = [{ size = "default", viewport = "default" }]

[[layout.layers]]
id = "performance"
name = "Performance"
rendering = "2d"
cameras = [{ size = "default", viewport = "default" }]

