>> do SetNumberObjectVariable object="Raptor" variable="PY" modification_sign="=" value=expr(Raptor.Y())
>> do SetNumberObjectVariable object="Raptor" variable="PA" modification_sign="=" value=expr(Raptor.Angle())
>> do SetNumberObjectVariable object="Raptor" variable="Clock" modification_sign="=" value=expr(Raptor.Variable(Clock) + TimeDelta())
>> do SetNumberObjectVariable object="Raptor" variable="AIClock" modification_sign="=" value=expr(Raptor.Variable(AIClock) + TimeDelta())
>> do SetNumberObjectVariable object="Raptor" variable="Cooldown" modification_sign="=" value=expr(max(0, Raptor.Variable(Cooldown) - TimeDelta()))
>> do SetNumberObjectVariable object="Raptor" variable="Distance" modification_sign="=" value=expr(DistanceBetweenPositions(Raptor.X(), Raptor.Y(), Player3D.X(), Player3D.Y()))
>> do SetNumberObjectVariable object="Raptor" variable="Travel" modification_sign="=" value=0

