do SetNumberObjectVariable object="Tyrannosaur" variable="LocalX" modification_sign="=" value=expr((Player3D.X() - Tyrannosaur.X()) * cos(ToRad(Tyrannosaur.Angle())) + (Player3D.Y() - Tyrannosaur.Y()) * sin(ToRad(Tyrannosaur.Angle())))
do SetNumberObjectVariable object="Tyrannosaur" variable="LocalY" modification_sign="=" value=expr(-(Player3D.X() - Tyrannosaur.X()) * sin(ToRad(Tyrannosaur.Angle())) + (Player3D.Y() - Tyrannosaur.Y()) * cos(ToRad(Tyrannosaur.Angle())))
do SetNumberObjectVariable object="Tyrannosaur" variable="NearY" modification_sign="=" value=expr(clamp(Tyrannosaur.Variable(LocalY), -Tyrannosaur.Variable(HalfLength) + Tyrannosaur.Variable(Radius), 325 - Tyrannosaur.Variable(Radius)))
do SetNumberObjectVariable object="Tyrannosaur" variable="Separation" modification_sign="=" value=expr(max(0.001, sqrt(Tyrannosaur.Variable(LocalX) * Tyrannosaur.Variable(LocalX) + pow(Tyrannosaur.Variable(LocalY) - Tyrannosaur.Variable(NearY), 2))))

