link external "HUDBootstrap"

link external "HUDConstructionInput"

@comment "Real-time 3D movement and reference comparison" background=[90,150,180] text=[255,255,255]

if KeyFromTextReleased key_to_check="F3"
if NumberVariable variable="Riding" comparison_sign="=" value=0
do SetNumberVariable variable="RenderMode" modification_sign="=" value=expr(1 - RenderMode)

link external "HUDViewMode"

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="StationIndex" comparison_sign="=" value=0
if BuiltinCommonInstructions::Once
do SetX object="Player3D" modification_sign="=" value=expr(Dinosaur3D.X())
do SetY object="Player3D" modification_sign="=" value=expr(Dinosaur3D.Y() + 550)
do SetAngle object="Player3D" modification_sign="=" angle_in_degrees=180

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="StationIndex" comparison_sign="=" value=1
if BuiltinCommonInstructions::Once
do SetX object="Player3D" modification_sign="=" value=-650
do SetY object="Player3D" modification_sign="=" value=350
do SetAngle object="Player3D" modification_sign="=" angle_in_degrees=180

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
do SetNumberVariable variable="PreviousX" modification_sign="=" value=expr(Player3D.X())
do SetNumberVariable variable="PreviousY" modification_sign="=" value=expr(Player3D.Y())
do SetNumberVariable variable="MoveX" modification_sign="=" value=0
do SetNumberVariable variable="MoveY" modification_sign="=" value=0
do SetNumberVariable variable="MoveSpeed" modification_sign="=" value=350
do SetNumberObjectVariable object="Player3D" variable="Sprinting" modification_sign="=" value=0

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if KeyFromTextPressed key_to_check="w"
do SetNumberVariable variable="MoveY" modification_sign="=" value=-1

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if KeyFromTextPressed key_to_check="s"
do SetNumberVariable variable="MoveY" modification_sign="=" value=1

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if KeyFromTextPressed key_to_check="a"
do SetNumberVariable variable="MoveX" modification_sign="=" value=-1

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if KeyFromTextPressed key_to_check="d"
do SetNumberVariable variable="MoveX" modification_sign="=" value=1

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="MoveX" comparison_sign="!=" value=0
if NumberVariable variable="MoveY" comparison_sign="!=" value=0
do SetNumberVariable variable="MoveSpeed" modification_sign="=" value=247.5

@comment "Sprint input" background=[90,150,180] text=[255,255,255]

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="Stamina" comparison_sign=">" value=1
if KeyFromTextPressed key_to_check="LShift"
do SetNumberObjectVariable object="Player3D" variable="Sprinting" modification_sign="=" value=1
do SetNumberVariable variable="MoveSpeed" modification_sign="*" value=expr(500 / 350)

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
do SetX object="Player3D" modification_sign="+" value=expr((MoveX * cos(ToRad(CameraYaw)) + MoveY * sin(ToRad(CameraYaw))) * MoveSpeed * TimeDelta())
do SetY object="Player3D" modification_sign="+" value=expr((MoveY * cos(ToRad(CameraYaw)) - MoveX * sin(ToRad(CameraYaw))) * MoveSpeed * TimeDelta())

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if PosX object="Player3D" comparison_sign=">" value=-1250
if PosX object="Player3D" comparison_sign="<" value=-550
if PosY object="Player3D" comparison_sign=">" value=-1010
if PosY object="Player3D" comparison_sign="<" value=-380
do SetX object="Player3D" modification_sign="=" value=expr(PreviousX)
do SetY object="Player3D" modification_sign="=" value=expr(PreviousY)

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if PosX object="Player3D" comparison_sign=">" value=2600
do SetX object="Player3D" modification_sign="=" value=expr(PreviousX)

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if PosX object="Player3D" comparison_sign="<" value=-2600
do SetX object="Player3D" modification_sign="=" value=expr(PreviousX)

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if PosY object="Player3D" comparison_sign=">" value=2300
do SetY object="Player3D" modification_sign="=" value=expr(PreviousY)

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if PosY object="Player3D" comparison_sign="<" value=-2800
do SetY object="Player3D" modification_sign="=" value=expr(PreviousY)

@comment "Mount state, safe side dismount, rotated capsule separation" background=[95,150,175] text=[255,255,255]

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
do SetNumberVariable variable="DinoPreviousX" modification_sign="=" value=expr(Dinosaur3D.X())
do SetNumberVariable variable="DinoPreviousY" modification_sign="=" value=expr(Dinosaur3D.Y())
do SetNumberVariable variable="DinoPreviousAngle" modification_sign="=" value=expr(Dinosaur3D.Angle())
do SetNumberVariable variable="DinoMoving" modification_sign="=" value=0

if NumberVariable variable="BuildMode" comparison_sign="=" value=0
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if KeyFromTextReleased key_to_check="x"
do SetNumberVariable variable="MountRequest" modification_sign="=" value=1

