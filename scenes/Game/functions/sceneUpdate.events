link "HUDChoppingFeedback"

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="SelectedHotbar" comparison_sign="=" value=1
if NumberVariable variable="Axe" comparison_sign=">" value=0
if NumberVariable variable="Stamina" comparison_sign=">=" value=1
if NumberVariable variable="ChopInput" comparison_sign="=" value=1
if NumberVariable variable="AxeCooldown" comparison_sign="<=" value=0
if NumberObjectVariable object="WoodSapling" variable="Target" comparison_sign="=" value=1
if NumberObjectVariable object="WoodSapling" variable="Cooldown" comparison_sign="<=" value=0
do SetNumberObjectVariable object="WoodSapling" variable="Hits" modification_sign="+" value=1
do SetNumberVariable variable="AxeCooldown" modification_sign="=" value=0.5
do SetNumberVariable variable="AxeSwing" modification_sign="=" value=0.35
do SetNumberVariable variable="Stamina" modification_sign="-" value=1
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetStringVariable variable="NoticeMessage" modification_sign="=" value=expr("斧子命中！还需 " + ToString(max(0, 3 - WoodSapling.Variable(Hits))) + " 下。")
do SetAngle object="Player3D" modification_sign="=" angle_in_degrees=expr(AngleBetweenPositions(Player3D.X(), Player3D.Y(), WoodSapling.X(), WoodSapling.Y()) - 90)
do PlaySound audio_file_or_audio_resource_name="axe-hit.wav" repeat_the_sound=false volume=70 pitch_speed=1

@event
if NumberObjectVariable object="WoodSapling" variable="Hits" comparison_sign=">=" value=3
if NumberObjectVariable object="WoodSapling" variable="Cooldown" comparison_sign="<=" value=0
do SetNumberObjectVariable object="WoodSapling" variable="Cooldown" modification_sign="=" value=30
do SetNumberObjectVariable object="WoodSapling" variable="Hits" modification_sign="=" value=0
do Hide object="WoodSapling"
do SetNumberVariable variable="Wood" modification_sign="+" value=expr(4+2*MetalTools)
do SetNumberVariable variable="GatherWood" modification_sign="+" value=expr(4+2*MetalTools)
do SetNumberVariable variable="HarvestCount" modification_sign="+" value=1
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="砍伐完成！木材 +4，已放入背包。"
do PlaySound audio_file_or_audio_resource_name="harvest.wav" repeat_the_sound=false volume=55 pitch_speed=0.8

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="AxeSwing" comparison_sign=">" value=0
if NumberObjectVariable object="WoodSapling" variable="Target" comparison_sign="=" value=1
do SetAngle object="WoodSapling" modification_sign="=" angle_in_degrees=expr(sin(AxeSwing * 55) * AxeSwing * 20)

@event
if NumberVariable variable="Mode" comparison_sign=">=" value=0
do SetNumberObjectVariable object="Player3D" variable="HeldAxeVisible" modification_sign="=" value=0

@event
if NumberVariable variable="SelectedHotbar" comparison_sign="=" value=1
if NumberVariable variable="Axe" comparison_sign=">" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
do SetNumberObjectVariable object="Player3D" variable="HeldAxeVisible" modification_sign="=" value=1

@comment "Wildlife and survival audio" background=[160,110,80] text=[255,255,255]

@event
if NumberVariable variable="MusicStarted" comparison_sign="=" value=0
if MouseButtonFromTextPressed button_to_check="Left"
or MouseButtonFromTextPressed button_to_check="Right"
or KeyFromTextPressed key_to_check="w"
or KeyFromTextPressed key_to_check="a"
or KeyFromTextPressed key_to_check="s"
or KeyFromTextPressed key_to_check="d"
or KeyFromTextPressed key_to_check="e"
or KeyFromTextPressed key_to_check="x"
or KeyFromTextPressed key_to_check="q"
or KeyFromTextPressed key_to_check="f"
or KeyFromTextPressed key_to_check="j"
or KeyFromTextPressed key_to_check="Space"
or HasAnyTouchOrMouseStarted
or KeyFromTextPressed key_to_check="Num1"
or KeyFromTextPressed key_to_check="Num2"
or KeyFromTextPressed key_to_check="Tab"
or KeyFromTextPressed key_to_check="Escape"
or KeyFromTextPressed key_to_check="m"
do PlayMusicOnChannel audio_file_or_audio_resource_name="island-dawn.wav" channel_identifier=20 repeat_the_sound=true volume=55 pitch_speed=1
do PlayMusicOnChannel audio_file_or_audio_resource_name="predator-pulse.wav" channel_identifier=21 repeat_the_sound=true volume=0 pitch_speed=1
do SetNumberVariable variable="MusicStarted" modification_sign="=" value=1

@event
link "HUDAudioControls"

@event
if NumberVariable variable="MusicStarted" comparison_sign="=" value=1
do SetNumberVariable variable="ThreatMix" modification_sign="=" value=expr(ThreatMix + (Threat * 48 - ThreatMix) * min(1, TimeDelta() * 1.8))
do SetMusicChannelVolume channel_identifier=20 modification_sign="=" volume_0_100=expr(55 - ThreatMix * 0.45)
do SetMusicChannelVolume channel_identifier=21 modification_sign="=" volume_0_100=expr(ThreatMix)

@event
if NumberVariable variable="Mode" comparison_sign="!=" value=expr(AudioMode)
do PlaySound audio_file_or_audio_resource_name="ui-click.wav" repeat_the_sound=false volume=32 pitch_speed=1
do SetNumberVariable variable="AudioMode" modification_sign="=" value=expr(Mode)

@event
if NumberVariable variable="Riding" comparison_sign="!=" value=expr(AudioRiding)
do PlaySound audio_file_or_audio_resource_name="mount.wav" repeat_the_sound=false volume=60 pitch_speed=1
do SetNumberVariable variable="AudioRiding" modification_sign="=" value=expr(Riding)

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
do SetNumberVariable variable="Threat" modification_sign="=" value=0
do SetNumberVariable variable="NearestWild" modification_sign="=" value=9999
do SetNumberVariable variable="SafeCamp" modification_sign="=" value=0
do SetNumberVariable variable="CombatHit" modification_sign="=" value=0
do SetNumberVariable variable="Invulnerable" modification_sign="=" value=expr(max(0, Invulnerable - TimeDelta()))
do SetNumberVariable variable="HitFlash" modification_sign="=" value=expr(max(0, HitFlash - TimeDelta()))
do SetNumberVariable variable="CombatCD" modification_sign="=" value=expr(max(0, CombatCD - TimeDelta()))
do SetNumberVariable variable="CombatSwing" modification_sign="=" value=expr(max(0, CombatSwing - TimeDelta()))
do SetNumberVariable variable="StepClock" modification_sign="=" value=expr(max(0, StepClock - TimeDelta()))
do SetNumberVariable variable="SoundClock" modification_sign="=" value=expr(SoundClock + TimeDelta())

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="PreviousX" comparison_sign="!=" value=expr(Player3D.X())
or NumberVariable variable="PreviousY" comparison_sign="!=" value=expr(Player3D.Y())
if NumberVariable variable="StepClock" comparison_sign="<=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
do PlaySound audio_file_or_audio_resource_name="footstep.wav" repeat_the_sound=false volume=28 pitch_speed=1
do SetNumberVariable variable="StepClock" modification_sign="=" value=expr(0.4 - Player3D.Variable(Sprinting) * 0.13)

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="DinoMoving" comparison_sign=">" value=0.01
if NumberVariable variable="StepClock" comparison_sign="<=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=1
do PlaySound audio_file_or_audio_resource_name="dino-step.wav" repeat_the_sound=false volume=50 pitch_speed=1
do SetNumberVariable variable="StepClock" modification_sign="=" value=0.42

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
do SetNumberVariable variable="SafeCamp" modification_sign="=" value=expr(DistanceBetweenPositions(Player3D.X(), Player3D.Y(), -650, 350))

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="SafeCamp" comparison_sign="<" value=330
do SetNumberVariable variable="SafeCamp" modification_sign="=" value=1

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="SafeCamp" comparison_sign=">=" value=330
do SetNumberVariable variable="SafeCamp" modification_sign="=" value=0

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="SafeCamp" comparison_sign="=" value=1
if NumberVariable variable="Hunger" comparison_sign=">" value=20
if NumberVariable variable="Water" comparison_sign=">" value=20
if NumberVariable variable="BodyTemp" comparison_sign=">=" value=35
if NumberVariable variable="Health" comparison_sign="<" value=100
do SetNumberVariable variable="Health" modification_sign="=" value=expr(min(100, Health + TimeDelta() * 4))

@event
if NumberVariable variable="BuildMode" comparison_sign="=" value=0
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if KeyFromTextReleased key_to_check="k"
or NumberVariable variable="TouchAttack" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="CombatCD" comparison_sign="<=" value=0
if NumberVariable variable="Stamina" comparison_sign=">=" value=3
do SetNumberVariable variable="CombatCD" modification_sign="=" value=0.65
do SetNumberVariable variable="CombatSwing" modification_sign="=" value=0.3
do SetNumberVariable variable="CombatHit" modification_sign="=" value=1
do SetNumberVariable variable="Stamina" modification_sign="=" value=expr(max(0, Stamina - 3))
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do PlaySound audio_file_or_audio_resource_name="swing.wav" repeat_the_sound=false volume=50 pitch_speed=1

@event
for each "Triceratops"
> @event
> if NumberVariable variable="Mode" comparison_sign="=" value=0
> if NumberVariable variable="RenderMode" comparison_sign="=" value=1
> if NumberVariable variable="Dead" comparison_sign="=" value=0
