do SetNumberObjectVariable object="Raptor" variable="LocalX" modification_sign="=" value=expr(Raptor.Variable(LocalX) * (Raptor.Variable(Radius) + 45) / Raptor.Variable(Separation))
do SetNumberObjectVariable object="Raptor" variable="LocalY" modification_sign="=" value=expr(Raptor.Variable(NearY) + (Raptor.Variable(LocalY) - Raptor.Variable(NearY)) * (Raptor.Variable(Radius) + 45) / Raptor.Variable(Separation))
do SetX object="Player3D" modification_sign="=" value=expr(Raptor.X() + Raptor.Variable(LocalX) * cos(ToRad(Raptor.Angle())) - Raptor.Variable(LocalY) * sin(ToRad(Raptor.Angle())))
do SetY object="Player3D" modification_sign="=" value=expr(Raptor.Y() + Raptor.Variable(LocalX) * sin(ToRad(Raptor.Angle())) + Raptor.Variable(LocalY) * cos(ToRad(Raptor.Angle())))

