>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(BuildY-HarvestNodes.Y())) comparison_sign="<" second_expression=expr(BuildWorldHY+80)
>> do SetNumberVariable variable="BuildValid" modification_sign="=" value=0
