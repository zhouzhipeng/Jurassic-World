do SetNumberObjectVariable object="WoodSapling" variable="Hits" modification_sign="+" value=1
do SetNumberVariable variable="AxeCooldown" modification_sign="=" value=0.5
do SetNumberVariable variable="AxeSwing" modification_sign="=" value=0.35
do SetNumberVariable variable="Stamina" modification_sign="-" value=1
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetStringVariable variable="NoticeMessage" modification_sign="=" value=expr("斧子命中！还需 " + ToString(max(0, 3 - WoodSapling.Variable(Hits))) + " 下。")
do SetAngle object="Player3D" modification_sign="=" angle_in_degrees=expr(AngleBetweenPositions(Player3D.X(), Player3D.Y(), WoodSapling.X(), WoodSapling.Y()) - 90)
do PlaySound audio_file_or_audio_resource_name="axe-hit.wav" repeat_the_sound=false volume=70 pitch_speed=1

if NumberObjectVariable object="WoodSapling" variable="Hits" comparison_sign=">=" value=3
if NumberObjectVariable object="WoodSapling" variable="Cooldown" comparison_sign="<=" value=0
do SetNumberObjectVariable object="WoodSapling" variable="Cooldown" modification_sign="=" value=30
do SetNumberObjectVariable object="WoodSapling" variable="Hits" modification_sign="=" value=0
do Hide object="WoodSapling"
do SetNumberVariable variable="Wood" modification_sign="+" value=4
do SetNumberVariable variable="GatherWood" modification_sign="+" value=4
do SetNumberVariable variable="HarvestCount" modification_sign="+" value=1
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="砍伐完成！木材 +4，已放入背包。"
do PlaySound audio_file_or_audio_resource_name="harvest.wav" repeat_the_sound=false volume=55 pitch_speed=0.8

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="AxeSwing" comparison_sign=">" value=0
if NumberObjectVariable object="WoodSapling" variable="Target" comparison_sign="=" value=1
do SetAngle object="WoodSapling" modification_sign="=" angle_in_degrees=expr(sin(AxeSwing * 55) * AxeSwing * 20)

if NumberVariable variable="Mode" comparison_sign=">=" value=0
do Hide object="HeldAxe"

if NumberVariable variable="SelectedHotbar" comparison_sign="=" value=1
if NumberVariable variable="Axe" comparison_sign=">" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
do Show object="HeldAxe"
do SetX object="HeldAxe" modification_sign="=" value=expr(Player3D.X() - cos(ToRad(Player3D.Angle())) * 45 - sin(ToRad(Player3D.Angle())) * sin(AxeSwing / 0.35 * 3.14159) * 55)
do SetY object="HeldAxe" modification_sign="=" value=expr(Player3D.Y() - sin(ToRad(Player3D.Angle())) * 45 + cos(ToRad(Player3D.Angle())) * sin(AxeSwing / 0.35 * 3.14159) * 55)
do SetAngle object="HeldAxe" modification_sign="=" angle_in_degrees=expr(Player3D.Angle())
do Scene3D::Base3DBehavior::SetRotationX parameter_3d_object="HeldAxe" behavior="Object3D" modification_sign="=" angle_in_degrees=expr(sin(AxeSwing / 0.35 * 3.14159) * 75)
