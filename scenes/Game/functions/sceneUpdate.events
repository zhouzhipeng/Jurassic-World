do SetNumberVariable variable="Dirty" modification_sign="=" value=1

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=1
do SetX object="Dinosaur3D" modification_sign="=" value=expr(Dinosaur3D.X() + (MoveX * cos(ToRad(CameraYaw)) + MoveY * sin(ToRad(CameraYaw))) * MoveSpeed * 1.4 * TimeDelta())
do SetY object="Dinosaur3D" modification_sign="=" value=expr(Dinosaur3D.Y() + (MoveY * cos(ToRad(CameraYaw)) - MoveX * sin(ToRad(CameraYaw))) * MoveSpeed * 1.4 * TimeDelta())

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=1
if NumberVariable variable="MoveX" comparison_sign="!=" value=0
or NumberVariable variable="MoveY" comparison_sign="!=" value=0
do SetAngle object="Dinosaur3D" modification_sign="=" angle_in_degrees=expr(AngleBetweenPositions(DinoPreviousX, DinoPreviousY, Dinosaur3D.X(), Dinosaur3D.Y()) - 90)

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=1
if PosX object="Dinosaur3D" comparison_sign="<" value=-2170
do SetX object="Dinosaur3D" modification_sign="=" value=expr(DinoPreviousX)
do SetY object="Dinosaur3D" modification_sign="=" value=expr(DinoPreviousY)
do SetAngle object="Dinosaur3D" modification_sign="=" angle_in_degrees=expr(DinoPreviousAngle)

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=1
if PosX object="Dinosaur3D" comparison_sign=">" value=2170
do SetX object="Dinosaur3D" modification_sign="=" value=expr(DinoPreviousX)
do SetY object="Dinosaur3D" modification_sign="=" value=expr(DinoPreviousY)
do SetAngle object="Dinosaur3D" modification_sign="=" angle_in_degrees=expr(DinoPreviousAngle)

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=1
if PosY object="Dinosaur3D" comparison_sign="<" value=-2370
do SetX object="Dinosaur3D" modification_sign="=" value=expr(DinoPreviousX)
do SetY object="Dinosaur3D" modification_sign="=" value=expr(DinoPreviousY)
do SetAngle object="Dinosaur3D" modification_sign="=" angle_in_degrees=expr(DinoPreviousAngle)

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=1
if PosY object="Dinosaur3D" comparison_sign=">" value=1870
do SetX object="Dinosaur3D" modification_sign="=" value=expr(DinoPreviousX)
do SetY object="Dinosaur3D" modification_sign="=" value=expr(DinoPreviousY)
do SetAngle object="Dinosaur3D" modification_sign="=" angle_in_degrees=expr(DinoPreviousAngle)

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=1
if PosX object="Dinosaur3D" comparison_sign=">" value=-1680
if PosX object="Dinosaur3D" comparison_sign="<" value=-120
if PosY object="Dinosaur3D" comparison_sign=">" value=-1440
if PosY object="Dinosaur3D" comparison_sign="<" value=50
do SetX object="Dinosaur3D" modification_sign="=" value=expr(DinoPreviousX)
do SetY object="Dinosaur3D" modification_sign="=" value=expr(DinoPreviousY)
do SetAngle object="Dinosaur3D" modification_sign="=" angle_in_degrees=expr(DinoPreviousAngle)

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=1
do SetNumberVariable variable="DinoMoving" modification_sign="=" value=expr(DistanceBetweenPositions(DinoPreviousX, DinoPreviousY, Dinosaur3D.X(), Dinosaur3D.Y()))

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
do SetNumberVariable variable="CapsuleX" modification_sign="=" value=expr((Player3D.X() - Dinosaur3D.X()) * cos(ToRad(Dinosaur3D.Angle())) + (Player3D.Y() - Dinosaur3D.Y()) * sin(ToRad(Dinosaur3D.Angle())))
do SetNumberVariable variable="CapsuleY" modification_sign="=" value=expr(-(Player3D.X() - Dinosaur3D.X()) * sin(ToRad(Dinosaur3D.Angle())) + (Player3D.Y() - Dinosaur3D.Y()) * cos(ToRad(Dinosaur3D.Angle())))
do SetNumberVariable variable="CapsuleNearestY" modification_sign="=" value=expr(clamp(CapsuleY, -330, 200))
do SetNumberVariable variable="CapsuleDistance" modification_sign="=" value=expr(sqrt(CapsuleX * CapsuleX + (CapsuleY - CapsuleNearestY) * (CapsuleY - CapsuleNearestY)))

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="CapsuleDistance" comparison_sign="<" value=0.001
do SetNumberVariable variable="CapsuleX" modification_sign="=" value=170
do SetNumberVariable variable="CapsuleY" modification_sign="=" value=expr(CapsuleNearestY)
do SetNumberVariable variable="CapsuleDistance" modification_sign="=" value=170

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="CapsuleDistance" comparison_sign="<=" value=170
do SetNumberVariable variable="CapsuleX" modification_sign="=" value=expr(CapsuleX * 170 / CapsuleDistance)
do SetNumberVariable variable="CapsuleY" modification_sign="=" value=expr(CapsuleNearestY + (CapsuleY - CapsuleNearestY) * 170 / CapsuleDistance)
do SetX object="Player3D" modification_sign="=" value=expr(Dinosaur3D.X() + CapsuleX * cos(ToRad(Dinosaur3D.Angle())) - CapsuleY * sin(ToRad(Dinosaur3D.Angle())))
do SetY object="Player3D" modification_sign="=" value=expr(Dinosaur3D.Y() + CapsuleX * sin(ToRad(Dinosaur3D.Angle())) + CapsuleY * cos(ToRad(Dinosaur3D.Angle())))

if NumberVariable variable="Riding" comparison_sign="=" value=1
do SetX object="Player3D" modification_sign="=" value=expr(Dinosaur3D.X())
do SetY object="Player3D" modification_sign="=" value=expr(Dinosaur3D.Y())
do SetAngle object="Player3D" modification_sign="=" angle_in_degrees=expr(Dinosaur3D.Angle())
do Hide object="Player3D"
do SetNumberObjectVariable object="Dinosaur3D" variable="MountedRiderVisible" modification_sign="=" value=1

if NumberVariable variable="Riding" comparison_sign="=" value=0
do Show object="Player3D"
do SetNumberObjectVariable object="Dinosaur3D" variable="MountedRiderVisible" modification_sign="=" value=0

if NumberVariable variable="Riding" comparison_sign="=" value=1
if NumberVariable variable="DinoMoving" comparison_sign=">" value=0.01
if NumberVariable variable="Mode" comparison_sign="=" value=0
do SetNumberObjectVariable object="Dinosaur3D" variable="AnimationState" modification_sign="=" value=1

if NumberVariable variable="Riding" comparison_sign="=" value=0
or NumberVariable variable="DinoMoving" comparison_sign="<=" value=0.01
do SetNumberObjectVariable object="Dinosaur3D" variable="AnimationState" modification_sign="=" value=0

if NumberVariable variable="Mode" comparison_sign="=" value=0
do SetNumberObjectVariable object="Dinosaur3D" variable="AnimationPlaying" modification_sign="=" value=1

if NumberVariable variable="Mode" comparison_sign="!=" value=0
do SetNumberObjectVariable object="Dinosaur3D" variable="AnimationPlaying" modification_sign="=" value=0

link external "HUDMountStatus"

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
do SetNumberVariable variable="CanFeed" modification_sign="=" value=0

if Distance object="Player3D" object_2="Dinosaur3D" distance=650
do SetNumberVariable variable="CanFeed" modification_sign="=" value=1

if SceneJustBegins
do ResetTimer timer_name="survival"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

link external "HUDSaveAvailability"

if NumberVariable variable="Mode" comparison_sign=">=" value=0
do SetNumberVariable variable="InputMode" modification_sign="=" value=expr(Mode)

link external "HUDMenuInput"

@comment "Proximity harvesting: one nearest node, hold E, respawn and feedback" background=[90,150,180] text=[255,255,255]

link external "HUDHarvestReset"

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberObjectVariable object="HarvestNodes" variable="Cooldown" comparison_sign=">" value=0
do SetNumberObjectVariable object="HarvestNodes" variable="Cooldown" modification_sign="-" value=expr(TimeDelta())

if NumberObjectVariable object="HarvestNodes" variable="Cooldown" comparison_sign="<=" value=0
do Show object="HarvestNodes"

if NumberObjectVariable object="HarvestNodes" variable="Cooldown" comparison_sign=">" value=0
do Hide object="HarvestNodes"

link external "HUDHarvestFeedback"

if NumberVariable variable="BuildMode" comparison_sign="=" value=0
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberObjectVariable object="HarvestNodes" variable="Target" comparison_sign="=" value=1
if NumberObjectVariable object="HarvestNodes" variable="Cooldown" comparison_sign="<=" value=0
if NumberVariable variable="Stamina" comparison_sign=">=" value=3
if KeyFromTextPressed key_to_check="e"
if NumberObjectVariable object="HarvestNodes" variable="Kind" comparison_sign="!=" value=3
do SetNumberObjectVariable object="HarvestNodes" variable="Progress" modification_sign="+" value=expr(TimeDelta())
do SetAngle object="HarvestNodes" modification_sign="=" angle_in_degrees=expr(sin(HarvestNodes.Variable(Progress) * 35) * 7)

if NumberObjectVariable object="HarvestNodes" variable="Progress" comparison_sign=">=" value=0.8
if NumberObjectVariable object="HarvestNodes" variable="Kind" comparison_sign="!=" value=3
if NumberObjectVariable object="HarvestNodes" variable="Target" comparison_sign="=" value=1
do SetNumberObjectVariable object="HarvestNodes" variable="Cooldown" modification_sign="=" value=30
do SetNumberObjectVariable object="HarvestNodes" variable="Progress" modification_sign="=" value=0
do SetAngle object="HarvestNodes" modification_sign="=" angle_in_degrees=0
do Hide object="HarvestNodes"
do SetNumberVariable variable="Stamina" modification_sign="-" value=3
do SetNumberVariable variable="HarvestCount" modification_sign="+" value=1
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do PlaySound audio_file_or_audio_resource_name="harvest.wav" repeat_the_sound=false volume=65 pitch_speed=1

