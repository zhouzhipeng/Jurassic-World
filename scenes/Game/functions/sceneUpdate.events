do SetNumberObjectVariable object="Raptor" variable="LocalX" modification_sign="=" value=expr((Player3D.X() - Raptor.X()) * cos(ToRad(Raptor.Angle())) + (Player3D.Y() - Raptor.Y()) * sin(ToRad(Raptor.Angle())))
do SetNumberObjectVariable object="Raptor" variable="LocalY" modification_sign="=" value=expr(-(Player3D.X() - Raptor.X()) * sin(ToRad(Raptor.Angle())) + (Player3D.Y() - Raptor.Y()) * cos(ToRad(Raptor.Angle())))
do SetNumberObjectVariable object="Raptor" variable="NearY" modification_sign="=" value=expr(clamp(Raptor.Variable(LocalY), -Raptor.Variable(HalfLength) + Raptor.Variable(Radius), 190 - Raptor.Variable(Radius)))
do SetNumberObjectVariable object="Raptor" variable="Separation" modification_sign="=" value=expr(max(0.001, sqrt(Raptor.Variable(LocalX) * Raptor.Variable(LocalX) + pow(Raptor.Variable(LocalY) - Raptor.Variable(NearY), 2))))

if NumberVariable variable="Mode" comparison_sign="=" value=0
