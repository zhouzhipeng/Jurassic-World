if NumberVariable variable="Riding" comparison_sign="=" value=0
do SetNumberObjectVariable object="Triceratops" variable="LocalX" modification_sign="=" value=expr((Player3D.X() - Triceratops.X()) * cos(ToRad(Triceratops.Angle())) + (Player3D.Y() - Triceratops.Y()) * sin(ToRad(Triceratops.Angle())))
do SetNumberObjectVariable object="Triceratops" variable="LocalY" modification_sign="=" value=expr(-(Player3D.X() - Triceratops.X()) * sin(ToRad(Triceratops.Angle())) + (Player3D.Y() - Triceratops.Y()) * cos(ToRad(Triceratops.Angle())))
do SetNumberObjectVariable object="Triceratops" variable="NearY" modification_sign="=" value=expr(clamp(Triceratops.Variable(LocalY), -Triceratops.Variable(HalfLength) + Triceratops.Variable(Radius), 225 - Triceratops.Variable(Radius)))
do SetNumberObjectVariable object="Triceratops" variable="Separation" modification_sign="=" value=expr(max(0.001, sqrt(Triceratops.Variable(LocalX) * Triceratops.Variable(LocalX) + pow(Triceratops.Variable(LocalY) - Triceratops.Variable(NearY), 2))))

if NumberVariable variable="Mode" comparison_sign="=" value=0
