if NumberObjectVariable object="Triceratops" variable="Separation" comparison_sign="<=" value=0.001
do SetNumberObjectVariable object="Triceratops" variable="LocalX" modification_sign="=" value=expr(Triceratops.Variable(Radius) + 45)
do SetNumberObjectVariable object="Triceratops" variable="Separation" modification_sign="=" value=expr(Triceratops.Variable(Radius) + 45)

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
