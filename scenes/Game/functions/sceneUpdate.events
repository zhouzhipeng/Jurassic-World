>> do SetNumberObjectVariable object="Raptor" variable="Separation" modification_sign="=" value=expr(max(0.001, sqrt(Raptor.Variable(LocalX) * Raptor.Variable(LocalX) + pow(Raptor.Variable(LocalY) - Raptor.Variable(NearY), 2))))

