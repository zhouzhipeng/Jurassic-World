>> do SetNumberObjectVariable object="Tyrannosaur" variable="Distance" modification_sign="=" value=expr(DistanceBetweenPositions(Tyrannosaur.X(), Tyrannosaur.Y(), Player3D.X(), Player3D.Y()))
>> do SetNumberObjectVariable object="Tyrannosaur" variable="Travel" modification_sign="=" value=0

