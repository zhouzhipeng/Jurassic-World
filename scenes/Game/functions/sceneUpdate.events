if PosY object="Triceratops" comparison_sign=">" value=expr(-1010 - Triceratops.Variable(Radius))
if PosY object="Triceratops" comparison_sign="<" value=expr(-380 + Triceratops.Variable(Radius))
do SetX object="Triceratops" modification_sign="=" value=expr(Triceratops.Variable(PX))
