link "HUDViewMode"

@event
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="StationIndex" comparison_sign="=" value=0
if SceneJustBegins
do SetX object="Player3D" modification_sign="=" value=expr(Dinosaur3D.X())
do SetY object="Player3D" modification_sign="=" value=expr(Dinosaur3D.Y() + 550)
do SetAngle object="Player3D" modification_sign="=" angle_in_degrees=180
do SetNumberVariable variable="PlayerFloor" modification_sign="=" value=0

@event
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
