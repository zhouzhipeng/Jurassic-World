do SetX object="Raptor" modification_sign="=" value=expr(Raptor.Variable(PX))
do SetY object="Raptor" modification_sign="=" value=expr(Raptor.Variable(PY))
do SetX object="Tyrannosaur" modification_sign="=" value=expr(Tyrannosaur.Variable(PX))
do SetY object="Tyrannosaur" modification_sign="=" value=expr(Tyrannosaur.Variable(PY))

