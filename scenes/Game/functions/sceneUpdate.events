do TextContainerCapability::TextContainerBehavior::SetValue object="HarvestHint" behavior="Text" modification_sign="=" text="体力不足，按 F 休息后再砍。"

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="SelectedHotbar" comparison_sign="=" value=1
if NumberVariable variable="Axe" comparison_sign=">" value=0
if NumberVariable variable="Stamina" comparison_sign=">=" value=1
if NumberVariable variable="ChopInput" comparison_sign="=" value=1
if NumberVariable variable="AxeCooldown" comparison_sign="<=" value=0
