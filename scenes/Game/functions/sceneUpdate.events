do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("按 Tab 打开背包 → 选择 Spear → 点击 Craft。" + NewLine() + "配方：木材 6、石头 2、纤维 4。")
do SetStringVariable variable="QuestReward" modification_sign="=" value="体力 +30"
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text="将收集到的材料变成装备。长矛是本次远征的第一件自制工具。"

