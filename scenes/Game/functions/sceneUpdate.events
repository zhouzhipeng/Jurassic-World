link external "HUDDeath"

if NumberVariable variable="Dead" comparison_sign="=" value=1
if KeyFromTextReleased key_to_check="Return"
do SetNumberVariable variable="Dead" modification_sign="=" value=0
do SetNumberVariable variable="Mode" modification_sign="=" value=0
do SetNumberVariable variable="Health" modification_sign="=" value=100
do SetNumberVariable variable="Invulnerable" modification_sign="=" value=5
do SetNumberVariable variable="HitFlash" modification_sign="=" value=0
