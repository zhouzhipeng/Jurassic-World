@comment "Equipped axe: three timed hits, shared gathering rewards, visible hand tool" background=[145,105,65] text=[255,255,255]

if NumberVariable variable="Mode" comparison_sign=">=" value=0
do SetNumberVariable variable="ChopInput" modification_sign="=" value=0

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="AxeCooldown" comparison_sign=">" value=0
do SetNumberVariable variable="AxeCooldown" modification_sign="-" value=expr(TimeDelta())

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="AxeSwing" comparison_sign=">" value=0
do SetNumberVariable variable="AxeSwing" modification_sign="=" value=expr(max(0, AxeSwing - TimeDelta()))

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if KeyFromTextPressed key_to_check="e"
do SetNumberVariable variable="ChopInput" modification_sign="=" value=1

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if MouseButtonFromTextPressed button_to_check="Left"
