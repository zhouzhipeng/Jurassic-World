if NumberObjectVariable object="Triceratops" variable="Separation" comparison_sign="<" value=expr(Triceratops.Variable(Radius) + 45)
do SetNumberObjectVariable object="Triceratops" variable="LocalX" modification_sign="=" value=expr(Triceratops.Variable(LocalX) * (Triceratops.Variable(Radius) + 45) / Triceratops.Variable(Separation))
do SetNumberObjectVariable object="Triceratops" variable="LocalY" modification_sign="=" value=expr(Triceratops.Variable(NearY) + (Triceratops.Variable(LocalY) - Triceratops.Variable(NearY)) * (Triceratops.Variable(Radius) + 45) / Triceratops.Variable(Separation))
do SetX object="Player3D" modification_sign="=" value=expr(Triceratops.X() + Triceratops.Variable(LocalX) * cos(ToRad(Triceratops.Angle())) - Triceratops.Variable(LocalY) * sin(ToRad(Triceratops.Angle())))
do SetY object="Player3D" modification_sign="=" value=expr(Triceratops.Y() + Triceratops.Variable(LocalX) * sin(ToRad(Triceratops.Angle())) + Triceratops.Variable(LocalY) * cos(ToRad(Triceratops.Angle())))

