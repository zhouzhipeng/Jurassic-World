if Distance object="Stegosaur" object_2="Tyrannosaur" distance=expr(Stegosaur.Variable(HalfLength) + Tyrannosaur.Variable(HalfLength))
do SetX object="Stegosaur" modification_sign="=" value=expr(Stegosaur.Variable(PX))
do SetY object="Stegosaur" modification_sign="=" value=expr(Stegosaur.Variable(PY))
do SetX object="Tyrannosaur" modification_sign="=" value=expr(Tyrannosaur.Variable(PX))
do SetY object="Tyrannosaur" modification_sign="=" value=expr(Tyrannosaur.Variable(PY))

