if CursorX comparison_sign="<" value=1020 layer="HUD" camera_number_default_0=0
if CursorY comparison_sign=">" value=215 layer="HUD" camera_number_default_0=0
if CursorY comparison_sign="<" value=630 layer="HUD" camera_number_default_0=0
do SetNumberVariable variable="ChopInput" modification_sign="=" value=1

