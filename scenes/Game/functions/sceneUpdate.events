if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
do SetX object="Player3D" modification_sign="+" value=expr((MoveX * cos(ToRad(CameraYaw)) + MoveY * sin(ToRad(CameraYaw))) * MoveSpeed * TimeDelta())
do SetY object="Player3D" modification_sign="+" value=expr((MoveY * cos(ToRad(CameraYaw)) - MoveX * sin(ToRad(CameraYaw))) * MoveSpeed * TimeDelta())

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if PosX object="Player3D" comparison_sign=">" value=-1250
if PosX object="Player3D" comparison_sign="<" value=-550
if PosY object="Player3D" comparison_sign=">" value=-1010
if PosY object="Player3D" comparison_sign="<" value=-380
do SetX object="Player3D" modification_sign="=" value=expr(PreviousX)
do SetY object="Player3D" modification_sign="=" value=expr(PreviousY)

