> do SetNumberVariable variable="Wood" modification_sign="+" value=4
> do SetNumberVariable variable="GatherWood" modification_sign="+" value=4
> do SetStringVariable variable="NoticeMessage" modification_sign="=" value="+4 Wood collected and added to backpack."

> if NumberObjectVariable object="HarvestNodes" variable="Kind" comparison_sign="=" value=4
> do SetNumberVariable variable="Stone" modification_sign="+" value=3
> do SetNumberVariable variable="GatherStone" modification_sign="+" value=3
> do SetStringVariable variable="NoticeMessage" modification_sign="=" value="+3 Stone collected and added to backpack."

if NumberObjectVariable object="HarvestNodes" variable="Target" comparison_sign="=" value=0
or NumberVariable variable="Mode" comparison_sign="!=" value=0
or NumberVariable variable="RenderMode" comparison_sign="!=" value=1
do SetNumberObjectVariable object="HarvestNodes" variable="Progress" modification_sign="=" value=0
do SetAngle object="HarvestNodes" modification_sign="=" angle_in_degrees=0

if KeyFromTextReleased key_to_check="e"
do SetNumberObjectVariable object="HarvestNodes" variable="Progress" modification_sign="=" value=0
do SetAngle object="HarvestNodes" modification_sign="=" angle_in_degrees=0

link external "HUDActionBar"

if NumberVariable variable="Action" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=1
do SetNumberVariable variable="Action" modification_sign="=" value=0
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="请先按 X 下坐骑，再进行互动。"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

if NumberVariable variable="Action" comparison_sign="=" value=5
if NumberVariable variable="Riding" comparison_sign="=" value=1
do SetNumberVariable variable="Action" modification_sign="=" value=0
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="骑乘时用 WASD 移动；先下坐骑才能快速旅行。"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

if NumberVariable variable="Action" comparison_sign="=" value=1
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="StationIndex" comparison_sign="=" value=0
if NumberVariable variable="CanFeed" comparison_sign="=" value=0
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="Move closer to the dinosaur to feed it."
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetNumberVariable variable="Action" modification_sign="=" value=0

if NumberVariable variable="Action" comparison_sign="=" value=1
if NumberVariable variable="StationIndex" comparison_sign="=" value=0
if NumberVariable variable="Trust" comparison_sign="<" value=100
if NumberVariable variable="Berries" comparison_sign=">" value=0
do SetNumberVariable variable="Berries" modification_sign="-" value=1
do SetNumberVariable variable="Trust" modification_sign="+" value=7
do PlaySound audio_file_or_audio_resource_name="feed.wav" repeat_the_sound=false volume=65 pitch_speed=1
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="Berries -1  /  Trust +7"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetNumberVariable variable="Action" modification_sign="=" value=0

if NumberVariable variable="Trust" comparison_sign=">" value=100
do SetNumberVariable variable="Trust" modification_sign="=" value=100
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="Companion tamed! Return to camp and build a shelter."
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

if NumberVariable variable="Action" comparison_sign="=" value=1
if NumberVariable variable="StationIndex" comparison_sign="=" value=0
if NumberVariable variable="Trust" comparison_sign=">=" value=100
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="Your companion trusts you. Gather supplies at camp."
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetNumberVariable variable="Action" modification_sign="=" value=0

if NumberVariable variable="Action" comparison_sign="=" value=1
if NumberVariable variable="StationIndex" comparison_sign="=" value=0
if NumberVariable variable="Berries" comparison_sign="<=" value=0
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="No berries. Find a red bush and hold E to gather."
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetNumberVariable variable="Action" modification_sign="=" value=0

if NumberVariable variable="Action" comparison_sign="=" value=1
if NumberVariable variable="StationIndex" comparison_sign="=" value=1
do SetNumberVariable variable="BuildMode" modification_sign="=" value=1
do SetNumberVariable variable="BuildKind" modification_sign="=" value=1
do SetNumberVariable variable="Action" modification_sign="=" value=0
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="选择空地搭建庇护所，完成营地任务。"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

if NumberVariable variable="Action" comparison_sign="=" value=2
or NumberVariable variable="Action" comparison_sign="=" value=3
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="Walk to a resource and HOLD E to gather."
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetNumberVariable variable="Action" modification_sign="=" value=0

if NumberVariable variable="Action" comparison_sign="=" value=4
do SetNumberVariable variable="Water" modification_sign="=" value=100
do PlaySound audio_file_or_audio_resource_name="drink.wav" repeat_the_sound=false volume=50 pitch_speed=1
do SetNumberVariable variable="Stamina" modification_sign="=" value=100
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="Rested at fresh water. Water and stamina restored."
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetNumberVariable variable="Action" modification_sign="=" value=0

if NumberVariable variable="Action" comparison_sign="=" value=5
do SetNumberVariable variable="StationIndex" modification_sign="=" value=expr(1 - StationIndex)
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="Location changed. E interacts with this location."
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetNumberVariable variable="Action" modification_sign="=" value=0

if NumberVariable variable="Action" comparison_sign=">" value=0
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="Too tired to gather. Press F to rest."
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetNumberVariable variable="Action" modification_sign="=" value=0

link external "HUDInventoryAndSave"

if NumberVariable variable="Action" comparison_sign="=" value=10
if GroupExists storage_name=expr(SaveStorage) group="Version"
do SetStringVariable variable="BuildJSON" modification_sign="=" value="[]"
do SetNumberVariable variable="BuildRestore" modification_sign="=" value=1
do SetNumberVariable variable="BuildMode" modification_sign="=" value=0

if NumberVariable variable="Action" comparison_sign="=" value=10
if GroupExists storage_name=expr(SaveStorage) group="BuildingsV1"
do ReadStringFromStorage storage_name=expr(SaveStorage) group="BuildingsV1" variable="BuildJSON"

if NumberVariable variable="Action" comparison_sign="=" value=10
if GroupExists storage_name=expr(SaveStorage) group="Version"
do SetNumberVariable variable="Riding" modification_sign="=" value=0
do SetX object="Player3D" modification_sign="=" value=expr(Dinosaur3D.X() + 240)
do SetY object="Player3D" modification_sign="=" value=expr(Dinosaur3D.Y())

if NumberVariable variable="Action" comparison_sign="=" value=10
if GroupExists storage_name=expr(SaveStorage) group="QuestVersion"
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="QuestStage" variable="QuestStage"
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="GatherBerries" variable="GatherBerries"
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="GatherFiber" variable="GatherFiber"
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="GatherWood" variable="GatherWood"
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="GatherStone" variable="GatherStone"
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="CraftedSpears" variable="CraftedSpears"
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="BaseBerries" variable="BaseBerries"
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="BaseFiber" variable="BaseFiber"
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="BaseWood" variable="BaseWood"
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="BaseStone" variable="BaseStone"
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="ExpeditionRounds" variable="ExpeditionRounds"
do SetNumberVariable variable="QuestAnnounced" modification_sign="=" value=-1

if NumberVariable variable="Action" comparison_sign="=" value=10
if GroupExists storage_name=expr(SaveStorage) group="Version"
@instruction inverted=true
if GroupExists storage_name=expr(SaveStorage) group="QuestVersion"
do SetNumberVariable variable="QuestStage" modification_sign="=" value=0
do SetNumberVariable variable="GatherBerries" modification_sign="=" value=0
do SetNumberVariable variable="GatherFiber" modification_sign="=" value=0
do SetNumberVariable variable="GatherWood" modification_sign="=" value=0
do SetNumberVariable variable="GatherStone" modification_sign="=" value=0
do SetNumberVariable variable="CraftedSpears" modification_sign="=" value=0
do SetNumberVariable variable="BaseBerries" modification_sign="=" value=0
do SetNumberVariable variable="BaseFiber" modification_sign="=" value=0
do SetNumberVariable variable="BaseWood" modification_sign="=" value=0
do SetNumberVariable variable="BaseStone" modification_sign="=" value=0
do SetNumberVariable variable="ExpeditionRounds" modification_sign="=" value=0
do SetNumberVariable variable="QuestAnnounced" modification_sign="=" value=-1

link external "HUDLoadStatus"

if NumberVariable variable="Mode" comparison_sign="=" value=0
do SetNumberVariable variable="Elapsed" modification_sign="+" value=expr(TimeDelta())

if NumberVariable variable="Elapsed" comparison_sign=">=" value=5
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Hunger" comparison_sign=">" value=1
if NumberVariable variable="Water" comparison_sign=">" value=1
do SetNumberVariable variable="Elapsed" modification_sign="=" value=0
do SetNumberVariable variable="Hunger" modification_sign="-" value=1
do SetNumberVariable variable="Water" modification_sign="-" value=1
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

link external "HUDPanels"

@comment "Right drag orbits; wheel zooms; UI cancels drag" background=[90,150,180] text=[255,255,255]

if NumberVariable variable="Mode" comparison_sign="!=" value=0
or NumberVariable variable="RenderMode" comparison_sign="!=" value=1
do SetNumberVariable variable="CameraDragging" modification_sign="=" value=0

if MouseButtonFromTextReleased button_to_check="Right"
do SetNumberVariable variable="CameraDragging" modification_sign="=" value=0

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if MouseButtonFromTextPressed button_to_check="Right"
if NumberVariable variable="CameraDragging" comparison_sign="=" value=1
do SetNumberVariable variable="CameraYaw" modification_sign="-" value=expr((CursorX("HUD", 0) - CameraMouseX) * 0.3)
do SetNumberVariable variable="CameraPitch" modification_sign="=" value=expr(clamp(CameraPitch + (CursorY("HUD", 0) - CameraMouseY) * 0.2, 12, 65))

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if MouseButtonFromTextPressed button_to_check="Right"
do SetNumberVariable variable="CameraDragging" modification_sign="=" value=1
do SetNumberVariable variable="CameraMouseX" modification_sign="=" value=expr(CursorX("HUD", 0))
do SetNumberVariable variable="CameraMouseY" modification_sign="=" value=expr(CursorY("HUD", 0))

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if IsMouseWheelScrollingUp
do SetNumberVariable variable="CameraDistance" modification_sign="=" value=expr(clamp(CameraDistance + (-100), 500, 2000))

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if IsMouseWheelScrollingDown
do SetNumberVariable variable="CameraDistance" modification_sign="=" value=expr(clamp(CameraDistance + (100), 500, 2000))

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if KeyFromTextReleased key_to_check="Home"
do SetNumberVariable variable="CameraYaw" modification_sign="=" value=0
do SetNumberVariable variable="CameraPitch" modification_sign="=" value=25
do SetNumberVariable variable="CameraDistance" modification_sign="=" value=1250

link external "HUDQuests"

@comment "Equipped axe: three timed hits, shared gathering rewards, visible hand tool" background=[145,105,65] text=[255,255,255]

if NumberVariable variable="Mode" comparison_sign=">=" value=0
do SetNumberVariable variable="ChopInput" modification_sign="=" value=0

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="AxeCooldown" comparison_sign=">" value=0
do SetNumberVariable variable="AxeCooldown" modification_sign="-" value=expr(TimeDelta())

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="AxeSwing" comparison_sign=">" value=0
do SetNumberVariable variable="AxeSwing" modification_sign="=" value=expr(max(0, AxeSwing - TimeDelta()))

if NumberVariable variable="BuildMode" comparison_sign="=" value=0
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if KeyFromTextPressed key_to_check="e"
do SetNumberVariable variable="ChopInput" modification_sign="=" value=1

if NumberVariable variable="BuildMode" comparison_sign="=" value=0
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if MouseButtonFromTextPressed button_to_check="Left"
if CursorX comparison_sign=">" value=320 layer="HUD" camera_number_default_0=0
if CursorX comparison_sign="<" value=1020 layer="HUD" camera_number_default_0=0
if CursorY comparison_sign=">" value=215 layer="HUD" camera_number_default_0=0
if CursorY comparison_sign="<" value=630 layer="HUD" camera_number_default_0=0
do SetNumberVariable variable="ChopInput" modification_sign="=" value=1

link external "HUDChoppingFeedback"

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="SelectedHotbar" comparison_sign="=" value=1
if NumberVariable variable="Axe" comparison_sign=">" value=0
if NumberVariable variable="Stamina" comparison_sign=">=" value=1
if NumberVariable variable="ChopInput" comparison_sign="=" value=1
if NumberVariable variable="AxeCooldown" comparison_sign="<=" value=0
if NumberObjectVariable object="WoodSapling" variable="Target" comparison_sign="=" value=1
if NumberObjectVariable object="WoodSapling" variable="Cooldown" comparison_sign="<=" value=0
do SetNumberObjectVariable object="WoodSapling" variable="Hits" modification_sign="+" value=1
do SetNumberVariable variable="AxeCooldown" modification_sign="=" value=0.5
do SetNumberVariable variable="AxeSwing" modification_sign="=" value=0.35
do SetNumberVariable variable="Stamina" modification_sign="-" value=1
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetStringVariable variable="NoticeMessage" modification_sign="=" value=expr("斧子命中！还需 " + ToString(max(0, 3 - WoodSapling.Variable(Hits))) + " 下。")
do SetAngle object="Player3D" modification_sign="=" angle_in_degrees=expr(AngleBetweenPositions(Player3D.X(), Player3D.Y(), WoodSapling.X(), WoodSapling.Y()) - 90)
do PlaySound audio_file_or_audio_resource_name="axe-hit.wav" repeat_the_sound=false volume=70 pitch_speed=1

if NumberObjectVariable object="WoodSapling" variable="Hits" comparison_sign=">=" value=3
if NumberObjectVariable object="WoodSapling" variable="Cooldown" comparison_sign="<=" value=0
do SetNumberObjectVariable object="WoodSapling" variable="Cooldown" modification_sign="=" value=30
do SetNumberObjectVariable object="WoodSapling" variable="Hits" modification_sign="=" value=0
do Hide object="WoodSapling"
do SetNumberVariable variable="Wood" modification_sign="+" value=4
do SetNumberVariable variable="GatherWood" modification_sign="+" value=4
do SetNumberVariable variable="HarvestCount" modification_sign="+" value=1
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="砍伐完成！木材 +4，已放入背包。"
do PlaySound audio_file_or_audio_resource_name="harvest.wav" repeat_the_sound=false volume=55 pitch_speed=0.8

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="AxeSwing" comparison_sign=">" value=0
if NumberObjectVariable object="WoodSapling" variable="Target" comparison_sign="=" value=1
do SetAngle object="WoodSapling" modification_sign="=" angle_in_degrees=expr(sin(AxeSwing * 55) * AxeSwing * 20)

if NumberVariable variable="Mode" comparison_sign=">=" value=0
do SetNumberObjectVariable object="Player3D" variable="HeldAxeVisible" modification_sign="=" value=0

if NumberVariable variable="SelectedHotbar" comparison_sign="=" value=1
if NumberVariable variable="Axe" comparison_sign=">" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
do SetNumberObjectVariable object="Player3D" variable="HeldAxeVisible" modification_sign="=" value=1

@comment "Wildlife and survival audio" background=[160,110,80] text=[255,255,255]

if NumberVariable variable="MusicStarted" comparison_sign="=" value=0
if MouseButtonFromTextPressed button_to_check="Left"
or MouseButtonFromTextPressed button_to_check="Right"
or KeyFromTextPressed key_to_check="w"
or KeyFromTextPressed key_to_check="a"
or KeyFromTextPressed key_to_check="s"
or KeyFromTextPressed key_to_check="d"
or KeyFromTextPressed key_to_check="e"
or KeyFromTextPressed key_to_check="x"
or KeyFromTextPressed key_to_check="q"
or KeyFromTextPressed key_to_check="f"
or KeyFromTextPressed key_to_check="j"
or KeyFromTextPressed key_to_check="Space"
or KeyFromTextPressed key_to_check="Num1"
or KeyFromTextPressed key_to_check="Num2"
or KeyFromTextPressed key_to_check="Tab"
or KeyFromTextPressed key_to_check="Escape"
or KeyFromTextPressed key_to_check="m"
do PlayMusicOnChannel audio_file_or_audio_resource_name="island-dawn.wav" channel_identifier=20 repeat_the_sound=true volume=55 pitch_speed=1
do PlayMusicOnChannel audio_file_or_audio_resource_name="predator-pulse.wav" channel_identifier=21 repeat_the_sound=true volume=0 pitch_speed=1
do SetNumberVariable variable="MusicStarted" modification_sign="=" value=1

link external "HUDAudioControls"

if NumberVariable variable="MusicStarted" comparison_sign="=" value=1
do SetNumberVariable variable="ThreatMix" modification_sign="=" value=expr(ThreatMix + (Threat * 48 - ThreatMix) * min(1, TimeDelta() * 1.8))
do SetMusicChannelVolume channel_identifier=20 modification_sign="=" volume_0_100=expr(55 - ThreatMix * 0.45)
do SetMusicChannelVolume channel_identifier=21 modification_sign="=" volume_0_100=expr(ThreatMix)

if NumberVariable variable="Mode" comparison_sign="!=" value=expr(AudioMode)
do PlaySound audio_file_or_audio_resource_name="ui-click.wav" repeat_the_sound=false volume=32 pitch_speed=1
do SetNumberVariable variable="AudioMode" modification_sign="=" value=expr(Mode)

if NumberVariable variable="Riding" comparison_sign="!=" value=expr(AudioRiding)
do PlaySound audio_file_or_audio_resource_name="mount.wav" repeat_the_sound=false volume=60 pitch_speed=1
do SetNumberVariable variable="AudioRiding" modification_sign="=" value=expr(Riding)

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
do SetNumberVariable variable="Threat" modification_sign="=" value=0
do SetNumberVariable variable="NearestWild" modification_sign="=" value=9999
do SetNumberVariable variable="SafeCamp" modification_sign="=" value=0
do SetNumberVariable variable="CombatHit" modification_sign="=" value=0
do SetNumberVariable variable="Invulnerable" modification_sign="=" value=expr(max(0, Invulnerable - TimeDelta()))
do SetNumberVariable variable="HitFlash" modification_sign="=" value=expr(max(0, HitFlash - TimeDelta()))
do SetNumberVariable variable="CombatCD" modification_sign="=" value=expr(max(0, CombatCD - TimeDelta()))
do SetNumberVariable variable="CombatSwing" modification_sign="=" value=expr(max(0, CombatSwing - TimeDelta()))
do SetNumberVariable variable="StepClock" modification_sign="=" value=expr(max(0, StepClock - TimeDelta()))
do SetNumberVariable variable="SoundClock" modification_sign="=" value=expr(SoundClock + TimeDelta())

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="PreviousX" comparison_sign="!=" value=expr(Player3D.X())
or NumberVariable variable="PreviousY" comparison_sign="!=" value=expr(Player3D.Y())
if NumberVariable variable="StepClock" comparison_sign="<=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
do PlaySound audio_file_or_audio_resource_name="footstep.wav" repeat_the_sound=false volume=28 pitch_speed=1
do SetNumberVariable variable="StepClock" modification_sign="=" value=expr(0.4 - Player3D.Variable(Sprinting) * 0.13)

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="DinoMoving" comparison_sign=">" value=0.01
if NumberVariable variable="StepClock" comparison_sign="<=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=1
do PlaySound audio_file_or_audio_resource_name="dino-step.wav" repeat_the_sound=false volume=50 pitch_speed=1
do SetNumberVariable variable="StepClock" modification_sign="=" value=0.42

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
do SetNumberVariable variable="SafeCamp" modification_sign="=" value=expr(DistanceBetweenPositions(Player3D.X(), Player3D.Y(), -650, 350))

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="SafeCamp" comparison_sign="<" value=330
do SetNumberVariable variable="SafeCamp" modification_sign="=" value=1

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="SafeCamp" comparison_sign=">=" value=330
do SetNumberVariable variable="SafeCamp" modification_sign="=" value=0

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="SafeCamp" comparison_sign="=" value=1
if NumberVariable variable="Health" comparison_sign="<" value=100
do SetNumberVariable variable="Health" modification_sign="=" value=expr(min(100, Health + TimeDelta() * 4))

if NumberVariable variable="BuildMode" comparison_sign="=" value=0
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if KeyFromTextReleased key_to_check="Space"
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="CombatCD" comparison_sign="<=" value=0
if NumberVariable variable="Stamina" comparison_sign=">=" value=3
do SetNumberVariable variable="CombatCD" modification_sign="=" value=0.65
do SetNumberVariable variable="CombatSwing" modification_sign="=" value=0.3
do SetNumberVariable variable="CombatHit" modification_sign="=" value=1
do SetNumberVariable variable="Stamina" modification_sign="=" value=expr(max(0, Stamina - 3))
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do PlaySound audio_file_or_audio_resource_name="swing.wav" repeat_the_sound=false volume=50 pitch_speed=1

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberObjectVariable object="Triceratops" variable="HP" comparison_sign=">" value=0
do SetNumberObjectVariable object="Triceratops" variable="PX" modification_sign="=" value=expr(Triceratops.X())
do SetNumberObjectVariable object="Triceratops" variable="PY" modification_sign="=" value=expr(Triceratops.Y())
do SetNumberObjectVariable object="Triceratops" variable="PA" modification_sign="=" value=expr(Triceratops.Angle())
do SetNumberObjectVariable object="Triceratops" variable="Clock" modification_sign="=" value=expr(Triceratops.Variable(Clock) + TimeDelta())
do SetNumberObjectVariable object="Triceratops" variable="AIClock" modification_sign="=" value=expr(Triceratops.Variable(AIClock) + TimeDelta())
do SetNumberObjectVariable object="Triceratops" variable="Cooldown" modification_sign="=" value=expr(max(0, Triceratops.Variable(Cooldown) - TimeDelta()))
do SetNumberObjectVariable object="Triceratops" variable="Distance" modification_sign="=" value=expr(DistanceBetweenPositions(Triceratops.X(), Triceratops.Y(), Player3D.X(), Player3D.Y()))
do SetNumberObjectVariable object="Triceratops" variable="Travel" modification_sign="=" value=0

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberObjectVariable object="Triceratops" variable="HP" comparison_sign=">" value=0
if NumberObjectVariable object="Triceratops" variable="State" comparison_sign="!=" value=3
do SetNumberObjectVariable object="Triceratops" variable="State" modification_sign="=" value=0

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberObjectVariable object="Triceratops" variable="HP" comparison_sign=">" value=0
if NumberObjectVariable object="Triceratops" variable="State" comparison_sign="!=" value=3
