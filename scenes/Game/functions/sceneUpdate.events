do Create object_to_create="BuiltShelter" x_position=expr(BuildX) y_position=expr(BuildY) layer="World3D"
do SetAngle object="BuiltShelter" modification_sign="=" angle_in_degrees=expr(BuildAngle)
do SetNumberObjectVariable object="BuiltShelter" variable="Slot" modification_sign="=" value=expr(BuildSlot)
do SetNumberObjectVariable object="BuiltShelter" variable="WorldHX" modification_sign="=" value=expr(abs(cos(ToRad(BuildAngle))) * BuiltShelter.Variable(HX) + abs(sin(ToRad(BuildAngle))) * BuiltShelter.Variable(HY))
