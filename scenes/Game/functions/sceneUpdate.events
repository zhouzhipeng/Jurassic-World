@event
for each "Raptor"
> @event
> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(Raptor.X(),Raptor.Y(),Player3D.X(),Player3D.Y())) comparison_sign="<" second_expression=3600
> or BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(Raptor.X(),Raptor.Y(),Heyin.X(),Heyin.Y())) comparison_sign="<" second_expression=1800
> or NumberObjectVariable object="Raptor" variable="HP" comparison_sign="<=" value=0
> or NumberVariable variable="Mode" comparison_sign="!=" value=0
> or NumberVariable variable="RenderMode" comparison_sign="!=" value=1
