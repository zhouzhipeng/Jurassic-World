do SetNumberObjectVariable object="Tyrannosaur" variable="LocalY" modification_sign="=" value=expr(Tyrannosaur.Variable(NearY) + (Tyrannosaur.Variable(LocalY) - Tyrannosaur.Variable(NearY)) * (Tyrannosaur.Variable(Radius) + 45) / Tyrannosaur.Variable(Separation))
do SetX object="Player3D" modification_sign="=" value=expr(Tyrannosaur.X() + Tyrannosaur.Variable(LocalX) * cos(ToRad(Tyrannosaur.Angle())) - Tyrannosaur.Variable(LocalY) * sin(ToRad(Tyrannosaur.Angle())))
do SetY object="Player3D" modification_sign="=" value=expr(Tyrannosaur.Y() + Tyrannosaur.Variable(LocalX) * sin(ToRad(Tyrannosaur.Angle())) + Tyrannosaur.Variable(LocalY) * cos(ToRad(Tyrannosaur.Angle())))

