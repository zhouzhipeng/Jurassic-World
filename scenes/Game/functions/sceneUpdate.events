@comment "Right drag orbits; wheel zooms; UI cancels drag" background=[90,150,180] text=[255,255,255]

if NumberVariable variable="Mode" comparison_sign="!=" value=0
or NumberVariable variable="RenderMode" comparison_sign="!=" value=1
do SetNumberVariable variable="CameraDragging" modification_sign="=" value=0

if MouseButtonFromTextReleased button_to_check="Right"
do SetNumberVariable variable="CameraDragging" modification_sign="=" value=0

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if MouseButtonFromTextPressed button_to_check="Right"
if NumberVariable variable="CameraDragging" comparison_sign="=" value=1
do SetNumberVariable variable="CameraYaw" modification_sign="-" value=expr((CursorX("HUD", 0) - CameraMouseX) * 0.3)
do SetNumberVariable variable="CameraPitch" modification_sign="=" value=expr(clamp(CameraPitch + (CursorY("HUD", 0) - CameraMouseY) * 0.2, 12, 65))

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if MouseButtonFromTextPressed button_to_check="Right"
do SetNumberVariable variable="CameraDragging" modification_sign="=" value=1
do SetNumberVariable variable="CameraMouseX" modification_sign="=" value=expr(CursorX("HUD", 0))
do SetNumberVariable variable="CameraMouseY" modification_sign="=" value=expr(CursorY("HUD", 0))

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if IsMouseWheelScrollingUp
do SetNumberVariable variable="CameraDistance" modification_sign="=" value=expr(clamp(CameraDistance + (-100), 500, 2000))

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if IsMouseWheelScrollingDown
do SetNumberVariable variable="CameraDistance" modification_sign="=" value=expr(clamp(CameraDistance + (100), 500, 2000))

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if KeyFromTextReleased key_to_check="Home"
do SetNumberVariable variable="CameraYaw" modification_sign="=" value=0
do SetNumberVariable variable="CameraPitch" modification_sign="=" value=25
do SetNumberVariable variable="CameraDistance" modification_sign="=" value=1250

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
do SetCameraCenterX modification_sign="=" value=expr(Player3D.X() + sin(ToRad(CameraYaw)) * cos(ToRad(CameraPitch)) * CameraDistance) layer="World3D" camera_number_default_0=0
do SetCameraCenterY modification_sign="=" value=expr(Player3D.Y() + cos(ToRad(CameraYaw)) * cos(ToRad(CameraPitch)) * CameraDistance) layer="World3D" camera_number_default_0=0
do Scene3D::SetCameraZ modification_sign="=" value=expr(120 + Riding * 220 + sin(ToRad(CameraPitch)) * CameraDistance) layer="World3D" camera_number_default_0=0
do Scene3D::TurnCameraTowardPosition x_position=expr(Player3D.X()) y_position=expr(Player3D.Y()) z_position=expr(120 + Riding * 220) layer="World3D" camera_number_default_0=0 stand_on_y_instead_of_z=false
if NumberVariable variable="Mode" comparison_sign="=" value=6
if BuiltinCommonInstructions::Once
do ShowLayer layer="Quests"
do HideLayer layer="HUD"
do HideLayer layer="Inventory"
do HideLayer layer="Pause"
do HideLayer layer="Settings"
do HideLayer layer="Title"
do HideLayer layer="Photo"

if NumberVariable variable="Mode" comparison_sign="=" value=5
do HideLayer layer="Quests"


@comment "Quest state machine: action counters, explicit claims, saved rewards" background=[190,145,70] text=[255,255,255]

if NumberVariable variable="Mode" comparison_sign=">=" value=0
do SetNumberVariable variable="QuestReady" modification_sign="=" value=0
do SetNumberVariable variable="QuestTargetKind" modification_sign="=" value=0
do SetNumberVariable variable="QuestTargetValid" modification_sign="=" value=0

if NumberVariable variable="QuestStage" comparison_sign="=" value=0
do SetStringVariable variable="QuestName" modification_sign="=" value="第一份食物"
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("亲手采集浆果  " + ToString(min(GatherBerries, 3)) + " / 3")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("靠近红果灌木，按住 E 直到采集完成。" + NewLine() + "顶部显示最近目标的方向和距离。")
do SetStringVariable variable="QuestReward" modification_sign="=" value="浆果 +3"
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text="你和恐龙都需要食物。先学会辨认红果灌木，亲手采集第一份浆果。"

if NumberVariable variable="QuestStage" comparison_sign="=" value=0
if NumberVariable variable="GatherBerries" comparison_sign=">=" value=3
do SetNumberVariable variable="QuestReady" modification_sign="=" value=1

if NumberVariable variable="QuestStage" comparison_sign="=" value=1
do SetStringVariable variable="QuestName" modification_sign="=" value="就地取材"
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("木材 " + ToString(min(GatherWood, 4)) + " / 4" + "   石头 " + ToString(min(GatherStone, 3)) + " / 3" + NewLine() + "纤维 " + ToString(min(GatherFiber, 5)) + " / 5")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("小树：按 1 装备斧子，按住 E 砍三下。" + NewLine() + "蕨类和矿石：靠近后按住 E 采集。")
do SetStringVariable variable="QuestReward" modification_sign="=" value="木材 +6 / 石头 +2 / 纤维 +4"
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text="建立据点需要多种材料。沿海岛寻找小树、矿石和蕨类，认识不同资源的用途。"

if NumberVariable variable="QuestStage" comparison_sign="=" value=1
if NumberVariable variable="GatherWood" comparison_sign=">=" value=4
if NumberVariable variable="GatherStone" comparison_sign=">=" value=3
if NumberVariable variable="GatherFiber" comparison_sign=">=" value=5
do SetNumberVariable variable="QuestReady" modification_sign="=" value=1

if NumberVariable variable="QuestStage" comparison_sign="=" value=2
do SetStringVariable variable="QuestName" modification_sign="=" value="亲手制作"
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("制作长矛  " + ToString(min(CraftedSpears, 1)) + " / 1")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("按 Tab 打开背包 → 选择 Spear → 点击 Craft。" + NewLine() + "配方：木材 6、石头 2、纤维 4。")
do SetStringVariable variable="QuestReward" modification_sign="=" value="体力 +30"
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text="将收集到的材料变成装备。长矛是本次远征的第一件自制工具。"

if NumberVariable variable="QuestStage" comparison_sign="=" value=2
if NumberVariable variable="CraftedSpears" comparison_sign=">=" value=1
do SetNumberVariable variable="QuestReady" modification_sign="=" value=1

if NumberVariable variable="QuestStage" comparison_sign="=" value=3
do SetStringVariable variable="QuestName" modification_sign="=" value="第一位伙伴"
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("恐龙信任  " + ToString(min(Trust, 100)) + " / 100")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("走近副栉龙，点右侧喂食按钮或松开 E。" + NewLine() + "附近有资源时 E 优先采集，可用喂食按钮。")
do SetStringVariable variable="QuestReward" modification_sign="=" value="兽皮 +2"
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text="用浆果赢得副栉龙的信任。采集来的食物，终于派上了另一种用场。"

if NumberVariable variable="QuestStage" comparison_sign="=" value=3
if NumberVariable variable="Trust" comparison_sign=">=" value=100
do SetNumberVariable variable="QuestReady" modification_sign="=" value=1

if NumberVariable variable="QuestStage" comparison_sign="=" value=4
do SetStringVariable variable="QuestName" modification_sign="=" value="安全的营地"
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("建造庇护所  " + ToString(min(Built, 1)) + " / 1")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("按 B 开启建造，选 1 庇护所；移动到空地后按 Enter。" + NewLine() + "需要木材 10、石头 5、纤维 8。")
do SetStringVariable variable="QuestReward" modification_sign="=" value="绳索 +2；解锁野外补给委托"
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text="伙伴已经信任你。收集材料，亲手搭建一座庇护所，为下一次出发建立落脚点。"

if NumberVariable variable="QuestStage" comparison_sign="=" value=4
if NumberVariable variable="Built" comparison_sign="=" value=1
do SetNumberVariable variable="QuestReady" modification_sign="=" value=1

if NumberVariable variable="QuestStage" comparison_sign="=" value=5
do SetStringVariable variable="QuestName" modification_sign="=" value="野外补给委托"
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("浆果 " + ToString(min(GatherBerries - BaseBerries, 3)) + " / 3" + "   纤维 " + ToString(min(GatherFiber - BaseFiber, 5)) + " / 5" + NewLine() + "木材 " + ToString(min(GatherWood - BaseWood, 4)) + " / 4" + "   石头 " + ToString(min(GatherStone - BaseStone, 3)) + " / 3")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("跟随指引补给；小树需要按 1 装备斧子砍伐。" + NewLine() + "领取后开始下一轮，已消耗的材料也计入进度。")
do SetStringVariable variable="QuestReward" modification_sign="=" value="绳索 +2 / 体力 +25 / 饥饿与水分 +15"
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text="据点需要持续补给。每轮重新收集四种材料，保持探索、采集、返回的循环。"

if NumberVariable variable="QuestStage" comparison_sign="=" value=5
if NumberVariable variable="GatherBerries" comparison_sign=">=" value=expr(BaseBerries + 3)
if NumberVariable variable="GatherFiber" comparison_sign=">=" value=expr(BaseFiber + 5)
if NumberVariable variable="GatherWood" comparison_sign=">=" value=expr(BaseWood + 4)
if NumberVariable variable="GatherStone" comparison_sign=">=" value=expr(BaseStone + 3)
do SetNumberVariable variable="QuestReady" modification_sign="=" value=1

if NumberVariable variable="QuestReady" comparison_sign="=" value=1
if NumberVariable variable="QuestAnnounced" comparison_sign="!=" value=expr(QuestStage)
do SetNumberVariable variable="QuestAnnounced" modification_sign="=" value=expr(QuestStage)
do SetNumberVariable variable="QuestToastTime" modification_sign="=" value=5
do TextContainerCapability::TextContainerBehavior::SetValue object="QuestToast" behavior="Text" modification_sign="=" text=expr("目标达成：" + QuestName + NewLine() + "按 J 打开任务，领取奖励并继续。")
do PlaySound audio_file_or_audio_resource_name="quest-complete.wav" repeat_the_sound=false volume=60 pitch_speed=1

if NumberVariable variable="QuestClaim" comparison_sign="=" value=1
if NumberVariable variable="QuestReady" comparison_sign="=" value=1
do SetNumberVariable variable="QuestClaimStage" modification_sign="=" value=expr(QuestStage)
do SetNumberVariable variable="QuestReady" modification_sign="=" value=0
