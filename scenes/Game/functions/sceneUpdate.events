@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
do SetNumberObjectVariable object="Player3D" variable="AnimationState" modification_sign="=" value=0
do SetNumberObjectVariable object="Player3D" variable="Travel" modification_sign="=" value=expr(DistanceBetweenPositions(PreviousX, PreviousY, Player3D.X(), Player3D.Y()))
do SetNumberObjectVariable object="Player3D" variable="AnimationPlaying" modification_sign="=" value=1

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberObjectVariable object="Player3D" variable="Travel" comparison_sign=">" value=0.1
if NumberVariable variable="MoveSpeed" comparison_sign=">" value=0
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(MoveX) + abs(MoveY)) comparison_sign=">" second_expression=0
do SetNumberObjectVariable object="Player3D" variable="AnimationState" modification_sign="=" value=1

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberObjectVariable object="Player3D" variable="Travel" comparison_sign=">" value=0.1
if NumberVariable variable="MoveSpeed" comparison_sign=">" value=0
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(MoveX) + abs(MoveY)) comparison_sign=">" second_expression=0
if NumberObjectVariable object="Player3D" variable="Sprinting" comparison_sign="=" value=1
do SetNumberObjectVariable object="Player3D" variable="AnimationState" modification_sign="=" value=2
do SetNumberVariable variable="Stamina" modification_sign="=" value=expr(max(0, Stamina - 12 * TimeDelta()))
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberObjectVariable object="HarvestNodes" variable="Target" comparison_sign="=" value=1
if NumberObjectVariable object="HarvestNodes" variable="Progress" comparison_sign=">" value=0
do SetNumberObjectVariable object="Player3D" variable="AnimationState" modification_sign="=" value=3
do SetAngle object="Player3D" modification_sign="=" angle_in_degrees=expr(AngleBetweenPositions(Player3D.X(), Player3D.Y(), HarvestNodes.X(), HarvestNodes.Y()) - 90)
do SetNumberObjectVariable object="Player3D" variable="HeldAxeVisible" modification_sign="=" value=0

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="AxeSwing" comparison_sign=">" value=0
do SetNumberObjectVariable object="Player3D" variable="AnimationState" modification_sign="=" value=4

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="CombatSwing" comparison_sign=">" value=0
if NumberVariable variable="Spear" comparison_sign=">" value=0
do SetNumberObjectVariable object="Player3D" variable="AnimationState" modification_sign="=" value=5

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="HitFlash" comparison_sign=">" value=0
do SetNumberObjectVariable object="Player3D" variable="AnimationState" modification_sign="=" value=6

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberObjectVariable object="Player3D" variable="AnimationState" comparison_sign="<=" value=2
if NumberObjectVariable object="Player3D" variable="Travel" comparison_sign=">" value=0.1
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(MoveX) + abs(MoveY)) comparison_sign=">" second_expression=0
do SetAngle object="Player3D" modification_sign="=" angle_in_degrees=expr(AngleBetweenPositions(PreviousX, PreviousY, Player3D.X(), Player3D.Y()) - 90)

link "PlayerJumpAnimation"

@event
if NumberVariable variable="Mode" comparison_sign="=" value=7
do SetNumberObjectVariable object="Player3D" variable="AnimationState" modification_sign="=" value=7
do SetNumberObjectVariable object="Player3D" variable="AnimationPlaying" modification_sign="=" value=1

@event
if NumberVariable variable="Mode" comparison_sign=">" value=0
if NumberVariable variable="Mode" comparison_sign="<" value=7
do SetNumberObjectVariable object="Player3D" variable="AnimationPlaying" modification_sign="=" value=0

