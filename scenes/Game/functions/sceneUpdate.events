>> do SetNumberObjectVariable object="Stegosaur" variable="LocalX" modification_sign="=" value=expr(Stegosaur.Variable(LocalX) * (Stegosaur.Variable(Radius) + 45) / Stegosaur.Variable(Separation))
>> do SetNumberObjectVariable object="Stegosaur" variable="LocalY" modification_sign="=" value=expr(Stegosaur.Variable(NearY) + (Stegosaur.Variable(LocalY) - Stegosaur.Variable(NearY)) * (Stegosaur.Variable(Radius) + 45) / Stegosaur.Variable(Separation))
>> do SetX object="Player3D" modification_sign="=" value=expr(Stegosaur.X() + Stegosaur.Variable(LocalX) * cos(ToRad(Stegosaur.Angle())) - Stegosaur.Variable(LocalY) * sin(ToRad(Stegosaur.Angle())))
>> do SetY object="Player3D" modification_sign="=" value=expr(Stegosaur.Y() + Stegosaur.Variable(LocalX) * sin(ToRad(Stegosaur.Angle())) + Stegosaur.Variable(LocalY) * cos(ToRad(Stegosaur.Angle())))

