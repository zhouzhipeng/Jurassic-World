do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("按 Q 返回营地，再按 E 或快捷栏 7 加固。" + NewLine() + "需要木材 10、石头 5、纤维 8。")
do SetStringVariable variable="QuestReward" modification_sign="=" value="绳索 +2；解锁野外补给委托"
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text="伙伴已经信任你。回到木屋加固营地，为下一次出发建立落脚点。"

