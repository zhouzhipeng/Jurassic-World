do TextContainerCapability::TextContainerBehavior::SetValue object="QuestBody" behavior="Text" modification_sign="=" text=expr("Offer berries to gain trust." + NewLine() + "Explore, gather and craft a tool.")

if NumberVariable variable="Built" comparison_sign="=" value=1
if NumberVariable variable="Trust" comparison_sign=">=" value=100
if BuiltinCommonInstructions::Once
do TextContainerCapability::TextContainerBehavior::SetValue object="QuestTitle" behavior="Text" modification_sign="=" text="READY FOR EXPEDITION"
do TextContainerCapability::TextContainerBehavior::SetValue object="QuestBody" behavior="Text" modification_sign="=" text=expr("Companion and shelter secured." + NewLine() + "Craft a spear and save your progress.")

if NumberVariable variable="Help" comparison_sign="=" value=0
if BuiltinCommonInstructions::Once
do Hide object="Controls"
do TextContainerCapability::TextContainerBehavior::SetValue object="HelpToggleLabel" behavior="Text" modification_sign="=" text="OFF"

if NumberVariable variable="Help" comparison_sign="=" value=1
if BuiltinCommonInstructions::Once
do Show object="Controls"
do TextContainerCapability::TextContainerBehavior::SetValue object="HelpToggleLabel" behavior="Text" modification_sign="=" text="ON"

if NumberVariable variable="Dirty" comparison_sign="=" value=1
do TextContainerCapability::TextContainerBehavior::SetValue object="Notice" behavior="Text" modification_sign="=" text=expr(NoticeMessage)
do TextContainerCapability::TextContainerBehavior::SetValue object="TrustText" behavior="Text" modification_sign="=" text=expr("Trust " + ToString(Trust) + "%")
do ResizableCapability::ResizableBehavior::SetWidth object="TrustMeter" behavior="Resizable" modification_sign="=" width=expr(Trust * 2.85)
do TextContainerCapability::TextContainerBehavior::SetValue object="HotBerries" behavior="Text" modification_sign="=" text=expr(ToString(Berries))
do TextContainerCapability::TextContainerBehavior::SetValue object="Value1" behavior="Text" modification_sign="=" text=expr(ToString(Stamina) + " / 100")
do ResizableCapability::ResizableBehavior::SetWidth object="Meter1" behavior="Resizable" modification_sign="=" width=expr(Stamina * 1.98)
do TextContainerCapability::TextContainerBehavior::SetValue object="Value2" behavior="Text" modification_sign="=" text=expr(ToString(Hunger) + " / 100")
do ResizableCapability::ResizableBehavior::SetWidth object="Meter2" behavior="Resizable" modification_sign="=" width=expr(Hunger * 1.98)
do TextContainerCapability::TextContainerBehavior::SetValue object="Value3" behavior="Text" modification_sign="=" text=expr(ToString(Water) + " / 100")
do ResizableCapability::ResizableBehavior::SetWidth object="Meter3" behavior="Resizable" modification_sign="=" width=expr(Water * 1.98)
do TextContainerCapability::TextContainerBehavior::SetValue object="CountWood" behavior="Text" modification_sign="=" text=expr(ToString(Wood))
do TextContainerCapability::TextContainerBehavior::SetValue object="CountStone" behavior="Text" modification_sign="=" text=expr(ToString(Stone))
do TextContainerCapability::TextContainerBehavior::SetValue object="CountFiber" behavior="Text" modification_sign="=" text=expr(ToString(Fiber))
do TextContainerCapability::TextContainerBehavior::SetValue object="CountHide" behavior="Text" modification_sign="=" text=expr(ToString(Hide))
do TextContainerCapability::TextContainerBehavior::SetValue object="CountBerries" behavior="Text" modification_sign="=" text=expr(ToString(Berries))
do TextContainerCapability::TextContainerBehavior::SetValue object="CountMeat" behavior="Text" modification_sign="=" text=expr(ToString(Meat))
do TextContainerCapability::TextContainerBehavior::SetValue object="CountWater" behavior="Text" modification_sign="=" text=expr(ToString(Water))
do TextContainerCapability::TextContainerBehavior::SetValue object="CountAxe" behavior="Text" modification_sign="=" text=expr(ToString(Axe))
do TextContainerCapability::TextContainerBehavior::SetValue object="CountSpear" behavior="Text" modification_sign="=" text=expr(ToString(Spear))
do TextContainerCapability::TextContainerBehavior::SetValue object="CountFlint" behavior="Text" modification_sign="=" text=expr(ToString(Flint))
do TextContainerCapability::TextContainerBehavior::SetValue object="CountRope" behavior="Text" modification_sign="=" text=expr(ToString(Rope))
do TextContainerCapability::TextContainerBehavior::SetValue object="Weight" behavior="Text" modification_sign="=" text=expr("Supplies: " + ToString(Wood + Stone + Fiber + Berries) + " units")

if NumberVariable variable="Dirty" comparison_sign="=" value=1
if NumberVariable variable="Recipe" comparison_sign="=" value=0
do TextContainerCapability::TextContainerBehavior::SetValue object="RecipeTitle" behavior="Text" modification_sign="=" text="STONE AXE"
do TextContainerCapability::TextContainerBehavior::SetValue object="Requirements" behavior="Text" modification_sign="=" text=expr("Wood   " + ToString(Wood) + " / 5" + NewLine() + "Stone   " + ToString(Stone) + " / 3" + NewLine() + "Fiber    " + ToString(Fiber) + " / 4")

if NumberVariable variable="Dirty" comparison_sign="=" value=1
if NumberVariable variable="Recipe" comparison_sign="=" value=1
do TextContainerCapability::TextContainerBehavior::SetValue object="RecipeTitle" behavior="Text" modification_sign="=" text="SPEAR"
do TextContainerCapability::TextContainerBehavior::SetValue object="Requirements" behavior="Text" modification_sign="=" text=expr("Wood   " + ToString(Wood) + " / 6" + NewLine() + "Stone   " + ToString(Stone) + " / 2" + NewLine() + "Fiber    " + ToString(Fiber) + " / 4")

if NumberVariable variable="Dirty" comparison_sign="=" value=1
do SetNumberVariable variable="Dirty" modification_sign="=" value=0
