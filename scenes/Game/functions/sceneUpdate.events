do SetAngle object="Dinosaur3D" modification_sign="=" angle_in_degrees=expr(DinoPreviousAngle)

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=1
if PosX object="Dinosaur3D" comparison_sign=">" value=-1680
if PosX object="Dinosaur3D" comparison_sign="<" value=-120
if PosY object="Dinosaur3D" comparison_sign=">" value=-1440
if PosY object="Dinosaur3D" comparison_sign="<" value=50
do SetX object="Dinosaur3D" modification_sign="=" value=expr(DinoPreviousX)
do SetY object="Dinosaur3D" modification_sign="=" value=expr(DinoPreviousY)
do SetAngle object="Dinosaur3D" modification_sign="=" angle_in_degrees=expr(DinoPreviousAngle)

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=1
do SetNumberVariable variable="DinoMoving" modification_sign="=" value=expr(DistanceBetweenPositions(DinoPreviousX, DinoPreviousY, Dinosaur3D.X(), Dinosaur3D.Y()) + abs(AngleDifference(DinoPreviousAngle, Dinosaur3D.Angle())))

@event
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
do SetNumberVariable variable="CapsuleX" modification_sign="=" value=expr((Player3D.X() - Dinosaur3D.X()) * cos(ToRad(Dinosaur3D.Angle())) + (Player3D.Y() - Dinosaur3D.Y()) * sin(ToRad(Dinosaur3D.Angle())))
do SetNumberVariable variable="CapsuleY" modification_sign="=" value=expr(-(Player3D.X() - Dinosaur3D.X()) * sin(ToRad(Dinosaur3D.Angle())) + (Player3D.Y() - Dinosaur3D.Y()) * cos(ToRad(Dinosaur3D.Angle())))
do SetNumberVariable variable="CapsuleNearestY" modification_sign="=" value=expr(clamp(CapsuleY, -330, 200))
do SetNumberVariable variable="CapsuleDistance" modification_sign="=" value=expr(sqrt(CapsuleX * CapsuleX + (CapsuleY - CapsuleNearestY) * (CapsuleY - CapsuleNearestY)))

@event
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="CapsuleDistance" comparison_sign="<" value=0.001
do SetNumberVariable variable="CapsuleX" modification_sign="=" value=170
do SetNumberVariable variable="CapsuleY" modification_sign="=" value=expr(CapsuleNearestY)
do SetNumberVariable variable="CapsuleDistance" modification_sign="=" value=170

@event
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="CapsuleDistance" comparison_sign="<=" value=170
do SetNumberVariable variable="CapsuleX" modification_sign="=" value=expr(CapsuleX * 170 / CapsuleDistance)
do SetNumberVariable variable="CapsuleY" modification_sign="=" value=expr(CapsuleNearestY + (CapsuleY - CapsuleNearestY) * 170 / CapsuleDistance)
do SetX object="Player3D" modification_sign="=" value=expr(Dinosaur3D.X() + CapsuleX * cos(ToRad(Dinosaur3D.Angle())) - CapsuleY * sin(ToRad(Dinosaur3D.Angle())))
do SetY object="Player3D" modification_sign="=" value=expr(Dinosaur3D.Y() + CapsuleX * sin(ToRad(Dinosaur3D.Angle())) + CapsuleY * cos(ToRad(Dinosaur3D.Angle())))

@event
if NumberVariable variable="Riding" comparison_sign="=" value=1
