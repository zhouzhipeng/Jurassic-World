@comment "Real-time 3D movement and reference comparison" background=[90,150,180] text=[255,255,255]

if KeyFromTextReleased key_to_check="F3"
if NumberVariable variable="Riding" comparison_sign="=" value=0
do SetNumberVariable variable="RenderMode" modification_sign="=" value=expr(1 - RenderMode)

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if BuiltinCommonInstructions::Once
do HideLayer layer="World"
do ShowLayer layer="World3D"
do TextContainerCapability::TextContainerBehavior::SetValue object="DemoLabel" behavior="Text" modification_sign="=" text="REAL-TIME 3D / F3 ART REFERENCE"
do TextContainerCapability::TextContainerBehavior::SetValue object="Controls" behavior="Text" modification_sign="=" text="WASD move   X ride   Hold E gather / interact   F rest   Q travel   TAB pack  ESC menu  RMB orbit  Wheel zoom  Home reset"

if NumberVariable variable="RenderMode" comparison_sign="=" value=0
if BuiltinCommonInstructions::Once
do ShowLayer layer="World"
do HideLayer layer="World3D"
do TextContainerCapability::TextContainerBehavior::SetValue object="DemoLabel" behavior="Text" modification_sign="=" text="ART REFERENCE / F3 REAL-TIME 3D"

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="StationIndex" comparison_sign="=" value=0
if BuiltinCommonInstructions::Once
do SetX object="Player3D" modification_sign="=" value=expr(Dinosaur3D.X())
do SetY object="Player3D" modification_sign="=" value=expr(Dinosaur3D.Y() + 550)
do SetAngle object="Player3D" modification_sign="=" angle_in_degrees=180

if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="StationIndex" comparison_sign="=" value=1
if BuiltinCommonInstructions::Once
do SetX object="Player3D" modification_sign="=" value=-650
do SetY object="Player3D" modification_sign="=" value=350
do SetAngle object="Player3D" modification_sign="=" angle_in_degrees=180

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
do SetNumberVariable variable="PreviousX" modification_sign="=" value=expr(Player3D.X())
do SetNumberVariable variable="PreviousY" modification_sign="=" value=expr(Player3D.Y())
do SetNumberVariable variable="MoveX" modification_sign="=" value=0
do SetNumberVariable variable="MoveY" modification_sign="=" value=0
do SetNumberVariable variable="MoveSpeed" modification_sign="=" value=350

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if KeyFromTextPressed key_to_check="w"
do SetNumberVariable variable="MoveY" modification_sign="=" value=-1
do SetAngle object="Player3D" modification_sign="=" angle_in_degrees=180

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if KeyFromTextPressed key_to_check="s"
do SetNumberVariable variable="MoveY" modification_sign="=" value=1
do SetAngle object="Player3D" modification_sign="=" angle_in_degrees=0

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if KeyFromTextPressed key_to_check="a"
do SetNumberVariable variable="MoveX" modification_sign="=" value=-1
do SetAngle object="Player3D" modification_sign="=" angle_in_degrees=270

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if KeyFromTextPressed key_to_check="d"
do SetNumberVariable variable="MoveX" modification_sign="=" value=1
do SetAngle object="Player3D" modification_sign="=" angle_in_degrees=90

if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="MoveX" comparison_sign="!=" value=0
if NumberVariable variable="MoveY" comparison_sign="!=" value=0
