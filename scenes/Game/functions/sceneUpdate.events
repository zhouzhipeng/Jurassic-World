do SetNumberObjectVariable object="Stegosaur" variable="NearY" modification_sign="=" value=expr(clamp(Stegosaur.Variable(LocalY), -Stegosaur.Variable(HalfLength) + Stegosaur.Variable(Radius), 200 - Stegosaur.Variable(Radius)))
do SetNumberObjectVariable object="Stegosaur" variable="Separation" modification_sign="=" value=expr(max(0.001, sqrt(Stegosaur.Variable(LocalX) * Stegosaur.Variable(LocalX) + pow(Stegosaur.Variable(LocalY) - Stegosaur.Variable(NearY), 2))))

