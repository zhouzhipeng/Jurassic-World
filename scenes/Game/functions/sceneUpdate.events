link "TouchMovement"

@comment "Sprint input" background=[90,150,180] text=[255,255,255]

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="Stamina" comparison_sign=">" value=1
if NumberObjectVariable object="Player3D" variable="SprintExhausted" comparison_sign="=" value=0
if NumberObjectVariable object="Player3D" variable="Sprinting" comparison_sign="=" value=0
if KeyFromTextPressed key_to_check="LShift"
do SetNumberObjectVariable object="Player3D" variable="Sprinting" modification_sign="=" value=1
do SetNumberVariable variable="MoveSpeed" modification_sign="*" value=expr(500 / 350)

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=0
do SetX object="Player3D" modification_sign="+" value=expr((MoveX * cos(ToRad(CameraYaw)) + MoveY * sin(ToRad(CameraYaw))) * MoveSpeed * TimeDelta())
do SetY object="Player3D" modification_sign="+" value=expr((MoveY * cos(ToRad(CameraYaw)) - MoveX * sin(ToRad(CameraYaw))) * MoveSpeed * TimeDelta())

