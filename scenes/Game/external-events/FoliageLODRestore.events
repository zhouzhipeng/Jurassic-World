@comment "Restore logical resource visibility before gameplay picking and exact camera probes; the final LOD pass selects only the render representation." background=[74,176,228] text=[0,0,0]
@event aiGeneratedEventId="foliage-lod-restore-logical-visibility"
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
> @js strict=true expanded=false
for (const name of ["BerryBush", "FiberFern"]) {
  for (const object of runtimeScene.getObjects(name)) {
    const vars = object.getVariables();
    if (vars.get("LODLevel").getAsNumber() > 0 && vars.get("Cooldown").getAsNumber() <= 0) object.hide(false);
  }
}
> @end js
