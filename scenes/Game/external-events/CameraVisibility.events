@event aiGeneratedEventId="camera-fade-berrybush"
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
> for each BerryBush
>> if NumberObjectVariable object="BerryBush" variable="CameraOpacity" comparison_sign="!=" value=expr(BerryBush.CameraAppliedOpacity)
>> do TSLMaterial::SetNumberParameter parameter_3d_model="BerryBush" tsl_material_behavior="CameraFade" binding_name="CameraFade" parameter_name="opacity" value=expr(BerryBush.CameraOpacity / 255)
>> do SetNumberObjectVariable object="BerryBush" variable="CameraAppliedOpacity" modification_sign="=" value=expr(BerryBush.CameraOpacity)
>> if NumberObjectVariable object="BerryBush" variable="CameraFadeReady" comparison_sign="=" value=0
>> if TSLMaterial::IsBindingReady parameter_3d_model="BerryBush" tsl_material_behavior="CameraFade" binding_name="CameraFade"
>> do SetNumberObjectVariable object="BerryBush" variable="CameraFadeReady" modification_sign="=" value=1

