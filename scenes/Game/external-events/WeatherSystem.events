@comment "Native island weather: 0 clear, 1 cloudy, 2 rain, 3 thunderstorm, 4 fog. Weather time freezes with gameplay." background=[90,150,180] text=[255,255,255]

@event aiGeneratedEventId="weather-manual-cycle"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if KeyFromTextReleased key_to_check="F6"
do SetNumberVariable variable="WeatherType" modification_sign="=" value=expr(mod(WeatherType + 1, 5))
do SetNumberVariable variable="WeatherClock" modification_sign="=" value=0
do SetNumberVariable variable="WeatherDuration" modification_sign="=" value=expr(RandomInRange(60, 100))
do SetNumberVariable variable="WeatherChanges" modification_sign="+" value=1

@event aiGeneratedEventId="weather-advance"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
do SetNumberVariable variable="WeatherClock" modification_sign="+" value=expr(TimeDelta())
do SetNumberVariable variable="WeatherMotion" modification_sign="+" value=expr(TimeDelta())
> @event aiGeneratedEventId="weather-choose-next"
> if NumberVariable variable="WeatherClock" comparison_sign=">=" value=expr(WeatherDuration)
> do SetNumberVariable variable="WeatherNext" modification_sign="=" value=1
>> @event
>> if NumberVariable variable="WeatherType" comparison_sign="=" value=1
>> do SetNumberVariable variable="WeatherNext" modification_sign="=" value=expr(Random(2) * 2)

>> @event
>> if NumberVariable variable="WeatherType" comparison_sign="=" value=2
>> do SetNumberVariable variable="WeatherNext" modification_sign="=" value=expr(1 + Random(1) * 2)

>> @event
>> if NumberVariable variable="WeatherType" comparison_sign="=" value=3
>> do SetNumberVariable variable="WeatherNext" modification_sign="=" value=2

>> @event
>> if NumberVariable variable="WeatherType" comparison_sign="=" value=4
>> do SetNumberVariable variable="WeatherNext" modification_sign="=" value=expr(Random(1))

> @event aiGeneratedEventId="weather-automatic-cycle"
> if NumberVariable variable="WeatherClock" comparison_sign=">=" value=expr(WeatherDuration)
> do SetNumberVariable variable="WeatherType" modification_sign="=" value=expr(WeatherNext)
> do SetNumberVariable variable="WeatherClock" modification_sign="=" value=0
> do SetNumberVariable variable="WeatherDuration" modification_sign="=" value=expr(RandomInRange(60, 100))
> do SetNumberVariable variable="WeatherChanges" modification_sign="+" value=1

@event aiGeneratedEventId="weather-apply-preset"
if NumberVariable variable="WeatherApplied" comparison_sign="!=" value=expr(WeatherType)
do SetNumberVariable variable="WeatherCloudTarget" modification_sign="=" value=0
do SetNumberVariable variable="WeatherRainTarget" modification_sign="=" value=0
do SetNumberVariable variable="WeatherMistTarget" modification_sign="=" value=0
do SetNumberVariable variable="WeatherFlash" modification_sign="=" value=0
do SetNumberVariable variable="WeatherLightningClock" modification_sign="=" value=0
do SetNumberVariable variable="WeatherLightningWait" modification_sign="=" value=expr(RandomInRange(8, 16))
do SetNumberVariable variable="WeatherThunderDelay" modification_sign="=" value=-1
do SetNumberVariable variable="WeatherApplied" modification_sign="=" value=expr(WeatherType)
do StopSoundChannel channel_identifier=31
> @event
> if NumberVariable variable="WeatherType" comparison_sign="=" value=0
> do SetStringVariable variable="WeatherName" modification_sign="=" value="晴朗"
> do SetStringVariable variable="WeatherHint" modification_sign="=" value="视野清晰"

> @event
> if NumberVariable variable="WeatherType" comparison_sign="=" value=1
> do SetNumberVariable variable="WeatherCloudTarget" modification_sign="=" value=0.38
> do SetStringVariable variable="WeatherName" modification_sign="=" value="多云"
> do SetStringVariable variable="WeatherHint" modification_sign="=" value="海风渐起"

> @event
> if NumberVariable variable="WeatherType" comparison_sign="=" value=2
> do SetNumberVariable variable="WeatherCloudTarget" modification_sign="=" value=0.75
> do SetNumberVariable variable="WeatherRainTarget" modification_sign="=" value=0.55
> do SetStringVariable variable="WeatherName" modification_sign="=" value="降雨"
> do SetStringVariable variable="WeatherHint" modification_sign="=" value="雨幕笼罩海岸"

> @event
> if NumberVariable variable="WeatherType" comparison_sign="=" value=3
> do SetNumberVariable variable="WeatherCloudTarget" modification_sign="=" value=1
> do SetNumberVariable variable="WeatherRainTarget" modification_sign="=" value=1
> do SetStringVariable variable="WeatherName" modification_sign="=" value="雷暴"
> do SetStringVariable variable="WeatherHint" modification_sign="=" value="可在屋顶下避雨"

> @event
> if NumberVariable variable="WeatherType" comparison_sign="=" value=4
> do SetNumberVariable variable="WeatherCloudTarget" modification_sign="=" value=0.2
> do SetNumberVariable variable="WeatherMistTarget" modification_sign="=" value=1
> do SetStringVariable variable="WeatherName" modification_sign="=" value="雾天"
> do SetStringVariable variable="WeatherHint" modification_sign="=" value="远处能见度降低"

@event aiGeneratedEventId="weather-smooth-and-lightning"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
do SetNumberVariable variable="WeatherCloud" modification_sign="=" value=expr(lerp(WeatherCloud, WeatherCloudTarget, min(1, TimeDelta() * 0.6)))
do SetNumberVariable variable="WeatherRain" modification_sign="=" value=expr(lerp(WeatherRain, WeatherRainTarget, min(1, TimeDelta() * 0.6)))
do SetNumberVariable variable="WeatherMist" modification_sign="=" value=expr(lerp(WeatherMist, WeatherMistTarget, min(1, TimeDelta() * 0.6)))
do SetNumberVariable variable="WeatherFlash" modification_sign="=" value=expr(max(0, WeatherFlash - TimeDelta() * 2.6))
> @event
> if NumberVariable variable="WeatherType" comparison_sign="=" value=3
> do SetNumberVariable variable="WeatherLightningClock" modification_sign="+" value=expr(TimeDelta())
>> @event
>> if NumberVariable variable="WeatherCloud" comparison_sign=">" value=0.8
>> if NumberVariable variable="WeatherLightningClock" comparison_sign=">=" value=expr(WeatherLightningWait)
>> do SetNumberVariable variable="WeatherLightningClock" modification_sign="=" value=0
>> do SetNumberVariable variable="WeatherLightningWait" modification_sign="=" value=expr(RandomInRange(8, 16))
>> do SetNumberVariable variable="WeatherFlash" modification_sign="=" value=1
>> do SetNumberVariable variable="WeatherThunderDelay" modification_sign="=" value=expr(RandomInRange(7, 16) / 10)
>> do SetNumberVariable variable="WeatherLightningCount" modification_sign="+" value=1

> @event
> if NumberVariable variable="WeatherThunderDelay" comparison_sign=">" value=0
> do SetNumberVariable variable="WeatherThunderDelay" modification_sign="=" value=expr(max(0, WeatherThunderDelay - TimeDelta()))

> @event
> if NumberVariable variable="WeatherThunderDelay" comparison_sign="=" value=0
> do SetNumberVariable variable="WeatherThunderDelay" modification_sign="=" value=-1
>> @event
>> if NumberVariable variable="WeatherAudioStarted" comparison_sign="=" value=1
>> do PlaySoundOnChannel audio_file_or_audio_resource_name="weather-thunder.wav" channel_identifier=31 repeat_the_sound=false volume=55 pitch_speed=expr(RandomInRange(90, 105) / 100)
