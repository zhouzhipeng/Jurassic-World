@comment "Distance culling only affects rendering; health, resources and save identities survive." background=[74,176,228] text=[0,0,0]

@event
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
> for each Triceratops

>> @event
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(Triceratops.X(),Triceratops.Y(),Player3D.X(),Player3D.Y())) comparison_sign=">" second_expression=4200
>> do Hide object="Triceratops"
>> do SetNumberObjectVariable object="Triceratops" variable="AnimationPlaying" modification_sign="=" value=0

>> @event
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(Triceratops.X(),Triceratops.Y(),Player3D.X(),Player3D.Y())) comparison_sign="<" second_expression=3800
>> if NumberObjectVariable object="Triceratops" variable="HP" comparison_sign=">" value=0
>> do Show object="Triceratops"

