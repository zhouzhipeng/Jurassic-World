@event
if NumberObjectVariable object="Triceratops" variable="Bond" comparison_sign=">=" value=expr(100)
if NumberVariable variable="CompanionTamed" comparison_sign="=" value=expr(0)
do SetNumberVariable variable="CompanionTamed" modification_sign="=" value=expr(1)
do PlaySound audio_file_or_audio_resource_name="quest-complete.wav" repeat_the_sound=false volume=55 pitch_speed=1
do SetStringVariable variable="NoticeMessage" modification_sign="=" value=expr("三角龙已成为采集伙伴！附近采集浆果和纤维翻倍。H 切换跟随 / 留守。")

@event
if NumberVariable variable="Mode" comparison_sign="=" value=expr(0)
if NumberVariable variable="RenderMode" comparison_sign="=" value=expr(1)
if NumberVariable variable="Dead" comparison_sign="=" value=expr(0)
if NumberVariable variable="BuildMode" comparison_sign="=" value=expr(0)
if KeyFromTextReleased key_to_check="h"
if NumberObjectVariable object="Triceratops" variable="Bond" comparison_sign=">=" value=expr(100)
do SetNumberObjectVariable object="Triceratops" variable="Command" modification_sign="=" value=expr(1-Triceratops.Variable(Command))
do SetStringVariable variable="NoticeMessage" modification_sign="=" value=expr("伙伴命令已切换。靠近三角龙可查看跟随或留守状态。")

@event
if NumberVariable variable="Action" comparison_sign=">" value=expr(0)
do SetNumberVariable variable="Action" modification_sign="=" value=expr(0)
