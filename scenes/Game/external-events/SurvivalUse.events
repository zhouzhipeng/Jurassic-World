do SetNumberObjectVariable object="Triceratops" variable="FeedWait" modification_sign="=" value=expr(4)
do SetNumberVariable variable="FeedingDone" modification_sign="=" value=expr(1)
do SetNumberVariable variable="Dirty" modification_sign="=" value=expr(1)
do PlaySound audio_file_or_audio_resource_name="feed.wav" repeat_the_sound=false volume=55 pitch_speed=1
