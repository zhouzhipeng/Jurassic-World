do PlaySound audio_file_or_audio_resource_name="feed.wav" repeat_the_sound=false volume=55 pitch_speed=1
do SetStringVariable variable="NoticeMessage" modification_sign="=" value=expr("副栉龙信任 +7；驯服后按 X 骑乘。")

