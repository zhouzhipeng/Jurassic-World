if PickNearest object="Triceratops" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),Triceratops.X(),Triceratops.Y())) comparison_sign="<" second_expression=expr(440)
if NumberObjectVariable object="Triceratops" variable="Bond" comparison_sign="<" value=expr(100)
