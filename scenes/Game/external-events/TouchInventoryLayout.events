@comment "Touch inventory: select a grid cell, then explicitly use the selected item."

if NumberVariable variable="TouchMode" comparison_sign=">=" value=expr(0)
do Hide object="PackIcon"
do Hide object="PackCount"
do Hide object="PackName"
do Hide object="PackDetailBack"
do Hide object="PackDetailTitle"
do Hide object="PackDetailBody"

if NumberVariable variable="TouchMode" comparison_sign="=" value=expr(1)
if NumberVariable variable="Mode" comparison_sign="=" value=expr(1)
if NumberVariable variable="TouchPanel" comparison_sign="=" value=expr(2)
if NumberVariable variable="Dead" comparison_sign="=" value=expr(0)
do SetStringVariable variable="TouchPanelTitle" modification_sign="=" value=expr("背包")
do SetStringVariable variable="TouchPanelBody" modification_sign="=" value=expr("点选物品查看详情")
do SetNumberVariable variable="PackColumns" modification_sign="=" value=expr(5)
do SetNumberVariable variable="PackRows" modification_sign="=" value=expr(4)
do SetNumberVariable variable="PackGap" modification_sign="=" value=expr(10*TouchScale)
do SetNumberVariable variable="PackAreaWidth" modification_sign="=" value=expr(TouchMenuWidth*0.59-24*TouchScale)
do SetNumberVariable variable="PackAreaHeight" modification_sign="=" value=expr(TouchMenuHeight-174*TouchScale)
do SetNumberVariable variable="PackGridX" modification_sign="=" value=expr(TouchMenuX+24*TouchScale)
do SetNumberVariable variable="PackGridY" modification_sign="=" value=expr(TouchMenuY+132*TouchScale)
do SetNumberVariable variable="PackDetailX" modification_sign="=" value=expr(TouchMenuX+TouchMenuWidth*0.62)
do SetNumberVariable variable="PackDetailY" modification_sign="=" value=expr(PackGridY)
do SetNumberVariable variable="PackDetailWidth" modification_sign="=" value=expr(TouchMenuWidth*0.38-24*TouchScale)

if NumberVariable variable="TouchMode" comparison_sign="=" value=expr(1)
if NumberVariable variable="Mode" comparison_sign="=" value=expr(1)
if NumberVariable variable="TouchPanel" comparison_sign="=" value=expr(2)
if NumberVariable variable="Dead" comparison_sign="=" value=expr(0)
if NumberVariable variable="TouchColumns" comparison_sign="=" value=expr(1)
do SetNumberVariable variable="PackColumns" modification_sign="=" value=expr(4)
do SetNumberVariable variable="PackRows" modification_sign="=" value=expr(5)
do SetNumberVariable variable="PackAreaWidth" modification_sign="=" value=expr(TouchMenuWidth-48*TouchScale)
do SetNumberVariable variable="PackAreaHeight" modification_sign="=" value=expr(TouchMenuHeight-528*TouchScale)

if NumberVariable variable="TouchMode" comparison_sign="=" value=expr(1)
if NumberVariable variable="Mode" comparison_sign="=" value=expr(1)
if NumberVariable variable="TouchPanel" comparison_sign="=" value=expr(2)
if NumberVariable variable="Dead" comparison_sign="=" value=expr(0)
do SetNumberVariable variable="PackCell" modification_sign="=" value=expr(min((PackAreaWidth-(PackColumns-1)*PackGap)/PackColumns,(PackAreaHeight-(PackRows-1)*PackGap)/PackRows))
do SetNumberVariable variable="PackGridWidth" modification_sign="=" value=expr(PackColumns*PackCell+(PackColumns-1)*PackGap)
do SetNumberVariable variable="PackGridHeight" modification_sign="=" value=expr(PackRows*PackCell+(PackRows-1)*PackGap)

if NumberVariable variable="TouchMode" comparison_sign="=" value=expr(1)
if NumberVariable variable="Mode" comparison_sign="=" value=expr(1)
if NumberVariable variable="TouchPanel" comparison_sign="=" value=expr(2)
if NumberVariable variable="Dead" comparison_sign="=" value=expr(0)
if NumberVariable variable="TouchColumns" comparison_sign="=" value=expr(1)
do SetNumberVariable variable="PackGridX" modification_sign="=" value=expr(TouchMenuX+(TouchMenuWidth-PackGridWidth)/2)
do SetNumberVariable variable="PackDetailX" modification_sign="=" value=expr(PackGridX)
do SetNumberVariable variable="PackDetailY" modification_sign="=" value=expr(PackGridY+PackGridHeight+28*TouchScale)
do SetNumberVariable variable="PackDetailWidth" modification_sign="=" value=expr(PackGridWidth)

