do TextObject::Text::SetFontSize object="PackDetailTitle" modification_sign="=" value=expr(30*TouchScale)
do TextContainerCapability::TextContainerBehavior::SetValue object="PackDetailTitle" behavior="Text" modification_sign="=" text=expr(PackTitle+"  ×"+ToString(PackQuantity))
