@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=1
if NumberVariable variable="TouchPanel" comparison_sign="=" value=2
if NumberVariable variable="Dead" comparison_sign="=" value=0
> @event
> for each "PackIcon"
>> @event
>> if NumberObjectVariable object="TouchButton" variable="Slot" comparison_sign="=" value=expr(PackIcon.Variable(Slot))
>> do SetX object="PackIcon" modification_sign="=" value=expr(TouchButton.X()+PackCell*0.15)
>> do SetY object="PackIcon" modification_sign="=" value=expr(TouchButton.Y()+PackCell*0.07)
>> do ResizableCapability::ResizableBehavior::SetSize object="PackIcon" behavior="Resizable" width=expr(PackCell*0.7) height=expr(PackCell*0.7)

>> @event
>> if NumberObjectVariable object="PackName" variable="Slot" comparison_sign="=" value=expr(PackIcon.Variable(Slot))
>> do SetX object="PackName" modification_sign="=" value=expr(PackIcon.X()-PackCell*0.09)
>> do SetY object="PackName" modification_sign="=" value=expr(PackIcon.Y()+PackCell*0.67)
>> do TextObject::SetWrapping object="PackName" wrapping=true
>> do TextObject::WrappingWidth object="PackName" modification_sign="=" value=expr(PackCell*0.88)
>> do TextObject::Text::SetFontSize object="PackName" modification_sign="=" value=expr(min(PackCell*0.20,26*TouchScale))
>> do TextContainerCapability::TextContainerBehavior::SetValue object="PackName" behavior="Text" modification_sign="=" text=expr(PackIcon.VariableString(Caption))

>> @event
>> if NumberObjectVariable object="PackCount" variable="Slot" comparison_sign="=" value=expr(PackIcon.Variable(Slot))
>> do SetX object="PackCount" modification_sign="=" value=expr(PackIcon.X()-PackCell*0.09)
>> do SetY object="PackCount" modification_sign="=" value=expr(PackIcon.Y()-PackCell*0.015)
>> do TextObject::SetWrapping object="PackCount" wrapping=true
>> do TextObject::WrappingWidth object="PackCount" modification_sign="=" value=expr(PackCell*0.85)
>> do TextObject::Text::SetFontSize object="PackCount" modification_sign="=" value=expr(min(PackCell*0.24,28*TouchScale))
>> do TextContainerCapability::TextContainerBehavior::SetValue object="PackCount" behavior="Text" modification_sign="=" text=expr(ToString(PackIcon.Variable(Quantity)))

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=1
if NumberVariable variable="TouchPanel" comparison_sign="=" value=2
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberObjectVariable object="PackCount" variable="Slot" comparison_sign="=" value=206
if NumberVariable variable="Canteen" comparison_sign=">" value=0
do TextObject::SetWrapping object="PackCount" wrapping=true
do TextObject::WrappingWidth object="PackCount" modification_sign="=" value=expr(PackCell*0.85)
do TextObject::Text::SetFontSize object="PackCount" modification_sign="=" value=expr(min(PackCell*0.22,26*TouchScale))
do TextContainerCapability::TextContainerBehavior::SetValue object="PackCount" behavior="Text" modification_sign="=" text=expr(ToString(CanteenCharges)+"/3")

@event
