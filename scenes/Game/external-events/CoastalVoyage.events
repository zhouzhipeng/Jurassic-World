@comment "A rowboat links the eastern beach to a small explorable islet. F or the context button boards and disembarks." background=[68,135,157] text=[255,255,255]

@event aiGeneratedEventId="boat-cooldown"
if NumberVariable variable="BoatCooldown" comparison_sign=">" value=0
do SetNumberVariable variable="BoatCooldown" modification_sign="=" value=expr(max(0,BoatCooldown-TimeDelta()))

@event aiGeneratedEventId="boat-key-toggle"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if KeyFromTextJustPressed key_to_check="f"
do SetNumberVariable variable="BoatToggleRequest" modification_sign="=" value=1

@event aiGeneratedEventId="boat-mainland-landfall"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="BoatToggleRequest" comparison_sign="=" value=1
if NumberVariable variable="BoatCooldown" comparison_sign="<=" value=0
if PosX object="Rowboat" comparison_sign="<=" value=6520
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(Rowboat.Y()+1000)) comparison_sign="<=" second_expression=500
do SetNumberVariable variable="Sailing" modification_sign="=" value=0
do SetNumberVariable variable="IsletVisit" modification_sign="=" value=0
do SetNumberVariable variable="BoatCooldown" modification_sign="=" value=0.45
do SetX object="Player3D" modification_sign="=" value=expr(Rowboat.X()-720)
do SetY object="Player3D" modification_sign="=" value=expr(Rowboat.Y())
do SetNumberVariable variable="PlayerFloor" modification_sign="=" value=0
do Scene3D::Base3DBehavior::SetZ parameter_3d_object="Player3D" behavior="Object3D" modification_sign="=" value=0
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="已回到海岸。靠近小船按 F 再次出航。"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

@event aiGeneratedEventId="boat-islet-landfall"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="BoatToggleRequest" comparison_sign="=" value=1
if NumberVariable variable="BoatCooldown" comparison_sign="<=" value=0
if PosX object="Rowboat" comparison_sign=">=" value=8650
if PosX object="Rowboat" comparison_sign="<=" value=8720
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(Rowboat.Y()+1000)) comparison_sign="<=" second_expression=280
do SetNumberVariable variable="Sailing" modification_sign="=" value=0
do SetNumberVariable variable="IsletVisit" modification_sign="=" value=1
do SetNumberVariable variable="BoatCooldown" modification_sign="=" value=0.45
do SetX object="Player3D" modification_sign="=" value=expr(Rowboat.X()+300)
do SetY object="Player3D" modification_sign="=" value=expr(Rowboat.Y())
do SetNumberVariable variable="PlayerFloor" modification_sign="=" value=25
do Scene3D::Base3DBehavior::SetZ parameter_3d_object="Player3D" behavior="Object3D" modification_sign="=" value=25
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="已登上近海小岛。探索棕榈林，回到西岸乘船返航。"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

@event aiGeneratedEventId="boat-cannot-land-offshore"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="BoatToggleRequest" comparison_sign="=" value=1
if NumberVariable variable="BoatCooldown" comparison_sign="<=" value=0
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="这里水深，驶到主岛岸边或小岛西侧浅滩再下船。"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetNumberVariable variable="BoatCooldown" modification_sign="=" value=0.45

@event aiGeneratedEventId="boat-board"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=0
if NumberVariable variable="BoatToggleRequest" comparison_sign="=" value=1
if NumberVariable variable="BoatCooldown" comparison_sign="<=" value=0
if Distance object="Player3D" object_2="Rowboat" distance=750
do SetNumberVariable variable="Sailing" modification_sign="=" value=1
do SetNumberVariable variable="IsletVisit" modification_sign="=" value=0
do SetNumberVariable variable="BoatCooldown" modification_sign="=" value=0.45
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="已上船：WASD / 摇杆航行；停船按 G /「钓鱼」抛线，靠岸按 F /「靠岸」下船。"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

@event aiGeneratedEventId="boat-consume-toggle"
if NumberVariable variable="BoatToggleRequest" comparison_sign="=" value=1
do SetNumberVariable variable="BoatToggleRequest" modification_sign="=" value=0

@event aiGeneratedEventId="boat-near-prompt"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BoatPromptSeen" comparison_sign="=" value=0
if Distance object="Player3D" object_2="Rowboat" distance=850
do SetNumberVariable variable="BoatPromptSeen" modification_sign="=" value=1
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="岸边的小船：靠近后按 F 上船，驶往东面的近海小岛。"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

@event aiGeneratedEventId="fishing-key-request"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if KeyFromTextJustPressed key_to_check="g"
do SetNumberVariable variable="FishingRequest" modification_sign="=" value=1

@event aiGeneratedEventId="fishing-leave-boat"
if NumberVariable variable="Sailing" comparison_sign="=" value=0
if NumberVariable variable="FishingState" comparison_sign="!=" value=0
do SetNumberVariable variable="FishingState" modification_sign="=" value=0
do SetNumberVariable variable="FishingClock" modification_sign="=" value=0
do SetNumberVariable variable="FishingResult" modification_sign="=" value=0

@event aiGeneratedEventId="fishing-moving-cancels"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="FishingState" comparison_sign=">" value=0
if NumberVariable variable="FishingState" comparison_sign="<" value=3
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(MoveX)+abs(MoveY)) comparison_sign=">" second_expression=0.15
do SetNumberVariable variable="FishingState" modification_sign="=" value=3
do SetNumberVariable variable="FishingResult" modification_sign="=" value=-3
do SetNumberVariable variable="FishingClock" modification_sign="=" value=1.5
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="划船惊走了鱼；停船后再抛线。"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

@event aiGeneratedEventId="fishing-reel-catch"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="FishingState" comparison_sign="=" value=2
if NumberVariable variable="FishingRequest" comparison_sign="=" value=1
do SetNumberVariable variable="Meat" modification_sign="+" value=1
do SetNumberVariable variable="FishingState" modification_sign="=" value=3
do SetNumberVariable variable="FishingClock" modification_sign="=" value=2
do SetNumberVariable variable="FishingResult" modification_sign="=" value=1
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="钓到一条鱼！鱼肉 +1，已作为生肉放入背包，可在篝火烹饪。"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

@event aiGeneratedEventId="fishing-reel-too-early"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="FishingState" comparison_sign="=" value=1
if NumberVariable variable="FishingRequest" comparison_sign="=" value=1
do SetNumberVariable variable="FishingState" modification_sign="=" value=3
do SetNumberVariable variable="FishingClock" modification_sign="=" value=1.5
do SetNumberVariable variable="FishingResult" modification_sign="=" value=-1
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="收线太早，鱼还没有咬钩。"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

@event aiGeneratedEventId="fishing-cast"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="FishingState" comparison_sign="=" value=0
if NumberVariable variable="FishingRequest" comparison_sign="=" value=1
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(MoveX)+abs(MoveY)) comparison_sign="<=" second_expression=0.15
do SetNumberVariable variable="FishingState" modification_sign="=" value=1
do SetNumberVariable variable="FishingClock" modification_sign="=" value=3
do SetNumberVariable variable="FishingResult" modification_sign="=" value=0
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="鱼线已抛出。保持船只静止，看到咬钩提示后按 G /「收线」！"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

@event aiGeneratedEventId="fishing-request-consumed"
if NumberVariable variable="FishingRequest" comparison_sign="=" value=1
do SetNumberVariable variable="FishingRequest" modification_sign="=" value=0

@event aiGeneratedEventId="fishing-wait"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="FishingState" comparison_sign="=" value=1
do SetNumberVariable variable="FishingClock" modification_sign="-" value=expr(TimeDelta())

@event aiGeneratedEventId="fishing-bite"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="FishingState" comparison_sign="=" value=1
if NumberVariable variable="FishingClock" comparison_sign="<=" value=0
do SetNumberVariable variable="FishingState" modification_sign="=" value=2
do SetNumberVariable variable="FishingClock" modification_sign="=" value=2.5
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="鱼咬钩了！现在按 G /「收线」！"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

@event aiGeneratedEventId="fishing-bite-window"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="FishingState" comparison_sign="=" value=2
do SetNumberVariable variable="FishingClock" modification_sign="-" value=expr(TimeDelta())

@event aiGeneratedEventId="fishing-missed-bite"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="FishingState" comparison_sign="=" value=2
if NumberVariable variable="FishingClock" comparison_sign="<=" value=0
do SetNumberVariable variable="FishingState" modification_sign="=" value=3
do SetNumberVariable variable="FishingClock" modification_sign="=" value=1.5
do SetNumberVariable variable="FishingResult" modification_sign="=" value=-2
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="鱼挣脱了鱼钩；稍等片刻再试。"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

@event aiGeneratedEventId="fishing-cooldown"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="FishingState" comparison_sign="=" value=3
do SetNumberVariable variable="FishingClock" modification_sign="-" value=expr(TimeDelta())

@event aiGeneratedEventId="fishing-ready-again"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="FishingState" comparison_sign="=" value=3
if NumberVariable variable="FishingClock" comparison_sign="<=" value=0
do SetNumberVariable variable="FishingState" modification_sign="=" value=0
do SetNumberVariable variable="FishingClock" modification_sign="=" value=0
do SetNumberVariable variable="FishingResult" modification_sign="=" value=0

@event aiGeneratedEventId="boat-remember-position"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=1
do SetNumberVariable variable="BoatPreviousX" modification_sign="=" value=expr(Rowboat.X())
do SetNumberVariable variable="BoatPreviousY" modification_sign="=" value=expr(Rowboat.Y())

@event aiGeneratedEventId="boat-rowing"
local boatHeading = 0
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="MoveX" comparison_sign="!=" value=0
or NumberVariable variable="MoveY" comparison_sign="!=" value=0
do SetNumberVariable variable="boatHeading" modification_sign="=" value=expr(AngleBetweenPositions(0,0,MoveX,MoveY)-CameraYaw-90)
do RotateTowardAngle object="Rowboat" angle_to_rotate_towards_in_degrees=expr(boatHeading) angular_speed_in_degrees_per_second=180
do SetX object="Rowboat" modification_sign="+" value=expr(cos(ToRad(Rowboat.Angle()+90))*620*TimeDelta()*max(0,cos(ToRad(AngleDifference(Rowboat.Angle(),boatHeading)))))
do SetY object="Rowboat" modification_sign="+" value=expr(sin(ToRad(Rowboat.Angle()+90))*620*TimeDelta()*max(0,cos(ToRad(AngleDifference(Rowboat.Angle(),boatHeading)))))

@event aiGeneratedEventId="boat-deep-water-limits"
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Rowboat.X()) comparison_sign="<" second_expression=6460
or BuiltinCommonInstructions::CompareNumbers first_expression=expr(Rowboat.X()) comparison_sign=">" second_expression=11000
or BuiltinCommonInstructions::CompareNumbers first_expression=expr(Rowboat.Y()) comparison_sign="<" second_expression=-4500
or BuiltinCommonInstructions::CompareNumbers first_expression=expr(Rowboat.Y()) comparison_sign=">" second_expression=3000
or BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(Rowboat.X(),Rowboat.Y(),9500,-1000)) comparison_sign="<" second_expression=780
do SetX object="Rowboat" modification_sign="=" value=expr(BoatPreviousX)
do SetY object="Rowboat" modification_sign="=" value=expr(BoatPreviousY)

@event aiGeneratedEventId="boat-player-follows"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=1
do SetX object="Player3D" modification_sign="=" value=expr(Rowboat.X())
do SetY object="Player3D" modification_sign="=" value=expr(Rowboat.Y())
do SetAngle object="Player3D" modification_sign="=" angle_in_degrees=expr(Rowboat.Angle())
do SetNumberVariable variable="PlayerFloor" modification_sign="=" value=-50
do Scene3D::Base3DBehavior::SetZ parameter_3d_object="Player3D" behavior="Object3D" modification_sign="=" value=-50
do SetNumberVariable variable="JumpVelocity" modification_sign="=" value=0

@event aiGeneratedEventId="boat-oars-rest"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=0
do AnimatableCapability::AnimatableBehavior::SetName object="Rowboat" behavior="Animation" modification_sign="=" animation_name="OarsRest"
do AnimatableCapability::AnimatableBehavior::PlayAnimation object="Rowboat" behavior="Animation"

@event aiGeneratedEventId="boat-seated-idle"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="MoveX" comparison_sign="=" value=0
if NumberVariable variable="MoveY" comparison_sign="=" value=0
do SetNumberObjectVariable object="Player3D" variable="AnimationState" modification_sign="=" value=12
do SetNumberObjectVariable object="Player3D" variable="AnimationPlaying" modification_sign="=" value=1
do AnimatableCapability::AnimatableBehavior::SetName object="Rowboat" behavior="Animation" modification_sign="=" animation_name="OarsRest"
do AnimatableCapability::AnimatableBehavior::PlayAnimation object="Rowboat" behavior="Animation"

@event aiGeneratedEventId="boat-seated-rowing"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="MoveX" comparison_sign="!=" value=0
or NumberVariable variable="MoveY" comparison_sign="!=" value=0
do SetNumberObjectVariable object="Player3D" variable="AnimationState" modification_sign="=" value=13
do AnimatableCapability::AnimatableBehavior::SetName object="Rowboat" behavior="Animation" modification_sign="=" animation_name="OarsRow"
do AnimatableCapability::AnimatableBehavior::PlayAnimation object="Rowboat" behavior="Animation"

@event aiGeneratedEventId="fishing-cast-animation"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="FishingState" comparison_sign="=" value=1
if NumberVariable variable="FishingClock" comparison_sign=">" value=2.3
do SetNumberObjectVariable object="Player3D" variable="AnimationState" modification_sign="=" value=14
do SetNumberObjectVariable object="Player3D" variable="FishingRodVisible" modification_sign="=" value=1

@event aiGeneratedEventId="fishing-wait-animation"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="FishingState" comparison_sign="=" value=1
if NumberVariable variable="FishingClock" comparison_sign="<=" value=2.3
do SetNumberObjectVariable object="Player3D" variable="AnimationState" modification_sign="=" value=15
do SetNumberObjectVariable object="Player3D" variable="FishingRodVisible" modification_sign="=" value=1

@event aiGeneratedEventId="fishing-bite-animation"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="FishingState" comparison_sign="=" value=2
do SetNumberObjectVariable object="Player3D" variable="AnimationState" modification_sign="=" value=16
do SetNumberObjectVariable object="Player3D" variable="FishingRodVisible" modification_sign="=" value=1

@event aiGeneratedEventId="fishing-reel-animation"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Sailing" comparison_sign="=" value=1
if NumberVariable variable="FishingState" comparison_sign="=" value=3
if NumberVariable variable="FishingResult" comparison_sign="=" value=1
do SetNumberObjectVariable object="Player3D" variable="AnimationState" modification_sign="=" value=17
do SetNumberObjectVariable object="Player3D" variable="FishingRodVisible" modification_sign="=" value=1

@event aiGeneratedEventId="islet-shore-boundary"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="IsletVisit" comparison_sign="=" value=1
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),9500,-1000)) comparison_sign=">" second_expression=580
do SetX object="Player3D" modification_sign="=" value=expr(PreviousX)
do SetY object="Player3D" modification_sign="=" value=expr(PreviousY)

@event aiGeneratedEventId="islet-discovery"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="IsletVisit" comparison_sign="=" value=1
if NumberVariable variable="IsletExplored" comparison_sign="=" value=0
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),9500,-1000)) comparison_sign="<" second_expression=250
do SetNumberVariable variable="IsletExplored" modification_sign="=" value=1
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="发现近海小岛的棕榈林！西侧停着小船，可随时返航。"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1

@event aiGeneratedEventId="islet-restore-boat"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=0
if NumberVariable variable="IsletVisit" comparison_sign="=" value=0
if PosX object="Player3D" comparison_sign=">" value=8800
if PosX object="Player3D" comparison_sign="<" value=10100
if PosY object="Player3D" comparison_sign=">" value=-1600
if PosY object="Player3D" comparison_sign="<" value=-400
do SetNumberVariable variable="IsletVisit" modification_sign="=" value=1
do SetX object="Rowboat" modification_sign="=" value=8700
do SetY object="Rowboat" modification_sign="=" value=-1000

@event aiGeneratedEventId="boat-restore-at-sea"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Action" comparison_sign="=" value=10
if NumberVariable variable="Sailing" comparison_sign="=" value=0
if NumberVariable variable="IsletVisit" comparison_sign="=" value=0
if PosX object="Player3D" comparison_sign=">" value=5814
if PosX object="Player3D" comparison_sign="<" value=11000
if PosY object="Player3D" comparison_sign=">" value=-4500
if PosY object="Player3D" comparison_sign="<" value=3000
do SetX object="Rowboat" modification_sign="=" value=expr(Player3D.X())
do SetY object="Rowboat" modification_sign="=" value=expr(Player3D.Y())
do SetNumberVariable variable="Sailing" modification_sign="=" value=1
