> if NumberObjectVariable object="HillMineCrystal" variable="Kind" comparison_sign="=" value=1
> do SetNumberVariable variable="Amethyst" modification_sign="+" value=2
> do SetStringVariable variable="NoticeMessage" modification_sign="=" value="获得紫水晶 +2。"
