if KeyFromTextPressed key_to_check="e"
or NumberVariable variable="TouchAutoHarvest" comparison_sign="=" value=1
if PickNearest object="HillMineCrystal" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
if Distance object="Player3D" object_2="HillMineCrystal" distance=170
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(PlayerFloor-HillMineCrystal.Object3D::Z())) comparison_sign="<" second_expression=120
if NumberObjectVariable object="HillMineCrystal" variable="Cooldown" comparison_sign="<=" value=0
do SetNumberObjectVariable object="HillMineCrystal" variable="Progress" modification_sign="+" value=expr(TimeDelta())

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if PickNearest object="HillMineCrystal" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
if Distance object="Player3D" object_2="HillMineCrystal" distance=170
if NumberObjectVariable object="HillMineCrystal" variable="Cooldown" comparison_sign="<=" value=0
do TextContainerCapability::TextContainerBehavior::SetValue object="WildHint" behavior="Text" modification_sign="=" text=expr("洞穴水晶 · 按住 E 采集 "+ToString(min(100,round(HillMineCrystal.Variable(Progress)/1.2*100)))+"% · 小心蛇与巨蛛")

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if PickNearest object="HillMineCrystal" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
if Distance object="Player3D" object_2="HillMineCrystal" distance=170
if NumberObjectVariable object="HillMineCrystal" variable="Cooldown" comparison_sign="<=" value=0
if NumberObjectVariable object="HillMineCrystal" variable="Progress" comparison_sign=">=" value=1.2
if NumberVariable variable="Stamina" comparison_sign=">=" value=3
do SetNumberObjectVariable object="HillMineCrystal" variable="Cooldown" modification_sign="=" value=180
do SetNumberObjectVariable object="HillMineCrystal" variable="Progress" modification_sign="=" value=0
do SetNumberVariable variable="Stamina" modification_sign="-" value=3
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetNumberVariable variable="TouchAutoHarvest" modification_sign="=" value=0
do Hide object="HillMineCrystal"
do PlaySound audio_file_or_audio_resource_name="harvest.wav" repeat_the_sound=false volume=55 pitch_speed=1.2
