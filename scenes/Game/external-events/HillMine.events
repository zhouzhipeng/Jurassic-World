@comment "West hill mine: work the rare seams while watching for cave wildlife" background=[76,90,108] text=[255,255,255]

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if Distance object="Player3D" object_2="HillMineGallery" distance=310
do TextContainerCapability::TextContainerBehavior::SetValue object="WildHint" behavior="Text" modification_sign="=" text="西山矿洞 · 沿坡进入 · E 开采稀有金属与水晶 · K 防御洞穴生物"

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="MineHurtCooldown" comparison_sign=">" value=0
do SetNumberVariable variable="MineHurtCooldown" modification_sign="=" value=expr(max(0,MineHurtCooldown-TimeDelta()))

@event
if NumberObjectVariable object="HillMineVein" variable="Cooldown" comparison_sign=">" value=0
do SetNumberObjectVariable object="HillMineVein" variable="Cooldown" modification_sign="=" value=expr(max(0,HillMineVein.Variable(Cooldown)-TimeDelta()))
do Hide object="HillMineVein"

@event
if NumberObjectVariable object="HillMineVein" variable="Cooldown" comparison_sign="<=" value=0
do Show object="HillMineVein"

@event
if NumberObjectVariable object="HillMineCrystal" variable="Cooldown" comparison_sign=">" value=0
do SetNumberObjectVariable object="HillMineCrystal" variable="Cooldown" modification_sign="=" value=expr(max(0,HillMineCrystal.Variable(Cooldown)-TimeDelta()))
do Hide object="HillMineCrystal"

@event
if NumberObjectVariable object="HillMineCrystal" variable="Cooldown" comparison_sign="<=" value=0
do Show object="HillMineCrystal"

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=0
if NumberVariable variable="Stamina" comparison_sign=">=" value=4
if KeyFromTextPressed key_to_check="e"
or NumberVariable variable="TouchAutoHarvest" comparison_sign="=" value=1
if PickNearest object="HillMineVein" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
if Distance object="Player3D" object_2="HillMineVein" distance=175
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(PlayerFloor-HillMineVein.Object3D::Z())) comparison_sign="<" second_expression=120
if NumberObjectVariable object="HillMineVein" variable="Cooldown" comparison_sign="<=" value=0
do SetNumberObjectVariable object="HillMineVein" variable="Progress" modification_sign="+" value=expr(TimeDelta())

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if PickNearest object="HillMineVein" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
if Distance object="Player3D" object_2="HillMineVein" distance=175
if NumberObjectVariable object="HillMineVein" variable="Cooldown" comparison_sign="<=" value=0
do TextContainerCapability::TextContainerBehavior::SetValue object="WildHint" behavior="Text" modification_sign="=" text=expr("稀有金属矿脉 · 按住 E 开采 "+ToString(min(100,round(HillMineVein.Variable(Progress)/1.6*100)))+"% · 小心蛇与巨蛛")

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if PickNearest object="HillMineVein" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
if Distance object="Player3D" object_2="HillMineVein" distance=175
if NumberObjectVariable object="HillMineVein" variable="Cooldown" comparison_sign="<=" value=0
if NumberObjectVariable object="HillMineVein" variable="Progress" comparison_sign=">=" value=1.6
if NumberVariable variable="Stamina" comparison_sign=">=" value=4
do SetNumberObjectVariable object="HillMineVein" variable="Cooldown" modification_sign="=" value=240
do SetNumberObjectVariable object="HillMineVein" variable="Progress" modification_sign="=" value=0
do SetNumberVariable variable="Stamina" modification_sign="-" value=4
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetNumberVariable variable="TouchAutoHarvest" modification_sign="=" value=0
do Hide object="HillMineVein"
do PlaySound audio_file_or_audio_resource_name="harvest.wav" repeat_the_sound=false volume=55 pitch_speed=1
> @event
