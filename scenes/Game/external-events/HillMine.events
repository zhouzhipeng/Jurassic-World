@event
if KeyFromTextReleased key_to_check="e"
do SetNumberObjectVariable object="HillMineVein" variable="Progress" modification_sign="=" value=0
do SetNumberObjectVariable object="HillMineCrystal" variable="Progress" modification_sign="=" value=0

@comment "Large spiders and a cave serpent guard the deep seams" background=[113,64,64] text=[255,255,255]

@event
if NumberObjectVariable object="HillMineSpider" variable="Respawn" comparison_sign=">" value=0
do SetNumberObjectVariable object="HillMineSpider" variable="Respawn" modification_sign="=" value=expr(max(0,HillMineSpider.Variable(Respawn)-TimeDelta()))

@event
if NumberObjectVariable object="HillMineSpider" variable="HP" comparison_sign="<=" value=0
if NumberObjectVariable object="HillMineSpider" variable="Respawn" comparison_sign="=" value=-1
do SetNumberObjectVariable object="HillMineSpider" variable="Respawn" modification_sign="=" value=180
do Hide object="HillMineSpider"

@event
if NumberObjectVariable object="HillMineSpider" variable="HP" comparison_sign="<=" value=0
if NumberObjectVariable object="HillMineSpider" variable="Respawn" comparison_sign="<=" value=0
do SetNumberObjectVariable object="HillMineSpider" variable="Respawn" modification_sign="=" value=-1
do SetNumberObjectVariable object="HillMineSpider" variable="HP" modification_sign="=" value=45
do Show object="HillMineSpider"

@event
if NumberObjectVariable object="HillMineSerpent" variable="Respawn" comparison_sign=">" value=0
do SetNumberObjectVariable object="HillMineSerpent" variable="Respawn" modification_sign="=" value=expr(max(0,HillMineSerpent.Variable(Respawn)-TimeDelta()))

@event
if NumberObjectVariable object="HillMineSerpent" variable="HP" comparison_sign="<=" value=0
if NumberObjectVariable object="HillMineSerpent" variable="Respawn" comparison_sign="=" value=-1
do SetNumberObjectVariable object="HillMineSerpent" variable="Respawn" modification_sign="=" value=180
do Hide object="HillMineSerpent"

@event
if NumberObjectVariable object="HillMineSerpent" variable="HP" comparison_sign="<=" value=0
if NumberObjectVariable object="HillMineSerpent" variable="Respawn" comparison_sign="<=" value=0
do SetNumberObjectVariable object="HillMineSerpent" variable="Respawn" modification_sign="=" value=-1
do SetNumberObjectVariable object="HillMineSerpent" variable="HP" modification_sign="=" value=60
do Show object="HillMineSerpent"

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="MineHurtCooldown" comparison_sign="<=" value=0
if NumberObjectVariable object="HillMineSpider" variable="HP" comparison_sign=">" value=0
if Distance object="Player3D" object_2="HillMineSpider" distance=115
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(PlayerFloor-HillMineSpider.Object3D::Z())) comparison_sign="<" second_expression=110
do SetNumberVariable variable="Health" modification_sign="-" value=8
do SetNumberVariable variable="MineHurtCooldown" modification_sign="=" value=2
do SetNumberVariable variable="HitFlash" modification_sign="=" value=0.25
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="巨蛛撕咬！离开洞穴生物的攻击范围。"
do PlaySound audio_file_or_audio_resource_name="hurt.wav" repeat_the_sound=false volume=60 pitch_speed=1

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="MineHurtCooldown" comparison_sign="<=" value=0
if NumberObjectVariable object="HillMineSerpent" variable="HP" comparison_sign=">" value=0
if Distance object="Player3D" object_2="HillMineSerpent" distance=130
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(PlayerFloor-HillMineSerpent.Object3D::Z())) comparison_sign="<" second_expression=110
do SetNumberVariable variable="Health" modification_sign="-" value=12
do SetNumberVariable variable="MineHurtCooldown" modification_sign="=" value=2.5
do SetNumberVariable variable="HitFlash" modification_sign="=" value=0.25
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="洞穴蛇咬伤！暂时撤离或用 K 攻击。"
do PlaySound audio_file_or_audio_resource_name="hurt.wav" repeat_the_sound=false volume=60 pitch_speed=0.9

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="CombatHit" comparison_sign="=" value=1
if NumberObjectVariable object="HillMineSpider" variable="HP" comparison_sign=">" value=0
if Distance object="Player3D" object_2="HillMineSpider" distance=210
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(PlayerFloor-HillMineSpider.Object3D::Z())) comparison_sign="<" second_expression=130
do SetNumberObjectVariable object="HillMineSpider" variable="HP" modification_sign="-" value=expr(12+min(1,Spear)*23+MetalTools*10)
do SetNumberVariable variable="CombatHit" modification_sign="=" value=0
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="击中了洞穴巨蛛。"

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="CombatHit" comparison_sign="=" value=1
if NumberObjectVariable object="HillMineSerpent" variable="HP" comparison_sign=">" value=0
if Distance object="Player3D" object_2="HillMineSerpent" distance=210
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(PlayerFloor-HillMineSerpent.Object3D::Z())) comparison_sign="<" second_expression=130
do SetNumberObjectVariable object="HillMineSerpent" variable="HP" modification_sign="-" value=expr(12+min(1,Spear)*23+MetalTools*10)
do SetNumberVariable variable="CombatHit" modification_sign="=" value=0
do SetStringVariable variable="NoticeMessage" modification_sign="=" value="击中了洞穴蛇。"
