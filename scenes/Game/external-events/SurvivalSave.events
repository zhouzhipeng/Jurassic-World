@comment "Additional survival save data; native storage and per-fire/per-seam identity" background=[90,150,120] text=[255,255,255]

@event
if NumberVariable variable="SaveRequested" comparison_sign="=" value=1
do EcrireFichierExp storage_name=expr(SaveStorage) group="SurvivalVersion" expression=1
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.BodyTemp" expression=expr(BodyTemp)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.Wetness" expression=expr(Wetness)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.NeedsClock" expression=expr(NeedsClock)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.CookedMeat" expression=expr(CookedMeat)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.MealsCooked" expression=expr(MealsCooked)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.WaterVisits" expression=expr(WaterVisits)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.BerriesEaten" expression=expr(BerriesEaten)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.MeatEaten" expression=expr(MeatEaten)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.MetalOre" expression=expr(MetalOre)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Mine.TitaniumOre" expression=expr(TitaniumOre)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Mine.CobaltOre" expression=expr(CobaltOre)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Mine.GoldOre" expression=expr(GoldOre)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Mine.Amethyst" expression=expr(Amethyst)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Mine.AzureCrystal" expression=expr(AzureCrystal)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Mine.Version" expression=1
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.MetalIngot" expression=expr(MetalIngot)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.GatherMetal" expression=expr(GatherMetal)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.SmeltedMetal" expression=expr(SmeltedMetal)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.MetalTools" expression=expr(MetalTools)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.ForgeBuilt" expression=expr(ForgeBuilt)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.ForgeTime" expression=expr(ForgeTime)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.ForgeBusy" expression=expr(ForgeBusy)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.Canteen" expression=expr(Canteen)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.CanteenCharges" expression=expr(CanteenCharges)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.CompanionTamed" expression=expr(CompanionTamed)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.BaseMetal" expression=expr(BaseMetal)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.BaseMeals" expression=expr(BaseMeals)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.BaseKills" expression=expr(BaseKills)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.Kills" expression=expr(Kills)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.Health" expression=expr(Health)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.PlayerX" expression=expr(Player3D.X()+Riding*240)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.PlayerY" expression=expr(Player3D.Y())
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.PlayerZ" expression=expr(PlayerFloor)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.Dino.X" expression=expr(Dinosaur3D.X())
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.Dino.Y" expression=expr(Dinosaur3D.Y())
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.Dino.Angle" expression=expr(Dinosaur3D.Angle())

@event aiGeneratedEventId="pterosaur-save-safe-landing"
if NumberVariable variable="SaveRequested" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=2
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.PlayerX" expression=expr(Pterosaur3D.X()+260)
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.PlayerY" expression=expr(Pterosaur3D.Y())
do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.PlayerZ" expression=expr(TerrainFloor)

@event
if NumberVariable variable="SaveRequested" comparison_sign="=" value=1
> @event
> for each "SurvivalFires"
>> @event
>> if NumberVariable variable="SaveRequested" comparison_sign="=" value=1
>> do EcrireFichierExp storage_name=expr(SaveStorage) group=expr("Survival.Fire."+ToString(SurvivalFires.Variable(Slot))+".Fuel") expression=expr(SurvivalFires.Variable(Fuel))
>> do EcrireFichierExp storage_name=expr(SaveStorage) group=expr("Survival.Fire."+ToString(SurvivalFires.Variable(Slot))+".CookTime") expression=expr(SurvivalFires.Variable(CookTime))
>> do EcrireFichierExp storage_name=expr(SaveStorage) group=expr("Survival.Fire."+ToString(SurvivalFires.Variable(Slot))+".Cooking") expression=expr(SurvivalFires.Variable(Cooking))

@event
if NumberVariable variable="SaveRequested" comparison_sign="=" value=1
> @event
> for each "MetalDeposit"
>> @event
>> if NumberVariable variable="SaveRequested" comparison_sign="=" value=1
>> do EcrireFichierExp storage_name=expr(SaveStorage) group=expr("Survival.Ore."+ToString(MetalDeposit.Variable(SiteId))+".Cooldown") expression=expr(MetalDeposit.Variable(Cooldown))

@event
if NumberVariable variable="SaveRequested" comparison_sign="=" value=1
> for each HillMineVein
>> if NumberVariable variable="SaveRequested" comparison_sign="=" value=1
>> do EcrireFichierExp storage_name=expr(SaveStorage) group=expr("Mine.Vein."+ToString(HillMineVein.Variable(SiteId))+".Cooldown") expression=expr(HillMineVein.Variable(Cooldown))

@event
if NumberVariable variable="SaveRequested" comparison_sign="=" value=1
> for each HillMineCrystal
>> if NumberVariable variable="SaveRequested" comparison_sign="=" value=1
>> do EcrireFichierExp storage_name=expr(SaveStorage) group=expr("Mine.Crystal."+ToString(HillMineCrystal.Variable(SiteId))+".Cooldown") expression=expr(HillMineCrystal.Variable(Cooldown))

@event
if NumberVariable variable="SaveRequested" comparison_sign="=" value=1
> @event
> for each "Triceratops"
>> @event
>> if NumberVariable variable="SaveRequested" comparison_sign="=" value=1
>> do EcrireFichierExp storage_name=expr(SaveStorage) group=expr("Survival.Trike"+".Bond") expression=expr(Triceratops.Variable(Bond))
>> do EcrireFichierExp storage_name=expr(SaveStorage) group=expr("Survival.Trike"+".FeedWait") expression=expr(Triceratops.Variable(FeedWait))
>> do EcrireFichierExp storage_name=expr(SaveStorage) group=expr("Survival.Trike"+".Command") expression=expr(Triceratops.Variable(Command))
>> do EcrireFichierExp storage_name=expr(SaveStorage) group=expr("Survival.Trike"+".HP") expression=expr(Triceratops.Variable(HP))

>> @event
>> if NumberVariable variable="SaveRequested" comparison_sign="=" value=1
>> do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.Trike.X" expression=expr(Triceratops.X())
>> do EcrireFichierExp storage_name=expr(SaveStorage) group="Survival.Trike.Y" expression=expr(Triceratops.Y())
