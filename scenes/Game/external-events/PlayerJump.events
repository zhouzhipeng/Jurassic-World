@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
do SetNumberVariable variable="JumpStartTime" modification_sign="=" value=expr(max(0,JumpStartTime-TimeDelta()))
do SetNumberVariable variable="JumpLandTime" modification_sign="=" value=expr(max(0,JumpLandTime-TimeDelta()))

@comment "Grounded jumps: one press, gravity, landing on the current support." background=[90,150,180] text=[255,255,255]

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=0
if NumberVariable variable="SwimMode" comparison_sign="=" value=0
if NumberVariable variable="JumpVelocity" comparison_sign="=" value=0
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(PlayerFloor-FloorTarget)) comparison_sign="<=" second_expression=1
if KeyFromTextJustPressed key_to_check="Space"
or NumberVariable variable="TouchCommand" comparison_sign="=" value=90
do SetNumberVariable variable="JumpVelocity" modification_sign="=" value=680
do SetNumberVariable variable="JumpStartTime" modification_sign="=" value=0.2
do SetNumberVariable variable="JumpLandTime" modification_sign="=" value=0

@comment "Keep grounded feet on a gently descending surface; larger drops still use gravity." background=[90,150,180] text=[255,255,255]

@event aiGeneratedEventId="follow-gentle-ground-descent"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=0
if NumberVariable variable="SwimMode" comparison_sign="=" value=0
if NumberVariable variable="JumpVelocity" comparison_sign="=" value=0
if NumberVariable variable="PlayerFloor" comparison_sign=">" value=expr(FloorTarget)
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(PlayerFloor-FloorTarget) comparison_sign="<=" second_expression=8
do SetNumberVariable variable="PlayerFloor" modification_sign="=" value=expr(FloorTarget)

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=0
if NumberVariable variable="SwimMode" comparison_sign="=" value=0
do SetNumberVariable variable="JumpPreviousZ" modification_sign="=" value=expr(PlayerFloor)
do SetNumberVariable variable="PlayerFloor" modification_sign="=" value=expr(max(FloorTarget,PlayerFloor+JumpVelocity*TimeDelta()-750*TimeDelta()*TimeDelta()))
do SetNumberVariable variable="JumpVelocity" modification_sign="-" value=expr(1500*TimeDelta())

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=0
if NumberVariable variable="SwimMode" comparison_sign="=" value=0
if NumberVariable variable="JumpVelocity" comparison_sign="<" value=-80
if NumberVariable variable="JumpPreviousZ" comparison_sign=">" value=expr(FloorTarget+0.5)
if NumberVariable variable="PlayerFloor" comparison_sign="<=" value=expr(FloorTarget)
do SetNumberVariable variable="JumpLandTime" modification_sign="=" value=0.3
do SetNumberVariable variable="JumpStartTime" modification_sign="=" value=0

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=0
if NumberVariable variable="SwimMode" comparison_sign="=" value=0
if NumberVariable variable="JumpVelocity" comparison_sign="<=" value=0
if NumberVariable variable="PlayerFloor" comparison_sign="<=" value=expr(FloorTarget)
do SetNumberVariable variable="JumpVelocity" modification_sign="=" value=0

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=0
do Scene3D::Base3DBehavior::SetZ parameter_3d_object="Player3D" behavior="Object3D" modification_sign="=" value=expr(PlayerFloor)

@event
if NumberVariable variable="Riding" comparison_sign="=" value=1
or NumberVariable variable="Dead" comparison_sign="=" value=1
do SetNumberVariable variable="JumpVelocity" modification_sign="=" value=0
do SetNumberVariable variable="JumpStartTime" modification_sign="=" value=0
do SetNumberVariable variable="JumpLandTime" modification_sign="=" value=0
