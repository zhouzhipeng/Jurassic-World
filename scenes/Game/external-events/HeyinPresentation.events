@event
if NumberVariable variable="HeyinStage" comparison_sign="=" value=0
do SetStringVariable variable="HeyinObjective" modification_sign="=" value="林缘求助 · 前往营地东南的林缘"
do SetNumberVariable variable="HeyinTargetX" modification_sign="=" value=expr(Heyin.X())
do SetNumberVariable variable="HeyinTargetY" modification_sign="=" value=expr(Heyin.Y())

@event
if NumberVariable variable="HeyinStage" comparison_sign="=" value=1
do SetStringVariable variable="HeyinObjective" modification_sign="=" value="救助禾音 · 4 纤维 + 3 浆果 · 靠近按 G"
do SetNumberVariable variable="HeyinTargetX" modification_sign="=" value=expr(Heyin.X())
do SetNumberVariable variable="HeyinTargetY" modification_sign="=" value=expr(Heyin.Y())

@event
if NumberVariable variable="HeyinStage" comparison_sign="=" value=2
do SetStringVariable variable="HeyinObjective" modification_sign="=" value="护送禾音 · 返回西侧营地（篝火旁）"
do SetNumberVariable variable="HeyinTargetX" modification_sign="=" value=expr(-650)
do SetNumberVariable variable="HeyinTargetY" modification_sign="=" value=expr(350)

@event
if NumberVariable variable="HeyinStage" comparison_sign="=" value=3
do SetStringVariable variable="HeyinObjective" modification_sign="=" value="寻亲线索 · 带禾音前往东侧清泉，按 G 辨认"
do SetNumberVariable variable="HeyinTargetX" modification_sign="=" value=expr(1580)
do SetNumberVariable variable="HeyinTargetY" modification_sign="=" value=expr(680)

@event
if NumberVariable variable="HeyinStage" comparison_sign="=" value=4
do SetStringVariable variable="HeyinObjective" modification_sign="=" value="循着归家的结 · 已找到母亲的线索"
do SetNumberVariable variable="HeyinTargetX" modification_sign="=" value=expr(Heyin.X())
do SetNumberVariable variable="HeyinTargetY" modification_sign="=" value=expr(Heyin.Y())

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="TouchMode" comparison_sign="=" value=0
do Show object="HeyinStory"
do TextObject::SetWrapping object="HeyinStory" wrapping=true
do SetX object="HeyinStory" modification_sign="=" value=24
do SetY object="HeyinStory" modification_sign="=" value=expr(min(SceneWindowHeight()*0.28,210))
do TextObject::WrappingWidth object="HeyinStory" modification_sign="=" value=expr(min(620,SceneWindowWidth()-48))
do TextObject::Text::SetFontSize object="HeyinStory" modification_sign="=" value=expr(clamp(SceneWindowWidth()/65,16,22))
do TextContainerCapability::TextContainerBehavior::SetValue object="HeyinStory" behavior="Text" modification_sign="=" text=expr(HeyinObjective+NewLine()+"目标 "+ToString(round(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),HeyinTargetX,HeyinTargetY)/100))+" 米 · 禾音 "+ToString(round(HeyinDistance/100))+" 米")

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(SceneWindowWidth()) comparison_sign=">" second_expression=expr(SceneWindowHeight()*1.3)
do SetX object="HeyinStory" modification_sign="=" value=expr(SceneWindowWidth()*0.44)
do SetY object="HeyinStory" modification_sign="=" value=70
do TextObject::WrappingWidth object="HeyinStory" modification_sign="=" value=expr(SceneWindowWidth()*0.28)

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(SceneWindowWidth()) comparison_sign="<=" second_expression=expr(SceneWindowHeight()*1.3)
do SetX object="HeyinStory" modification_sign="=" value=expr(TouchHint.X())
do SetY object="HeyinStory" modification_sign="=" value=expr(TouchHint.Y()+TouchHint.Height()+12)
do TextObject::WrappingWidth object="HeyinStory" modification_sign="=" value=expr(SceneWindowWidth()-2*TouchMargin)

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="HeyinStage" comparison_sign=">=" value=2
do TextContainerCapability::TextContainerBehavior::SetValue object="HeyinStory" behavior="Text" modification_sign="+" text=expr(NewLine()+"体力 "+ToString(round(Heyin.Variable(Energy)))+" · 靠近按 G / 交谈切换等候")

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Heyin.Variable(Stay)) comparison_sign="=" second_expression=1
do TextContainerCapability::TextContainerBehavior::SetValue object="HeyinStory" behavior="Text" modification_sign="+" text=expr(NewLine()+"禾音在原地等候。靠近交谈后继续同行。")

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Heyin.Variable(Resting)) comparison_sign="=" second_expression=1
do TextContainerCapability::TextContainerBehavior::SetValue object="HeyinStory" behavior="Text" modification_sign="+" text=expr(NewLine()+"禾音：让我休息一会儿，我会自己跟上。")

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="HeyinDanger" comparison_sign="=" value=1
do TextContainerCapability::TextContainerBehavior::SetValue object="HeyinStory" behavior="Text" modification_sign="+" text=expr(NewLine()+"附近有捕食者：先确保安全。")

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberObjectVariable object="Heyin" variable="Blocked" comparison_sign="=" value=1
if NumberVariable variable="HeyinStage" comparison_sign=">=" value=2
do TextContainerCapability::TextContainerBehavior::SetValue object="HeyinStory" behavior="Text" modification_sign="+" text=expr(NewLine()+"前方被建筑挡住：请绕到开阔处带路。")

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="HeyinDistance" comparison_sign=">=" value=1800
if NumberVariable variable="HeyinStage" comparison_sign=">=" value=2
do TextContainerCapability::TextContainerBehavior::SetValue object="HeyinStory" behavior="Text" modification_sign="+" text=expr(NewLine()+"禾音掉队了：请按距离提示返回接她。")

@event
if NumberVariable variable="Mode" comparison_sign="!=" value=0
or NumberVariable variable="RenderMode" comparison_sign="!=" value=1
or NumberVariable variable="Dead" comparison_sign="!=" value=0
do Hide object="HeyinStory"


@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(SceneWindowWidth()) comparison_sign="<=" second_expression=900
do SetX object="HeyinStory" modification_sign="=" value=24
do SetY object="HeyinStory" modification_sign="=" value=expr(max(140,TouchHint.Y()+TouchHint.Height()+8))
do TextObject::WrappingWidth object="HeyinStory" modification_sign="=" value=expr(max(180,min(360,SceneWindowWidth()-298-TouchMode*(110*TouchScale+14))))
do TextObject::Text::SetFontSize object="HeyinStory" modification_sign="=" value=14
