@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="TouchContext" comparison_sign="=" value=3
if PickNearest object="SurvivalFires" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
do SetStringVariable variable="TouchContextHint" modification_sign="=" value=expr("篝火燃料 "+ToString(ceil(SurvivalFires.Variable(Fuel)))+" 秒 · 生肉 "+ToString(Meat)+" 份")
> @event
> if NumberObjectVariable object="SurvivalFires" variable="Cooking" comparison_sign="=" value=1
> do SetStringVariable variable="TouchContextLabel" modification_sign="=" value="烹饪中"
> do SetStringVariable variable="TouchContextHint" modification_sign="=" value=expr("烤肉剩余 "+ToString(ceil(SurvivalFires.Variable(CookTime)))+" 秒 · 燃料 "+ToString(ceil(SurvivalFires.Variable(Fuel)))+" 秒")

