@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
do SetNumberVariable variable="TouchContext" modification_sign="=" value=0
do SetNumberVariable variable="TouchContextDistance" modification_sign="=" value=99999
do SetStringVariable variable="TouchContextLabel" modification_sign="=" value="互动"
do SetStringVariable variable="TouchContextHint" modification_sign="=" value="靠近资源、恐龙或营地设施即可互动"

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=0
> @event
> for each "HarvestNodes"
>> @event
>> if NumberObjectVariable object="HarvestNodes" variable="Cooldown" comparison_sign="<=" value=0
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),HarvestNodes.X(),HarvestNodes.Y())) comparison_sign="<" second_expression=260
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),HarvestNodes.X(),HarvestNodes.Y())) comparison_sign="<" second_expression=expr(TouchContextDistance)
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(HarvestNodes.Z()-PlayerFloor)) comparison_sign="<" second_expression=180
>> do SetNumberVariable variable="TouchContext" modification_sign="=" value=1
>> do SetNumberVariable variable="TouchContextDistance" modification_sign="=" value=expr(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),HarvestNodes.X(),HarvestNodes.Y()))
>> do SetStringVariable variable="TouchContextLabel" modification_sign="=" value="采集"
>> do SetStringVariable variable="TouchContextHint" modification_sign="=" value="点一下完成一轮采集；移动即可取消"

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=0
> @event
> for each "SpringWater"
>> @event
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),SpringWater.X(),SpringWater.Y())) comparison_sign="<" second_expression=265
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),SpringWater.X(),SpringWater.Y())) comparison_sign="<" second_expression=expr(TouchContextDistance)
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(SpringWater.Z()-PlayerFloor)) comparison_sign="<" second_expression=180
>> do SetNumberVariable variable="TouchContext" modification_sign="=" value=2
>> do SetNumberVariable variable="TouchContextDistance" modification_sign="=" value=expr(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),SpringWater.X(),SpringWater.Y()))
>> do SetStringVariable variable="TouchContextLabel" modification_sign="=" value="饮水"
>> do SetStringVariable variable="TouchContextHint" modification_sign="=" value="恢复水分，并自动装满已制作的水袋"

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=0
> @event
> for each "SurvivalFires"
>> @event
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),SurvivalFires.X(),SurvivalFires.Y())) comparison_sign="<" second_expression=255
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),SurvivalFires.X(),SurvivalFires.Y())) comparison_sign="<" second_expression=expr(TouchContextDistance)
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(SurvivalFires.Variable(BaseZ)-PlayerFloor)) comparison_sign="<" second_expression=180
>> do SetNumberVariable variable="TouchContext" modification_sign="=" value=3
>> do SetNumberVariable variable="TouchContextDistance" modification_sign="=" value=expr(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),SurvivalFires.X(),SurvivalFires.Y()))
>> do SetStringVariable variable="TouchContextLabel" modification_sign="=" value="烤肉"
>> do SetStringVariable variable="TouchContextHint" modification_sign="=" value="自动添柴并烤一份肉；没有生肉时可添柴取暖"

