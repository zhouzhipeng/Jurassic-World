@comment "Resolve visibility after all movement, riding, floor and construction updates. Keep the requested orbit separate from collision response." background=[74,176,228] text=[0,0,0]

@event aiGeneratedEventId="camera-bounds-dinosaur3d"
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
> for each Dinosaur3D
>> do SetNumberObjectVariable object="Dinosaur3D" variable="CameraBoundsZ" modification_sign="=" value=expr(Dinosaur3D.Object3D::Z())
>> do SetNumberObjectVariable object="Dinosaur3D" variable="CameraBoundsDepth" modification_sign="=" value=expr(Dinosaur3D.Object3D::Depth())

