@comment "Construction preview context adapter; extension owns snapping and validation." background=[90,150,120] text=[255,255,255]

@event
if NumberVariable variable="Mode" comparison_sign=">=" value=0
do SetNumberVariable variable="BuildMessageTime" modification_sign="=" value=expr(max(0,BuildMessageTime-TimeDelta()))

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
if KeyFromTextReleased key_to_check="r"
do EmitSceneSignal signal_name="Construction.Input" payload="Rotate"

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
if KeyFromTextReleased key_to_check="PageUp"
do EmitSceneSignal signal_name="Construction.Input" payload="LevelUp"

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
if KeyFromTextReleased key_to_check="PageDown"
do EmitSceneSignal signal_name="Construction.Input" payload="LevelDown"

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
do SetNumberVariable variable="ConstructionContext.PlayerX" modification_sign="=" value=expr(Player3D.X())
do SetNumberVariable variable="ConstructionContext.PlayerY" modification_sign="=" value=expr(Player3D.Y())
do SetNumberVariable variable="ConstructionContext.PlayerFloor" modification_sign="=" value=expr(PlayerFloor)
do SetNumberVariable variable="ConstructionContext.CameraYaw" modification_sign="=" value=expr(CameraYaw)
do SetNumberVariable variable="ConstructionContext.Wood" modification_sign="=" value=expr(Wood)
do SetNumberVariable variable="ConstructionContext.Stone" modification_sign="=" value=expr(Stone)
do SetNumberVariable variable="ConstructionContext.Fiber" modification_sign="=" value=expr(Fiber)
do SetNumberVariable variable="ConstructionContext.DinoX" modification_sign="=" value=expr(Dinosaur3D.X())
do SetNumberVariable variable="ConstructionContext.DinoY" modification_sign="=" value=expr(Dinosaur3D.Y())
do ClearVariableChildren structure_or_array_variable="ConstructionContext.Harvest"
do ClearVariableChildren structure_or_array_variable="ConstructionContext.Wildlife"
do SetNumberVariable variable="ConstructionContext.HarvestCount" modification_sign="=" value=0
do SetNumberVariable variable="ConstructionContext.WildlifeCount" modification_sign="=" value=0

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
> @event
> for each "HarvestNodes"
>> @event
>> do SetNumberVariable variable="ConstructionContext.Harvest[ConstructionContext.HarvestCount].X" modification_sign="=" value=expr(HarvestNodes.X())
>> do SetNumberVariable variable="ConstructionContext.Harvest[ConstructionContext.HarvestCount].Y" modification_sign="=" value=expr(HarvestNodes.Y())
>> do SetNumberVariable variable="ConstructionContext.Harvest[ConstructionContext.HarvestCount].Cooldown" modification_sign="=" value=expr(HarvestNodes.Variable(Cooldown))
>> do SetNumberVariable variable="ConstructionContext.HarvestCount" modification_sign="+" value=1

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
> @event
> for each "Wildlife"
>> @event
>> do SetNumberVariable variable="ConstructionContext.Wildlife[ConstructionContext.WildlifeCount].X" modification_sign="=" value=expr(Wildlife.X())
>> do SetNumberVariable variable="ConstructionContext.Wildlife[ConstructionContext.WildlifeCount].Y" modification_sign="=" value=expr(Wildlife.Y())
>> do SetNumberVariable variable="ConstructionContext.Wildlife[ConstructionContext.WildlifeCount].Angle" modification_sign="=" value=expr(Wildlife.Angle())
>> do SetNumberVariable variable="ConstructionContext.Wildlife[ConstructionContext.WildlifeCount].HP" modification_sign="=" value=expr(Wildlife.Variable(HP))
>> do SetNumberVariable variable="ConstructionContext.Wildlife[ConstructionContext.WildlifeCount].Radius" modification_sign="=" value=expr(Wildlife.Variable(Radius))
>> do SetNumberVariable variable="ConstructionContext.Wildlife[ConstructionContext.WildlifeCount].HalfLength" modification_sign="=" value=expr(Wildlife.Variable(HalfLength))
>> do SetNumberVariable variable="ConstructionContext.WildlifeCount" modification_sign="+" value=1

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
do EmitSceneSignal signal_name="Construction.Preview" payload=expr(ToJSON(ConstructionContext))
