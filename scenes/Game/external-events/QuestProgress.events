> do SetNumberVariable variable="QuestStage" modification_sign="=" value=11

@event
if NumberVariable variable="QuestClaim" comparison_sign="=" value=1
do SetNumberVariable variable="QuestClaim" modification_sign="=" value=0
do TextContainerCapability::TextContainerBehavior::SetValue object="ClaimQuestLabel" behavior="Text" modification_sign="=" text="先完成当前目标"
