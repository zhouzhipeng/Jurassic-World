@comment "Apply persisted fire queues, ore cooldowns, companion state and player position" background=[90,150,120] text=[255,255,255]

@event aiGeneratedEventId="pterosaur-restore-location"
if NumberVariable variable="SurvivalLoadPending" comparison_sign="=" value=1
if GroupExists storage_name=expr(SaveStorage) group="Pterosaur.X"
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="Pterosaur.X" variable="LoadFuel"
do SetX object="Pterosaur3D" modification_sign="=" value=expr(LoadFuel)
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="Pterosaur.Y" variable="LoadFuel"
do SetY object="Pterosaur3D" modification_sign="=" value=expr(LoadFuel)
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="Pterosaur.Z" variable="LoadFuel"
do Scene3D::Base3DBehavior::SetZ parameter_3d_object="Pterosaur3D" behavior="Object3D" modification_sign="=" value=expr(LoadFuel)
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="Pterosaur.Angle" variable="LoadFuel"
do SetAngle object="Pterosaur3D" modification_sign="=" angle_in_degrees=expr(LoadFuel)

@event
if NumberVariable variable="SurvivalLoadPending" comparison_sign="=" value=1
if GroupExists storage_name=expr(SaveStorage) group="Survival.Dino.X"
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="Survival.Dino.X" variable="LoadFuel"
do SetX object="Dinosaur3D" modification_sign="=" value=expr(LoadFuel)
do SetNumberVariable variable="DinoPreviousX" modification_sign="=" value=expr(LoadFuel)
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="Survival.Dino.Y" variable="LoadFuel"
do SetY object="Dinosaur3D" modification_sign="=" value=expr(LoadFuel)
do SetNumberVariable variable="DinoPreviousY" modification_sign="=" value=expr(LoadFuel)
do ReadNumberFromStorage storage_name=expr(SaveStorage) group="Survival.Dino.Angle" variable="LoadFuel"
do SetAngle object="Dinosaur3D" modification_sign="=" angle_in_degrees=expr(LoadFuel)

@event
if NumberVariable variable="SurvivalLoadPending" comparison_sign="=" value=1
if GroupExists storage_name=expr(SaveStorage) group="SurvivalVersion"
do SetX object="Player3D" modification_sign="=" value=expr(SavedPlayerX)
do SetY object="Player3D" modification_sign="=" value=expr(SavedPlayerY)
do SetNumberVariable variable="PreviousX" modification_sign="=" value=expr(SavedPlayerX)
do SetNumberVariable variable="PreviousY" modification_sign="=" value=expr(SavedPlayerY)
do SetNumberVariable variable="PlayerFloor" modification_sign="=" value=expr(SavedPlayerZ)
do Scene3D::Base3DBehavior::SetZ parameter_3d_object="Player3D" behavior="Object3D" modification_sign="=" value=expr(SavedPlayerZ)

@event
if NumberVariable variable="SurvivalLoadPending" comparison_sign="=" value=1
if GroupExists storage_name=expr(SaveStorage) group="SurvivalVersion"
> @event
> for each "SurvivalFires"
>> @event
>> if NumberVariable variable="SurvivalLoadPending" comparison_sign="=" value=1
>> do ReadNumberFromStorage storage_name=expr(SaveStorage) group=expr("Survival.Fire."+ToString(SurvivalFires.Variable(Slot))+".Fuel") variable="LoadFuel"
>> do SetNumberObjectVariable object="SurvivalFires" variable="Fuel" modification_sign="=" value=expr(LoadFuel)
>> do ReadNumberFromStorage storage_name=expr(SaveStorage) group=expr("Survival.Fire."+ToString(SurvivalFires.Variable(Slot))+".CookTime") variable="LoadFuel"
>> do SetNumberObjectVariable object="SurvivalFires" variable="CookTime" modification_sign="=" value=expr(LoadFuel)
>> do ReadNumberFromStorage storage_name=expr(SaveStorage) group=expr("Survival.Fire."+ToString(SurvivalFires.Variable(Slot))+".Cooking") variable="LoadFuel"
>> do SetNumberObjectVariable object="SurvivalFires" variable="Cooking" modification_sign="=" value=expr(LoadFuel)

@event
if NumberVariable variable="SurvivalLoadPending" comparison_sign="=" value=1
if GroupExists storage_name=expr(SaveStorage) group="SurvivalVersion"
> @event
> for each "MetalDeposit"
>> @event
>> if NumberVariable variable="SurvivalLoadPending" comparison_sign="=" value=1
>> do ReadNumberFromStorage storage_name=expr(SaveStorage) group=expr("Survival.Ore."+ToString(MetalDeposit.Variable(SiteId))+".Cooldown") variable="LoadFuel"
>> do SetNumberObjectVariable object="MetalDeposit" variable="Cooldown" modification_sign="=" value=expr(LoadFuel)

@event
if NumberVariable variable="SurvivalLoadPending" comparison_sign="=" value=1
if GroupExists storage_name=expr(SaveStorage) group="Mine.Version"
> for each HillMineVein
>> if NumberVariable variable="SurvivalLoadPending" comparison_sign="=" value=1
>> do ReadNumberFromStorage storage_name=expr(SaveStorage) group=expr("Mine.Vein."+ToString(HillMineVein.Variable(SiteId))+".Cooldown") variable="LoadFuel"
>> do SetNumberObjectVariable object="HillMineVein" variable="Cooldown" modification_sign="=" value=expr(LoadFuel)

@event
if NumberVariable variable="SurvivalLoadPending" comparison_sign="=" value=1
if GroupExists storage_name=expr(SaveStorage) group="Mine.Version"
> for each HillMineCrystal
>> if NumberVariable variable="SurvivalLoadPending" comparison_sign="=" value=1
>> do ReadNumberFromStorage storage_name=expr(SaveStorage) group=expr("Mine.Crystal."+ToString(HillMineCrystal.Variable(SiteId))+".Cooldown") variable="LoadFuel"
>> do SetNumberObjectVariable object="HillMineCrystal" variable="Cooldown" modification_sign="=" value=expr(LoadFuel)

@event
if NumberVariable variable="SurvivalLoadPending" comparison_sign="=" value=1
if GroupExists storage_name=expr(SaveStorage) group="SurvivalVersion"
> @event
> for each "Triceratops"
>> @event
>> if NumberVariable variable="SurvivalLoadPending" comparison_sign="=" value=1
>> do ReadNumberFromStorage storage_name=expr(SaveStorage) group=expr("Survival.Trike"+".Bond") variable="LoadFuel"
>> do SetNumberObjectVariable object="Triceratops" variable="Bond" modification_sign="=" value=expr(LoadFuel)
>> do ReadNumberFromStorage storage_name=expr(SaveStorage) group=expr("Survival.Trike"+".FeedWait") variable="LoadFuel"
>> do SetNumberObjectVariable object="Triceratops" variable="FeedWait" modification_sign="=" value=expr(LoadFuel)
>> do ReadNumberFromStorage storage_name=expr(SaveStorage) group=expr("Survival.Trike"+".Command") variable="LoadFuel"
>> do SetNumberObjectVariable object="Triceratops" variable="Command" modification_sign="=" value=expr(LoadFuel)
>> do ReadNumberFromStorage storage_name=expr(SaveStorage) group=expr("Survival.Trike"+".HP") variable="LoadFuel"
>> do SetNumberObjectVariable object="Triceratops" variable="HP" modification_sign="=" value=expr(LoadFuel)
>> do ReadNumberFromStorage storage_name=expr(SaveStorage) group="Survival.Trike.X" variable="LoadFuel"
>> do SetX object="Triceratops" modification_sign="=" value=expr(LoadFuel)
>> do ReadNumberFromStorage storage_name=expr(SaveStorage) group="Survival.Trike.Y" variable="LoadFuel"
>> do SetY object="Triceratops" modification_sign="=" value=expr(LoadFuel)

@event
if NumberVariable variable="SurvivalLoadPending" comparison_sign="=" value=1
do SetNumberVariable variable="SurvivalLoadPending" modification_sign="=" value=0
do SetNumberObjectVariable object="SurvivalFires" variable="VisualReady" modification_sign="=" value=0
do Delete object="FireGlow"
do Delete object="FireEmber"
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
