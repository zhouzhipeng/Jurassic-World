>> do SetNumberObjectVariable object="PartPillar" variable="Open" modification_sign="=" value=expr(BuildingRecords[i].Open)
>> do SetNumberObjectVariable object="PartPillar" variable="BaseAngle" modification_sign="=" value=expr(BuildingRecords[i].Angle)
>> do SetNumberObjectVariable object="PartPillar" variable="WorldHX" modification_sign="=" value=expr(abs(cos(ToRad(BuildingRecords[i].Angle)))*20+abs(sin(ToRad(BuildingRecords[i].Angle)))*20)
>> do SetNumberObjectVariable object="PartPillar" variable="WorldHY" modification_sign="=" value=expr(abs(sin(ToRad(BuildingRecords[i].Angle)))*20+abs(cos(ToRad(BuildingRecords[i].Angle)))*20)
>> do SetNumberVariable variable="BuildCount" modification_sign="+" value=expr(1)

>> if NumberVariable variable="BuildingRecords[i].Kind" comparison_sign="=" value=expr(12)
>> do Create object_to_create="PartWall" x_position=expr(BuildingRecords[i].X) y_position=expr(BuildingRecords[i].Y) layer="World3D"
>> do SetAngle object="PartWall" modification_sign="=" angle_in_degrees=expr(BuildingRecords[i].Angle)
>> do Scene3D::Base3DBehavior::SetZ parameter_3d_object="PartWall" behavior="Object3D" modification_sign="=" value=expr(BuildingRecords[i].Z)
>> do SetNumberObjectVariable object="PartWall" variable="Slot" modification_sign="=" value=expr(i)
>> do SetNumberObjectVariable object="PartWall" variable="BaseZ" modification_sign="=" value=expr(BuildingRecords[i].Z)
>> do SetNumberObjectVariable object="PartWall" variable="Level" modification_sign="=" value=expr(BuildingRecords[i].Level)
>> do SetNumberObjectVariable object="PartWall" variable="Parent" modification_sign="=" value=expr(BuildingRecords[i].Parent)
>> do SetNumberObjectVariable object="PartWall" variable="Open" modification_sign="=" value=expr(BuildingRecords[i].Open)
>> do SetNumberObjectVariable object="PartWall" variable="BaseAngle" modification_sign="=" value=expr(BuildingRecords[i].Angle)
>> do SetNumberObjectVariable object="PartWall" variable="WorldHX" modification_sign="=" value=expr(abs(cos(ToRad(BuildingRecords[i].Angle)))*150+abs(sin(ToRad(BuildingRecords[i].Angle)))*14)
>> do SetNumberObjectVariable object="PartWall" variable="WorldHY" modification_sign="=" value=expr(abs(sin(ToRad(BuildingRecords[i].Angle)))*150+abs(cos(ToRad(BuildingRecords[i].Angle)))*14)
>> do SetNumberVariable variable="BuildCount" modification_sign="+" value=expr(1)

>> if NumberVariable variable="BuildingRecords[i].Kind" comparison_sign="=" value=expr(13)
>> do Create object_to_create="PartDoorframe" x_position=expr(BuildingRecords[i].X) y_position=expr(BuildingRecords[i].Y) layer="World3D"
>> do SetAngle object="PartDoorframe" modification_sign="=" angle_in_degrees=expr(BuildingRecords[i].Angle)
