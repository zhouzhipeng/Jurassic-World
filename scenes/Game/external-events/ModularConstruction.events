>> if NumberVariable variable="BuildingRecords[i].Kind" comparison_sign="=" value=expr(15)
>> do Create object_to_create="PartDoor" x_position=expr(BuildingRecords[i].X) y_position=expr(BuildingRecords[i].Y) layer="World3D"
>> do SetAngle object="PartDoor" modification_sign="=" angle_in_degrees=expr(BuildingRecords[i].Angle)
