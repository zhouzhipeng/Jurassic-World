>> @event
>> if NumberObjectVariable object="PartDoor" variable="Slot" comparison_sign=">=" value=0
>> do SetAngle object="PartDoor" modification_sign="=" angle_in_degrees=expr(PartDoor.Variable(BaseAngle)+PartDoor.Variable(Open)*90)
>> do SetNumberObjectVariable object="PartDoor" variable="WorldHX" modification_sign="=" value=expr(abs(cos(ToRad(PartDoor.Angle())))*78+abs(sin(ToRad(PartDoor.Angle())))*12)
>> do SetNumberObjectVariable object="PartDoor" variable="WorldHY" modification_sign="=" value=expr(abs(sin(ToRad(PartDoor.Angle())))*78+abs(cos(ToRad(PartDoor.Angle())))*12)
>> do SetX object="PartDoor" modification_sign="=" value=expr(BuildingRecords[PartDoor.Variable(Slot)].X+PartDoor.Variable(Open)*(-78*cos(ToRad(PartDoor.Variable(BaseAngle)))-78*sin(ToRad(PartDoor.Variable(BaseAngle)))))
>> do SetY object="PartDoor" modification_sign="=" value=expr(BuildingRecords[PartDoor.Variable(Slot)].Y+PartDoor.Variable(Open)*(-78*sin(ToRad(PartDoor.Variable(BaseAngle)))+78*cos(ToRad(PartDoor.Variable(BaseAngle)))))

