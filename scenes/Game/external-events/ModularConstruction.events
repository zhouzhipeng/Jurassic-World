>> do SetNumberObjectVariable object="PartDoorframe" variable="BaseAngle" modification_sign="=" value=expr(BuildingRecords[i].Angle)
>> do SetNumberObjectVariable object="PartDoorframe" variable="WorldHX" modification_sign="=" value=expr(abs(cos(ToRad(BuildingRecords[i].Angle)))*150+abs(sin(ToRad(BuildingRecords[i].Angle)))*14)
>> do SetNumberObjectVariable object="PartDoorframe" variable="WorldHY" modification_sign="=" value=expr(abs(sin(ToRad(BuildingRecords[i].Angle)))*150+abs(cos(ToRad(BuildingRecords[i].Angle)))*14)
>> do SetNumberVariable variable="BuildCount" modification_sign="+" value=expr(1)

>> if NumberVariable variable="BuildingRecords[i].Kind" comparison_sign="=" value=expr(14)
>> do Create object_to_create="PartCeiling" x_position=expr(BuildingRecords[i].X) y_position=expr(BuildingRecords[i].Y) layer="World3D"
>> do SetAngle object="PartCeiling" modification_sign="=" angle_in_degrees=expr(BuildingRecords[i].Angle)
>> do Scene3D::Base3DBehavior::SetZ parameter_3d_object="PartCeiling" behavior="Object3D" modification_sign="=" value=expr(BuildingRecords[i].Z)
>> do SetNumberObjectVariable object="PartCeiling" variable="Slot" modification_sign="=" value=expr(i)
