if NumberVariable variable="BuildRestore" comparison_sign="=" value=1
do Delete object="AllBuildings"
do JSONToVariableStructure2 json_string=expr(BuildJSON) variable_where_to_store_the_json_object="BuildingRecords"
do SetNumberVariable variable="BuildCount" modification_sign="=" value=0

> local i = 0
> repeat 128 index=i
>> if NumberVariable variable="BuildingRecords[i].Kind" comparison_sign="=" value=1
>> do Create object_to_create="BuiltShelter" x_position=expr(BuildingRecords[i].X) y_position=expr(BuildingRecords[i].Y) layer="World3D"
>> do SetAngle object="BuiltShelter" modification_sign="=" angle_in_degrees=expr(BuildingRecords[i].Angle)
>> do SetNumberObjectVariable object="BuiltShelter" variable="Slot" modification_sign="=" value=expr(i)
>> do SetNumberObjectVariable object="BuiltShelter" variable="WorldHX" modification_sign="=" value=expr(abs(cos(ToRad(BuildingRecords[i].Angle))) * BuiltShelter.Variable(HX) + abs(sin(ToRad(BuildingRecords[i].Angle))) * BuiltShelter.Variable(HY))
>> do SetNumberObjectVariable object="BuiltShelter" variable="WorldHY" modification_sign="=" value=expr(abs(sin(ToRad(BuildingRecords[i].Angle))) * BuiltShelter.Variable(HX) + abs(cos(ToRad(BuildingRecords[i].Angle))) * BuiltShelter.Variable(HY))
>> do SetNumberVariable variable="BuildCount" modification_sign="+" value=1

>> if NumberVariable variable="BuildingRecords[i].Kind" comparison_sign="=" value=2
>> do Create object_to_create="BuiltPalisade" x_position=expr(BuildingRecords[i].X) y_position=expr(BuildingRecords[i].Y) layer="World3D"
>> do SetAngle object="BuiltPalisade" modification_sign="=" angle_in_degrees=expr(BuildingRecords[i].Angle)
>> do SetNumberObjectVariable object="BuiltPalisade" variable="Slot" modification_sign="=" value=expr(i)
>> do SetNumberObjectVariable object="BuiltPalisade" variable="WorldHX" modification_sign="=" value=expr(abs(cos(ToRad(BuildingRecords[i].Angle))) * BuiltPalisade.Variable(HX) + abs(sin(ToRad(BuildingRecords[i].Angle))) * BuiltPalisade.Variable(HY))
>> do SetNumberObjectVariable object="BuiltPalisade" variable="WorldHY" modification_sign="=" value=expr(abs(sin(ToRad(BuildingRecords[i].Angle))) * BuiltPalisade.Variable(HX) + abs(cos(ToRad(BuildingRecords[i].Angle))) * BuiltPalisade.Variable(HY))
>> do SetNumberVariable variable="BuildCount" modification_sign="+" value=1

>> if NumberVariable variable="BuildingRecords[i].Kind" comparison_sign="=" value=3
>> do Create object_to_create="BuiltCampfire" x_position=expr(BuildingRecords[i].X) y_position=expr(BuildingRecords[i].Y) layer="World3D"
>> do SetAngle object="BuiltCampfire" modification_sign="=" angle_in_degrees=expr(BuildingRecords[i].Angle)
>> do SetNumberObjectVariable object="BuiltCampfire" variable="Slot" modification_sign="=" value=expr(i)
>> do SetNumberObjectVariable object="BuiltCampfire" variable="WorldHX" modification_sign="=" value=expr(abs(cos(ToRad(BuildingRecords[i].Angle))) * BuiltCampfire.Variable(HX) + abs(sin(ToRad(BuildingRecords[i].Angle))) * BuiltCampfire.Variable(HY))
>> do SetNumberObjectVariable object="BuiltCampfire" variable="WorldHY" modification_sign="=" value=expr(abs(sin(ToRad(BuildingRecords[i].Angle))) * BuiltCampfire.Variable(HX) + abs(cos(ToRad(BuildingRecords[i].Angle))) * BuiltCampfire.Variable(HY))
>> do SetNumberVariable variable="BuildCount" modification_sign="+" value=1


>> if NumberVariable variable="BuildingRecords[i].Kind" comparison_sign="=" value=expr(10)
>> do Create object_to_create="PartFoundation" x_position=expr(BuildingRecords[i].X) y_position=expr(BuildingRecords[i].Y) layer="World3D"
>> do SetAngle object="PartFoundation" modification_sign="=" angle_in_degrees=expr(BuildingRecords[i].Angle)
>> do Scene3D::Base3DBehavior::SetZ parameter_3d_object="PartFoundation" behavior="Object3D" modification_sign="=" value=expr(BuildingRecords[i].Z)
>> do SetNumberObjectVariable object="PartFoundation" variable="Slot" modification_sign="=" value=expr(i)
>> do SetNumberObjectVariable object="PartFoundation" variable="BaseZ" modification_sign="=" value=expr(BuildingRecords[i].Z)
>> do SetNumberObjectVariable object="PartFoundation" variable="Level" modification_sign="=" value=expr(BuildingRecords[i].Level)
>> do SetNumberObjectVariable object="PartFoundation" variable="Parent" modification_sign="=" value=expr(BuildingRecords[i].Parent)
>> do SetNumberObjectVariable object="PartFoundation" variable="Open" modification_sign="=" value=expr(BuildingRecords[i].Open)
>> do SetNumberObjectVariable object="PartFoundation" variable="BaseAngle" modification_sign="=" value=expr(BuildingRecords[i].Angle)
>> do SetNumberObjectVariable object="PartFoundation" variable="WorldHX" modification_sign="=" value=expr(abs(cos(ToRad(BuildingRecords[i].Angle)))*150+abs(sin(ToRad(BuildingRecords[i].Angle)))*150)
>> do SetNumberObjectVariable object="PartFoundation" variable="WorldHY" modification_sign="=" value=expr(abs(sin(ToRad(BuildingRecords[i].Angle)))*150+abs(cos(ToRad(BuildingRecords[i].Angle)))*150)
>> do SetNumberVariable variable="BuildCount" modification_sign="+" value=expr(1)

>> if NumberVariable variable="BuildingRecords[i].Kind" comparison_sign="=" value=expr(11)
>> do Create object_to_create="PartPillar" x_position=expr(BuildingRecords[i].X) y_position=expr(BuildingRecords[i].Y) layer="World3D"
>> do SetAngle object="PartPillar" modification_sign="=" angle_in_degrees=expr(BuildingRecords[i].Angle)
>> do Scene3D::Base3DBehavior::SetZ parameter_3d_object="PartPillar" behavior="Object3D" modification_sign="=" value=expr(BuildingRecords[i].Z)
>> do SetNumberObjectVariable object="PartPillar" variable="Slot" modification_sign="=" value=expr(i)
>> do SetNumberObjectVariable object="PartPillar" variable="BaseZ" modification_sign="=" value=expr(BuildingRecords[i].Z)
>> do SetNumberObjectVariable object="PartPillar" variable="Level" modification_sign="=" value=expr(BuildingRecords[i].Level)
