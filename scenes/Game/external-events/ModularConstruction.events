@event
if NumberVariable variable="BuildRestore" comparison_sign="=" value=1
do SetNumberVariable variable="BuildRestore" modification_sign="=" value=0

@event
link "HUDBuildSelection"

@event
if NumberVariable variable="Mode" comparison_sign=">=" value=0
do SetNumberVariable variable="BuildMessageTime" modification_sign="=" value=expr(max(0,BuildMessageTime-TimeDelta()))
do SetNumberVariable variable="BuildSuccess" modification_sign="=" value=0

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
if KeyFromTextReleased key_to_check="r"
do SetNumberVariable variable="BuildAngle" modification_sign="=" value=expr(mod(BuildAngle+90,360))

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
if KeyFromTextReleased key_to_check="PageUp"
do SetNumberVariable variable="BuildLevel" modification_sign="=" value=expr(min(2,BuildLevel+1))

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
if KeyFromTextReleased key_to_check="PageDown"
do SetNumberVariable variable="BuildLevel" modification_sign="=" value=expr(max(0,BuildLevel-1))

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
do SetNumberVariable variable="BuildRawX" modification_sign="=" value=expr(Player3D.X()-sin(ToRad(CameraYaw))*450)
do SetNumberVariable variable="BuildRawY" modification_sign="=" value=expr(Player3D.Y()-cos(ToRad(CameraYaw))*450)
do SetNumberVariable variable="BuildX" modification_sign="=" value=expr(round(BuildRawX/300)*300)
do SetNumberVariable variable="BuildY" modification_sign="=" value=expr(round(BuildRawY/300)*300)
do SetNumberVariable variable="BuildZ" modification_sign="=" value=expr(20+BuildLevel*300)
do SetNumberVariable variable="BuildParent" modification_sign="=" value=-1
do SetNumberVariable variable="BuildValid" modification_sign="=" value=1
do SetNumberVariable variable="BuildSlot" modification_sign="=" value=-1
do SetStringVariable variable="BuildReason" modification_sign="=" value="吸附就绪 · 点「放置」"

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
if NumberVariable variable="BuildKind" comparison_sign="=" value=10
do SetNumberVariable variable="BuildWood" modification_sign="=" value=6
do SetNumberVariable variable="BuildStone" modification_sign="=" value=2
do SetNumberVariable variable="BuildFiber" modification_sign="=" value=3
do SetNumberVariable variable="BuildHX" modification_sign="=" value=150
do SetNumberVariable variable="BuildHY" modification_sign="=" value=150

