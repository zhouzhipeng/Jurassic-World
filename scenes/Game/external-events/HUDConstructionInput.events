@comment "Construction input" background=[120,145,90] text=[255,255,255]

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if KeyFromTextReleased key_to_check="b"
do EmitSceneSignal signal_name="Construction.Input" payload="Toggle"

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="TouchMode" comparison_sign="=" value=0
if IsCursorOnObject object="BuildToggle" accurate_test_yes_by_default=false
if NumberVariable variable="TouchMode" comparison_sign="=" value=0
if MouseButtonFromTextReleased button_to_check="Left"
do EmitSceneSignal signal_name="Construction.Input" payload="Toggle"

@event
if NumberVariable variable="Mode" comparison_sign="!=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
do EmitSceneSignal signal_name="Construction.Input" payload="Disable"

@event
if NumberVariable variable="Riding" comparison_sign="=" value=1
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
do EmitSceneSignal signal_name="Construction.Input" payload="Disable"

@event
if NumberVariable variable="RenderMode" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
do EmitSceneSignal signal_name="Construction.Input" payload="Disable"
