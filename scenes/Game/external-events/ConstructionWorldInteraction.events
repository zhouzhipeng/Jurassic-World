do SetNumberVariable variable="FloorTarget" modification_sign="=" value=30.5


@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
> @event
> for each "ModularParts"
>> @event
>> if NumberObjectVariable object="ModularParts" variable="Kind" comparison_sign="=" value=10
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(Player3D.X()-ModularParts.X())) comparison_sign="<=" second_expression=150
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(Player3D.Y()-ModularParts.Y())) comparison_sign="<=" second_expression=150
>> if BuiltinCommonInstructions::CompareNumbers first_expression=20 comparison_sign="<=" second_expression=expr(PlayerFloor+30)
>> if BuiltinCommonInstructions::CompareNumbers first_expression=20 comparison_sign=">" second_expression=expr(FloorTarget)
>> do SetNumberVariable variable="FloorTarget" modification_sign="=" value=20

>> @event
>> if NumberObjectVariable object="ModularParts" variable="Kind" comparison_sign="=" value=14
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(Player3D.X()-ModularParts.X())) comparison_sign="<=" second_expression=150
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(Player3D.Y()-ModularParts.Y())) comparison_sign="<=" second_expression=150
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(ModularParts.Variable(BaseZ)) comparison_sign="<=" second_expression=expr(PlayerFloor+30)
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(ModularParts.Variable(BaseZ)) comparison_sign=">" second_expression=expr(FloorTarget)
>> do SetNumberVariable variable="FloorTarget" modification_sign="=" value=expr(ModularParts.Variable(BaseZ))

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
> @event
> for each "PartStairs"
>> @event
>> if NumberObjectVariable object="PartStairs" variable="Kind" comparison_sign="=" value=16
>> do SetNumberVariable variable="BuildLX" modification_sign="=" value=expr((Player3D.X()-PartStairs.X())*cos(ToRad(PartStairs.Angle()))+(Player3D.Y()-PartStairs.Y())*sin(ToRad(PartStairs.Angle())))
>> do SetNumberVariable variable="BuildLY" modification_sign="=" value=expr(-(Player3D.X()-PartStairs.X())*sin(ToRad(PartStairs.Angle()))+(Player3D.Y()-PartStairs.Y())*cos(ToRad(PartStairs.Angle())))
>> do SetNumberVariable variable="FloorCandidate" modification_sign="=" value=expr(PartStairs.Variable(BaseZ)+clamp(150-BuildLY,0,300))
>>> @event
>>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(BuildLX)) comparison_sign="<" second_expression=105
>>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(BuildLY)) comparison_sign="<=" second_expression=160
>>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(FloorCandidate-PlayerFloor)) comparison_sign="<" second_expression=40
>>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(FloorCandidate) comparison_sign=">" second_expression=expr(FloorTarget)
>>> do SetNumberVariable variable="FloorTarget" modification_sign="=" value=expr(FloorCandidate)

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
> for each JumpPlatform
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Player3D.X()) comparison_sign=">=" second_expression=expr(JumpPlatform.X()-24)
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Player3D.X()) comparison_sign="<=" second_expression=expr(JumpPlatform.X()+JumpPlatform.Width()+24)
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Player3D.Y()) comparison_sign=">=" second_expression=expr(JumpPlatform.Y()-24)
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Player3D.Y()) comparison_sign="<=" second_expression=expr(JumpPlatform.Y()+JumpPlatform.Height()+24)
>> if NumberVariable variable="PlayerFloor" comparison_sign="<" value=expr(JumpPlatform.Object3D::Z()+JumpPlatform.Object3D::Depth()-1)
>> do SetX object="Player3D" modification_sign="=" value=expr(PreviousX)
>> do SetY object="Player3D" modification_sign="=" value=expr(PreviousY)

