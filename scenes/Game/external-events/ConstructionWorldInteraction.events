>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Player3D.Y()) comparison_sign=">=" second_expression=expr(JumpPlatform.Y()-16)
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Player3D.Y()) comparison_sign="<=" second_expression=expr(JumpPlatform.Y()+JumpPlatform.Height()+16)
>> if NumberVariable variable="PlayerFloor" comparison_sign=">=" value=expr(JumpPlatform.Object3D::Z()+JumpPlatform.Object3D::Depth()-1)
>> if NumberVariable variable="FloorTarget" comparison_sign="<" value=expr(JumpPlatform.Object3D::Z()+JumpPlatform.Object3D::Depth())
>> do SetNumberVariable variable="FloorTarget" modification_sign="=" value=expr(JumpPlatform.Object3D::Z()+JumpPlatform.Object3D::Depth())

link "PlayerJump"

