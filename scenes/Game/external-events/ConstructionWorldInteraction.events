@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
do SetNumberVariable variable="DoorSlot" modification_sign="=" value=-1
do SetNumberVariable variable="DoorDistance" modification_sign="=" value=210

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=0
> @event
> for each "PartDoor"
>> @event
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(PartDoor.Variable(BaseZ)-PlayerFloor)) comparison_sign="<" second_expression=100
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),PartDoor.X(),PartDoor.Y())) comparison_sign="<" second_expression=expr(DoorDistance)
>> do SetNumberVariable variable="DoorDistance" modification_sign="=" value=expr(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),PartDoor.X(),PartDoor.Y()))
>> do SetNumberVariable variable="DoorSlot" modification_sign="=" value=expr(PartDoor.Variable(Slot))

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=0
if KeyFromTextReleased key_to_check="e"
or NumberVariable variable="TouchDoor" comparison_sign="=" value=1
if NumberVariable variable="DoorSlot" comparison_sign=">=" value=0
do EmitSceneSignal signal_name="Construction.ToggleDoor" payload=expr(ToString(DoorSlot))

