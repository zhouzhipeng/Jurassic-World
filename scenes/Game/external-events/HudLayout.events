@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
do SetNumberVariable variable="HudScale" modification_sign="=" value=expr(clamp(min(TouchWidth/1600,TouchHeight/900),0.4,1.6))
do SetNumberVariable variable="HudMargin" modification_sign="=" value=expr(32*HudScale)
do SetNumberVariable variable="HudContextX" modification_sign="=" value=expr((TouchWidth-560*HudScale)/2)
do SetNumberVariable variable="HudContextY" modification_sign="=" value=expr(TouchHeight-HudMargin-120*HudScale)

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
do SetNumberVariable variable="TouchJoyX" modification_sign="=" value=expr(HudMargin+130*HudScale)
do SetNumberVariable variable="TouchJoyY" modification_sign="=" value=expr(TouchHeight-HudMargin-130*HudScale)
do SetNumberVariable variable="TouchRadius" modification_sign="=" value=expr(86*HudScale)
do SetX object="TouchStick" modification_sign="=" value=expr(HudMargin+0*HudScale)
do SetY object="TouchStick" modification_sign="=" value=expr(TouchHeight-HudMargin-260*HudScale)
do ResizableCapability::ResizableBehavior::SetSize object="TouchStick" behavior="Resizable" width=expr(260*HudScale) height=expr(260*HudScale)
do ResizableCapability::ResizableBehavior::SetSize object="TouchKnob" behavior="Resizable" width=expr(82*HudScale) height=expr(82*HudScale)

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberObjectVariable object="TouchButton" variable="Slot" comparison_sign="=" value=1
do AnimatableCapability::AnimatableBehavior::SetName object="TouchButton" behavior="Animation" modification_sign="=" animation_name="Menu"
do SetX object="TouchButton" modification_sign="=" value=expr(TouchWidth-HudMargin-max(44,56*HudScale))
do SetY object="TouchButton" modification_sign="=" value=expr(HudMargin)
do ResizableCapability::ResizableBehavior::SetSize object="TouchButton" behavior="Resizable" width=expr(max(44,56*HudScale)) height=expr(max(44,56*HudScale))
do SetNumberObjectVariable object="TouchButton" variable="FontSize" modification_sign="=" value=expr(0*HudScale/TouchScale)
do SetStringObjectVariable object="TouchButton" variable="Label" modification_sign="=" value=""

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberObjectVariable object="TouchButton" variable="Slot" comparison_sign="=" value=2
do AnimatableCapability::AnimatableBehavior::SetName object="TouchButton" behavior="Animation" modification_sign="=" animation_name="Pack"
do SetX object="TouchButton" modification_sign="=" value=expr(TouchWidth-HudMargin-280*HudScale)
do SetY object="TouchButton" modification_sign="=" value=expr(HudMargin+250*HudScale)
do ResizableCapability::ResizableBehavior::SetSize object="TouchButton" behavior="Resizable" width=expr(84*HudScale) height=expr(84*HudScale)
do SetNumberObjectVariable object="TouchButton" variable="FontSize" modification_sign="=" value=expr(19*HudScale/TouchScale)

