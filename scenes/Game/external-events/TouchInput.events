@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
> @event
> for each "TouchButton"
>> @event
>> if NumberObjectVariable object="TouchButton" variable="TouchId" comparison_sign="!=" value=-999
>> if NumberVariable variable="Mode" comparison_sign="=" value=0
>> if NumberVariable variable="Dead" comparison_sign="=" value=0
>> if NumberObjectVariable object="TouchButton" variable="PressX" comparison_sign=">" value=expr(TouchWidth*0.42)
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(TouchX(TouchButton.Variable(TouchId),"Touch",0)-TouchButton.Variable(PressX))+abs(TouchY(TouchButton.Variable(TouchId),"Touch",0)-TouchButton.Variable(PressY))) comparison_sign=">" second_expression=expr(12*TouchScale)
>>> @event
>>> if NumberVariable variable="TouchLookId" comparison_sign="=" value=-999
>>> @instruction inverted=true
>>> if HasTouchEnded touch_identifier=expr(TouchButton.Variable(TouchId))
>>> do SetNumberVariable variable="TouchLookId" modification_sign="=" value=expr(TouchButton.Variable(TouchId))
>>> do SetNumberVariable variable="TouchLookX" modification_sign="=" value=expr(TouchButton.Variable(PressX))
>>> do SetNumberVariable variable="TouchLookY" modification_sign="=" value=expr(TouchButton.Variable(PressY))

>>> @event
>>> if NumberObjectVariable object="TouchButton" variable="TouchId" comparison_sign="!=" value=-999
>>> do SetNumberObjectVariable object="TouchButton" variable="TouchId" modification_sign="=" value=-999

>> @event
