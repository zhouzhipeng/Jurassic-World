or NumberVariable variable="TouchOldHeight" comparison_sign="!=" value=expr(TouchHeight)
do SetNumberVariable variable="TouchMoveId" modification_sign="=" value=-999
do SetNumberVariable variable="TouchLookId" modification_sign="=" value=-999
do SetNumberObjectVariable object="TouchButton" variable="TouchId" modification_sign="=" value=-999
