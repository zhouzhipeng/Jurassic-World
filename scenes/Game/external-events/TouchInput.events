>> do SetNumberVariable variable="TouchLookY" modification_sign="=" value=expr(TouchY(TouchId,"Touch",0))

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="TouchMoveId" comparison_sign="!=" value=-999
do SetNumberVariable variable="TouchDX" modification_sign="=" value=expr(TouchX(TouchMoveId,"Touch",0)-TouchJoyX)
do SetNumberVariable variable="TouchDY" modification_sign="=" value=expr(TouchY(TouchMoveId,"Touch",0)-TouchJoyY)
do SetNumberVariable variable="TouchLength" modification_sign="=" value=expr(sqrt(TouchDX*TouchDX+TouchDY*TouchDY))

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="TouchMoveId" comparison_sign="!=" value=-999
if NumberVariable variable="TouchLength" comparison_sign=">" value=expr(10*TouchScale)
do SetNumberVariable variable="TouchMoveX" modification_sign="=" value=expr(TouchDX/max(TouchRadius,TouchLength))
do SetNumberVariable variable="TouchMoveY" modification_sign="=" value=expr(TouchDY/max(TouchRadius,TouchLength))

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="TouchLookId" comparison_sign="!=" value=-999
do SetNumberVariable variable="CameraYaw" modification_sign="-" value=expr((TouchX(TouchLookId,"Touch",0)-TouchLookX)*0.22/TouchScale)
do SetNumberVariable variable="CameraPitch" modification_sign="=" value=expr(clamp(CameraPitch+(TouchY(TouchLookId,"Touch",0)-TouchLookY)*0.16/TouchScale,12,65))
do SetNumberVariable variable="TouchLookX" modification_sign="=" value=expr(TouchX(TouchLookId,"Touch",0))
do SetNumberVariable variable="TouchLookY" modification_sign="=" value=expr(TouchY(TouchLookId,"Touch",0))

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="BuildMode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberObjectVariable object="TouchButton" variable="Command" comparison_sign="=" value=7
if NumberObjectVariable object="TouchButton" variable="TouchId" comparison_sign="!=" value=-999
if TouchX touch_identifier=expr(TouchButton.Variable(TouchId)) comparison_sign=">=" value=expr(TouchButton.X()) layer="Touch" camera_number_default_0=0
if TouchX touch_identifier=expr(TouchButton.Variable(TouchId)) comparison_sign="<=" value=expr(TouchButton.X()+TouchButton.Width()) layer="Touch" camera_number_default_0=0
if TouchY touch_identifier=expr(TouchButton.Variable(TouchId)) comparison_sign=">=" value=expr(TouchButton.Y()) layer="Touch" camera_number_default_0=0
if TouchY touch_identifier=expr(TouchButton.Variable(TouchId)) comparison_sign="<=" value=expr(TouchButton.Y()+TouchButton.Height()) layer="Touch" camera_number_default_0=0
do SetNumberVariable variable="TouchAttack" modification_sign="=" value=1

@event
