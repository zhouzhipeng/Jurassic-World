>> if HasTouchEnded touch_identifier=expr(TouchButton.Variable(TouchId))
>> do SetNumberObjectVariable object="TouchButton" variable="TouchId" modification_sign="=" value=-999

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if HasAnyTouchOrMouseStarted
> @event
> local touchIndex = var(type="number",value=0,persistentUuid="",folded=false,hasMixedValues=false)
> repeat "StartedTouchOrMouseCount()" index="touchIndex"
>> @event
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(touchIndex) comparison_sign=">=" second_expression=0
>> do SetNumberVariable variable="TouchId" modification_sign="=" value=expr(StartedTouchOrMouseId(touchIndex))
>> do SetNumberVariable variable="TouchConsumed" modification_sign="=" value=0

