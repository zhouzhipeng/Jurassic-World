do SetStringVariable variable="QuestName" modification_sign="=" value=expr("亲手制作")
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("制作长矛 "+ToString(min(CraftedSpears,1))+" /1")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("打开「背包」，点「制作长矛」。需要 6 木材、2 石头、4 纤维。")
do SetStringVariable variable="QuestReward" modification_sign="=" value=expr("体力 +30")
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text=expr("目标 3 /12 · 建立海岛据点")

