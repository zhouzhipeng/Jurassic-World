do SetStringVariable variable="QuestName" modification_sign="=" value=expr("安全的营地")
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("地基 "+ToString(min(BuildFloorCount,1))+"/1 · 墙/门 "+ToString(min(BuildWallCount,3))+"/3 · 顶板 "+ToString(min(BuildRoofCount,1))+"/1")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("点「建造」选择部件，用摇杆调整位置，再点「放置」。旋转和楼层都有按钮。")
do SetStringVariable variable="QuestReward" modification_sign="=" value=expr("绳索 +2")
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text=expr("目标 5 /12 · 建立海岛据点")

@event
