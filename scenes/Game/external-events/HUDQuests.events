@event
if NumberVariable variable="Mode" comparison_sign=">=" value=0
do TextContainerCapability::TextContainerBehavior::SetValue object="QuestTitle" behavior="Text" modification_sign="=" text=expr(QuestName)
do TextContainerCapability::TextContainerBehavior::SetValue object="QuestBody" behavior="Text" modification_sign="=" text=expr(QuestProgress+NewLine()+"J 查看步骤与奖励")
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalTitle" behavior="Text" modification_sign="=" text=expr(QuestName)
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalProgress" behavior="Text" modification_sign="=" text=expr(QuestProgress)
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalInstruction" behavior="Text" modification_sign="=" text=expr(QuestInstruction)
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalReward" behavior="Text" modification_sign="=" text=expr("奖励："+QuestReward)
do TextContainerCapability::TextContainerBehavior::SetValue object="ClaimQuestLabel" behavior="Text" modification_sign="=" text="完成目标后领取"
do TextContainerCapability::TextContainerBehavior::SetValue object="Compass" behavior="Text" modification_sign="=" text="Q 切换导航 · J 任务"
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalHeading" behavior="Text" modification_sign="=" text=expr("生存手册 / 目标 "+ToString(QuestStage+1)+" /12")

@event
if NumberVariable variable="QuestTargetValid" comparison_sign="=" value=1
if NumberVariable variable="QuestReady" comparison_sign="=" value=0
do TextContainerCapability::TextContainerBehavior::SetValue object="Compass" behavior="Text" modification_sign="=" text=expr(QuestDirection+" · "+QuestTargetName+" "+ToString(round(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),QuestTargetX,QuestTargetY)/100))+"m")

@event
if NumberVariable variable="QuestReady" comparison_sign="=" value=1
do TextContainerCapability::TextContainerBehavior::SetValue object="QuestBody" behavior="Text" modification_sign="=" text=expr(QuestProgress+NewLine()+"已完成！J 领取奖励")
do TextContainerCapability::TextContainerBehavior::SetValue object="ClaimQuestLabel" behavior="Text" modification_sign="=" text="领取奖励，继续下一步"
do TextContainerCapability::TextContainerBehavior::SetValue object="Compass" behavior="Text" modification_sign="=" text="目标达成 · J 领取奖励"

