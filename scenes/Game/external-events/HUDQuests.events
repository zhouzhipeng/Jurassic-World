do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("副栉龙信任 "+ToString(min(Trust,100))+" /100")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("走近副栉龙，点「喂食」。信任达到 100 后按钮变为「骑乘」。")
do SetStringVariable variable="QuestReward" modification_sign="=" value=expr("兽皮 +2")
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text=expr("目标 4 /12 · 建立海岛据点")

