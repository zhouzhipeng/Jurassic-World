do SetStringVariable variable="QuestName" modification_sign="=" value=expr("危险矿区")
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("开采金属矿石 "+ToString(min(GatherMetal,6))+" /6")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("导航至北部矿区，带好长矛、烤肉和水袋。点一下开采矿石，移动可取消；警惕捕食者。")
do SetStringVariable variable="QuestReward" modification_sign="=" value=expr("木材 +6")
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text=expr("目标 8 /12 · 向危险区域远征")

