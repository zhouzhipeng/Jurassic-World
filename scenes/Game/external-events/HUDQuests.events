@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(5)
do SetStringVariable variable="QuestName" modification_sign="=" value=expr("出发前的补给")
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("清泉饮水 "+ToString(min(WaterVisits,1))+"/1 · 烤肉 "+ToString(min(MealsCooked,2))+"/2")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("菜单中导航至清泉或营地。清泉可饮水装水，篝火可自动添柴烤肉，工坊可制作水袋。")
do SetStringVariable variable="QuestReward" modification_sign="=" value=expr("兽皮 +2 / 木材 +4")
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text=expr("目标 6 /12 · 建立海岛据点")

