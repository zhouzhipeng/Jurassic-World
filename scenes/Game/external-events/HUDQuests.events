do SetStringVariable variable="QuestName" modification_sign="=" value=expr("点燃工业火种")
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("修复熔炉 "+ToString(ForgeBuilt)+"/1 · 熔炼金属锭 "+ToString(min(SmeltedMetal,3))+"/3")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("工坊先消耗 12 石头、8 木材修复熔炉。之后每 2 矿石、2 木材可在 10 秒内熔成 1 锭。")
do SetStringVariable variable="QuestReward" modification_sign="=" value=expr("兽皮 +2 / 木材 +4")
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text=expr("目标 9 /12 · 向危险区域远征")

