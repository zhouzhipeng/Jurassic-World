do SetStringVariable variable="QuestName" modification_sign="=" value=expr("荒野采集伙伴")
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("三角龙信任 "+ToString(min(Triceratops.Variable(Bond),100))+" /100")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("导航至三角龙，走近点「喂食」：3 浆果一次，间隔 4 秒。驯服后点「伙伴」选择跟随，附近植物采集翻倍。")
do SetStringVariable variable="QuestReward" modification_sign="=" value=expr("木材 +8")
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text=expr("目标 7 /12 · 向危险区域远征")

