@event
if NumberVariable variable="QuestToastTime" comparison_sign=">" value=0
do SetNumberVariable variable="QuestToastTime" modification_sign="-" value=expr(TimeDelta())
do Show object="QuestToastPanel"
do Show object="QuestToast"

@event
if NumberVariable variable="QuestToastTime" comparison_sign="<=" value=0
do Hide object="QuestToastPanel"
do Hide object="QuestToast"

@event
if NumberVariable variable="QuestReady" comparison_sign="=" value=0
do OpacityCapability::OpacityBehavior::SetValue object="ClaimQuest" behavior="Opacity" modification_sign="=" opacity_0_255=130

@event
if NumberVariable variable="QuestReady" comparison_sign="=" value=1
do OpacityCapability::OpacityBehavior::SetValue object="ClaimQuest" behavior="Opacity" modification_sign="=" opacity_0_255=255
