@event
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
do SetCameraCenterX modification_sign="=" value=expr(Player3D.X() + sin(ToRad(CameraYaw)) * cos(ToRad(CameraPitch)) * CameraDistance) layer="World3D" camera_number_default_0=0
do SetCameraCenterY modification_sign="=" value=expr(Player3D.Y() + cos(ToRad(CameraYaw)) * cos(ToRad(CameraPitch)) * CameraDistance) layer="World3D" camera_number_default_0=0
do Scene3D::SetCameraZ modification_sign="=" value=expr(120 + PlayerFloor + Riding * 220 + sin(ToRad(CameraPitch)) * CameraDistance) layer="World3D" camera_number_default_0=0
do Scene3D::TurnCameraTowardPosition x_position=expr(Player3D.X()) y_position=expr(Player3D.Y()) z_position=expr(120 + PlayerFloor + Riding * 220) layer="World3D" camera_number_default_0=0 stand_on_y_instead_of_z=false

@event
if NumberVariable variable="Mode" comparison_sign="=" value=6
if BuiltinCommonInstructions::Once
do ShowLayer layer="Quests"
do HideLayer layer="HUD"
do HideLayer layer="Inventory"
do HideLayer layer="Pause"
do HideLayer layer="Settings"
do HideLayer layer="Title"
do HideLayer layer="Photo"

@event
if NumberVariable variable="Mode" comparison_sign="=" value=5
do HideLayer layer="Quests"

@comment "Twelve survival goals; action counters and explicit, saved reward claims" background=[90,150,120] text=[255,255,255]

@event
if NumberVariable variable="Mode" comparison_sign=">=" value=expr(0)
do SetNumberVariable variable="QuestReady" modification_sign="=" value=expr(0)
do SetNumberVariable variable="QuestTargetValid" modification_sign="=" value=expr(0)
do SetNumberVariable variable="QuestTargetKind" modification_sign="=" value=expr(0)

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(0)
do SetStringVariable variable="QuestName" modification_sign="=" value=expr("第一份食物")
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("亲手采集浆果 "+ToString(min(GatherBerries,3))+" /3")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("靠近红果灌木点「采集」。点「补给」或背包中的食物恢复饥饿值。")
do SetStringVariable variable="QuestReward" modification_sign="=" value=expr("浆果 +3")
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text=expr("目标 1 /12 · 建立海岛据点")

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(0)
if NumberVariable variable="GatherBerries" comparison_sign=">=" value=expr(3)
do SetNumberVariable variable="QuestReady" modification_sign="=" value=expr(1)

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(1)
do SetStringVariable variable="QuestName" modification_sign="=" value=expr("就地取材")
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("木材 "+ToString(min(GatherWood,4))+"/4 · 石头 "+ToString(min(GatherStone,3))+"/3 · 纤维 "+ToString(min(GatherFiber,5))+"/5")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("靠近小树点「采集」，会自动使用斧头。石头和蕨类也可点一下采集。")
do SetStringVariable variable="QuestReward" modification_sign="=" value=expr("木材 +6 / 石头 +2 / 纤维 +4")
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text=expr("目标 2 /12 · 建立海岛据点")

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(1)
if NumberVariable variable="GatherWood" comparison_sign=">=" value=expr(4)
if NumberVariable variable="GatherStone" comparison_sign=">=" value=expr(3)
if NumberVariable variable="GatherFiber" comparison_sign=">=" value=expr(5)
do SetNumberVariable variable="QuestReady" modification_sign="=" value=expr(1)

@event
