@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(1)
if NumberVariable variable="GatherWood" comparison_sign=">=" value=expr(4)
if NumberVariable variable="GatherStone" comparison_sign=">=" value=expr(3)
if NumberObjectVariable object="FiberFern" variable="Cooldown" comparison_sign="<=" value=expr(0)
if PickNearest object="FiberFern" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
do SetNumberVariable variable="QuestTargetValid" modification_sign="=" value=expr(1)
do SetNumberVariable variable="QuestTargetX" modification_sign="=" value=expr(FiberFern.X())
do SetNumberVariable variable="QuestTargetY" modification_sign="=" value=expr(FiberFern.Y())
do SetStringVariable variable="QuestTargetName" modification_sign="=" value=expr("蕨类")

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(5)
if NumberVariable variable="WaterVisits" comparison_sign="=" value=expr(0)
if PickNearest object="SpringWater" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
do SetNumberVariable variable="QuestTargetValid" modification_sign="=" value=expr(1)
do SetNumberVariable variable="QuestTargetX" modification_sign="=" value=expr(SpringWater.X())
do SetNumberVariable variable="QuestTargetY" modification_sign="=" value=expr(SpringWater.Y())
do SetStringVariable variable="QuestTargetName" modification_sign="=" value=expr("清泉")

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(5)
if NumberVariable variable="WaterVisits" comparison_sign=">" value=expr(0)
if PickNearest object="SurvivalFires" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
do SetNumberVariable variable="QuestTargetValid" modification_sign="=" value=expr(1)
do SetNumberVariable variable="QuestTargetX" modification_sign="=" value=expr(SurvivalFires.X())
do SetNumberVariable variable="QuestTargetY" modification_sign="=" value=expr(SurvivalFires.Y())
do SetStringVariable variable="QuestTargetName" modification_sign="=" value=expr("篝火")

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(6)
if PickNearest object="Triceratops" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
do SetNumberVariable variable="QuestTargetValid" modification_sign="=" value=expr(1)
do SetNumberVariable variable="QuestTargetX" modification_sign="=" value=expr(Triceratops.X())
do SetNumberVariable variable="QuestTargetY" modification_sign="=" value=expr(Triceratops.Y())
do SetStringVariable variable="QuestTargetName" modification_sign="=" value=expr("三角龙")

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(7)
if NumberObjectVariable object="MetalDeposit" variable="Cooldown" comparison_sign="<=" value=expr(0)
if PickNearest object="MetalDeposit" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
do SetNumberVariable variable="QuestTargetValid" modification_sign="=" value=expr(1)
do SetNumberVariable variable="QuestTargetX" modification_sign="=" value=expr(MetalDeposit.X())
do SetNumberVariable variable="QuestTargetY" modification_sign="=" value=expr(MetalDeposit.Y())
do SetStringVariable variable="QuestTargetName" modification_sign="=" value=expr("金属矿脉")

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(10)
if NumberObjectVariable object="Predators" variable="HP" comparison_sign=">" value=expr(0)
if PickNearest object="Predators" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
do SetNumberVariable variable="QuestTargetValid" modification_sign="=" value=expr(1)
do SetNumberVariable variable="QuestTargetX" modification_sign="=" value=expr(Predators.X())
do SetNumberVariable variable="QuestTargetY" modification_sign="=" value=expr(Predators.Y())
do SetStringVariable variable="QuestTargetName" modification_sign="=" value=expr("捕食者")

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(11)
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(GatherMetal-BaseMetal) comparison_sign="<" second_expression=expr(6)
if NumberObjectVariable object="MetalDeposit" variable="Cooldown" comparison_sign="<=" value=expr(0)
if PickNearest object="MetalDeposit" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
do SetNumberVariable variable="QuestTargetValid" modification_sign="=" value=expr(1)
do SetNumberVariable variable="QuestTargetX" modification_sign="=" value=expr(MetalDeposit.X())
do SetNumberVariable variable="QuestTargetY" modification_sign="=" value=expr(MetalDeposit.Y())
do SetStringVariable variable="QuestTargetName" modification_sign="=" value=expr("金属矿脉")

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(11)
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(GatherMetal-BaseMetal) comparison_sign=">=" second_expression=expr(6)
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(MealsCooked-BaseMeals) comparison_sign="<" second_expression=expr(2)
if PickNearest object="SurvivalFires" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
do SetNumberVariable variable="QuestTargetValid" modification_sign="=" value=expr(1)
do SetNumberVariable variable="QuestTargetX" modification_sign="=" value=expr(SurvivalFires.X())
do SetNumberVariable variable="QuestTargetY" modification_sign="=" value=expr(SurvivalFires.Y())
do SetStringVariable variable="QuestTargetName" modification_sign="=" value=expr("篝火")

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(11)
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(GatherMetal-BaseMetal) comparison_sign=">=" second_expression=expr(6)
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(MealsCooked-BaseMeals) comparison_sign=">=" second_expression=expr(2)
if NumberObjectVariable object="Predators" variable="HP" comparison_sign=">" value=expr(0)
if PickNearest object="Predators" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
do SetNumberVariable variable="QuestTargetValid" modification_sign="=" value=expr(1)
do SetNumberVariable variable="QuestTargetX" modification_sign="=" value=expr(Predators.X())
do SetNumberVariable variable="QuestTargetY" modification_sign="=" value=expr(Predators.Y())
do SetStringVariable variable="QuestTargetName" modification_sign="=" value=expr("捕食者")

@event
if NumberVariable variable="QuestTargetValid" comparison_sign="=" value=expr(1)
do SetNumberVariable variable="QuestRight" modification_sign="=" value=expr((QuestTargetX-Player3D.X())*cos(ToRad(CameraYaw))-(QuestTargetY-Player3D.Y())*sin(ToRad(CameraYaw)))
do SetNumberVariable variable="QuestForward" modification_sign="=" value=expr(-(QuestTargetX-Player3D.X())*sin(ToRad(CameraYaw))-(QuestTargetY-Player3D.Y())*cos(ToRad(CameraYaw)))
do SetStringVariable variable="QuestDirection" modification_sign="=" value=expr("前方")

@event
if NumberVariable variable="QuestForward" comparison_sign="<" value=expr(0)
do SetStringVariable variable="QuestDirection" modification_sign="=" value=expr("后方")

@event
if NumberVariable variable="QuestRight" comparison_sign=">" value=expr(abs(QuestForward))
do SetStringVariable variable="QuestDirection" modification_sign="=" value=expr("右侧")

@event
if NumberVariable variable="QuestRight" comparison_sign="<" value=expr(-abs(QuestForward))
do SetStringVariable variable="QuestDirection" modification_sign="=" value=expr("左侧")

@event
if NumberVariable variable="Mode" comparison_sign=">=" value=expr(0)
do TextContainerCapability::TextContainerBehavior::SetValue object="QuestTitle" behavior="Text" modification_sign="=" text=expr(QuestName)
do TextContainerCapability::TextContainerBehavior::SetValue object="QuestBody" behavior="Text" modification_sign="=" text=expr(QuestProgress+NewLine()+"J 查看步骤与奖励")
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalTitle" behavior="Text" modification_sign="=" text=expr(QuestName)
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalProgress" behavior="Text" modification_sign="=" text=expr(QuestProgress)
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalInstruction" behavior="Text" modification_sign="=" text=expr(QuestInstruction)
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalReward" behavior="Text" modification_sign="=" text=expr("奖励："+QuestReward)
do TextContainerCapability::TextContainerBehavior::SetValue object="ClaimQuestLabel" behavior="Text" modification_sign="=" text=expr("完成目标后领取")
do TextContainerCapability::TextContainerBehavior::SetValue object="Compass" behavior="Text" modification_sign="=" text=expr("Q 切换导航 · J 任务")
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalHeading" behavior="Text" modification_sign="=" text=expr("生存手册 / 目标 "+ToString(QuestStage+1)+" /12")

@event
if NumberVariable variable="QuestTargetValid" comparison_sign="=" value=expr(1)
if NumberVariable variable="QuestReady" comparison_sign="=" value=expr(0)
do TextContainerCapability::TextContainerBehavior::SetValue object="Compass" behavior="Text" modification_sign="=" text=expr(QuestDirection+" · "+QuestTargetName+" "+ToString(round(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),QuestTargetX,QuestTargetY)/100))+"m")

@event
if NumberVariable variable="QuestReady" comparison_sign="=" value=expr(1)
do TextContainerCapability::TextContainerBehavior::SetValue object="QuestBody" behavior="Text" modification_sign="=" text=expr(QuestProgress+NewLine()+"已完成！J 领取奖励")
do TextContainerCapability::TextContainerBehavior::SetValue object="ClaimQuestLabel" behavior="Text" modification_sign="=" text=expr("领取奖励，继续下一步")
do TextContainerCapability::TextContainerBehavior::SetValue object="Compass" behavior="Text" modification_sign="=" text=expr("目标达成 · J 领取奖励")

