@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(10)
do SetStringVariable variable="QuestName" modification_sign="=" value=expr("反击捕食者")
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("击败捕食者 "+ToString(min(Kills-BaseKills,1))+" /1")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("准备烤肉、饮水和长矛。用摇杆移动闪避，按住「攻击」连续战斗，击败捕食者获取肉和兽皮。")
do SetStringVariable variable="QuestReward" modification_sign="=" value=expr("兽皮 +4；解锁远征委托")
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text=expr("目标 11 /12 · 向危险区域远征")

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(10)
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Kills-BaseKills) comparison_sign=">=" second_expression=expr(1)
do SetNumberVariable variable="QuestReady" modification_sign="=" value=expr(1)

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(11)
do SetStringVariable variable="QuestName" modification_sign="=" value=expr("远征补给委托")
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("矿石 "+ToString(min(GatherMetal-BaseMetal,6))+"/6 · 烤肉 "+ToString(min(MealsCooked-BaseMeals,2))+"/2 · 狩猎 "+ToString(min(Kills-BaseKills,1))+"/1")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("每轮采矿、烹饪并完成一次狩猎，再点当前目标领取奖励。先准备补给，再深入矿区。")
do SetStringVariable variable="QuestReward" modification_sign="=" value=expr("金属锭 +2 / 绳索 +2")
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text=expr("目标 12 /12 · 向危险区域远征")

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=expr(11)
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(GatherMetal-BaseMetal) comparison_sign=">=" second_expression=expr(6)
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(MealsCooked-BaseMeals) comparison_sign=">=" second_expression=expr(2)
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Kills-BaseKills) comparison_sign=">=" second_expression=expr(1)
do SetNumberVariable variable="QuestReady" modification_sign="=" value=expr(1)

@event
if NumberVariable variable="QuestReady" comparison_sign="=" value=expr(1)
if NumberVariable variable="QuestAnnounced" comparison_sign="!=" value=expr(QuestStage)
do SetNumberVariable variable="QuestAnnounced" modification_sign="=" value=expr(QuestStage)
do SetNumberVariable variable="QuestToastTime" modification_sign="=" value=expr(5)
do TextContainerCapability::TextContainerBehavior::SetValue object="QuestToast" behavior="Text" modification_sign="=" text=expr("目标达成："+QuestName+NewLine()+"按 J 领取奖励，继续下一步。")
do PlaySound audio_file_or_audio_resource_name="quest-complete.wav" repeat_the_sound=false volume=55 pitch_speed=1

@event
if NumberVariable variable="QuestClaim" comparison_sign="=" value=expr(1)
if NumberVariable variable="QuestReady" comparison_sign="=" value=expr(1)
do SetNumberVariable variable="QuestClaimStage" modification_sign="=" value=expr(QuestStage)
do SetNumberVariable variable="QuestReady" modification_sign="=" value=expr(0)
do SetNumberVariable variable="QuestClaim" modification_sign="=" value=expr(0)
do SetNumberVariable variable="QuestAnnounced" modification_sign="=" value=expr(-1)
do SetNumberVariable variable="QuestToastTime" modification_sign="=" value=expr(5)
do SetNumberVariable variable="Dirty" modification_sign="=" value=expr(1)
do SetNumberVariable variable="SaveRequested" modification_sign="=" value=expr(1)
do TextContainerCapability::TextContainerBehavior::SetValue object="QuestToast" behavior="Text" modification_sign="=" text=expr("奖励已领取："+QuestReward+NewLine()+"进度已自动保存。")

