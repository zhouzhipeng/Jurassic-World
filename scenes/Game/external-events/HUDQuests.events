do SetStringVariable variable="QuestName" modification_sign="=" value=expr("金属时代")
do SetStringVariable variable="QuestProgress" modification_sign="=" value=expr("制作金属工具 "+ToString(MetalTools)+" /1")
do SetStringVariable variable="QuestInstruction" modification_sign="=" value=expr("在工坊点「升级金属工具」：3 金属锭、4 木材、2 兽皮。提升采集产量和长矛伤害。")
do SetStringVariable variable="QuestReward" modification_sign="=" value=expr("烤肉 +2")
do TextContainerCapability::TextContainerBehavior::SetValue object="JournalStory" behavior="Text" modification_sign="=" text=expr("目标 10 /12 · 向危险区域远征")

