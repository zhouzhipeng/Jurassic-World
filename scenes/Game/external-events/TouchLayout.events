do SetStringObjectVariable object="TouchButton" variable="Label" modification_sign="=" value=expr("熔炼中 · "+ToString(ceil(ForgeTime))+" 秒")

if NumberVariable variable="TouchMode" comparison_sign="=" value=expr(1)
if NumberVariable variable="Mode" comparison_sign="!=" value=expr(0)
if NumberVariable variable="Dead" comparison_sign="=" value=expr(1)
do SetStringVariable variable="TouchPanelTitle" modification_sign="=" value=expr("休整后，再出发")
do SetStringVariable variable="TouchPanelBody" modification_sign="=" value=expr("你在野外倒下了。"+NewLine()+"少量食物会遗失，营地与制作进度会保留。"+NewLine()+"点下方按钮在营地重生。")

if NumberVariable variable="TouchMode" comparison_sign="=" value=expr(1)
if NumberVariable variable="Mode" comparison_sign="!=" value=expr(0)
if NumberVariable variable="Dead" comparison_sign="=" value=expr(1)
if NumberObjectVariable object="TouchButton" variable="Slot" comparison_sign="=" value=expr(100)
do SetNumberObjectVariable object="TouchButton" variable="Active" modification_sign="=" value=expr(1)
do SetNumberObjectVariable object="TouchButton" variable="Command" modification_sign="=" value=expr(199)
do SetStringObjectVariable object="TouchButton" variable="Label" modification_sign="=" value=expr("在营地重生")
do SetNumberObjectVariable object="TouchButton" variable="FontSize" modification_sign="=" value=expr(28)
do AnimatableCapability::AnimatableBehavior::SetName object="TouchButton" behavior="Animation" modification_sign="=" animation_name="Default"
do SetX object="TouchButton" modification_sign="=" value=expr(TouchMenuX+30*TouchScale)
do SetY object="TouchButton" modification_sign="=" value=expr(TouchMenuY+260*TouchScale)
do ResizableCapability::ResizableBehavior::SetSize object="TouchButton" behavior="Resizable" width=expr(TouchMenuWidth-60*TouchScale) height=expr(100*TouchScale)

if NumberVariable variable="TouchMode" comparison_sign="=" value=expr(1)
if NumberVariable variable="Mode" comparison_sign="!=" value=expr(0)
do TextContainerCapability::TextContainerBehavior::SetValue object="TouchTitle" behavior="Text" modification_sign="=" text=expr(TouchPanelTitle)
do TextContainerCapability::TextContainerBehavior::SetValue object="TouchBody" behavior="Text" modification_sign="=" text=expr(TouchPanelBody)

if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=1
if NumberObjectVariable object="TouchButton" variable="Command" comparison_sign="!=" value=199
do SetNumberObjectVariable object="TouchButton" variable="Active" modification_sign="=" value=0

if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
if NumberObjectVariable object="TouchButton" variable="Slot" comparison_sign="=" value=9
do SetNumberObjectVariable object="TouchButton" variable="Active" modification_sign="=" value=1
do SetNumberObjectVariable object="TouchButton" variable="Command" modification_sign="=" value=192
do SetStringObjectVariable object="TouchButton" variable="Label" modification_sign="=" value="管理"
do SetX object="TouchButton" modification_sign="=" value=expr(TouchWidth-TouchMargin-224*TouchScale)
do SetY object="TouchButton" modification_sign="=" value=expr(TouchHeight-TouchMargin-275*TouchScale)
do ResizableCapability::ResizableBehavior::SetSize object="TouchButton" behavior="Resizable" width=expr(104*TouchScale) height=expr(76*TouchScale)

if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="TouchPanel" comparison_sign="=" value=4
if NumberVariable variable="Mode" comparison_sign="=" value=6
do TextContainerCapability::TextContainerBehavior::SetValue object="TouchBody" behavior="Text" modification_sign="=" text=expr(QuestName+NewLine()+QuestProgress+NewLine()+QuestInstruction+NewLine()+"奖励："+QuestReward)
> if NumberObjectVariable object="TouchButton" variable="Slot" comparison_sign=">=" value=100
> do SetY object="TouchButton" modification_sign="+" value=expr(95*TouchScale)

if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="!=" value=0
if NumberObjectVariable object="TouchButton" variable="Command" comparison_sign="=" value=110
if NumberVariable variable="Berries" comparison_sign="<=" value=0
do SetNumberObjectVariable object="TouchButton" variable="Enabled" modification_sign="=" value=0
do SetStringObjectVariable object="TouchButton" variable="Label" modification_sign="=" value="没有浆果"

if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="!=" value=0
if NumberObjectVariable object="TouchButton" variable="Command" comparison_sign="=" value=111
if NumberVariable variable="CookedMeat" comparison_sign="<=" value=0
do SetNumberObjectVariable object="TouchButton" variable="Enabled" modification_sign="=" value=0
do SetStringObjectVariable object="TouchButton" variable="Label" modification_sign="=" value="没有烤肉"

if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="!=" value=0
if NumberObjectVariable object="TouchButton" variable="Command" comparison_sign="=" value=113
if NumberVariable variable="Wood" comparison_sign="<" value=6
or NumberVariable variable="Stone" comparison_sign="<" value=2
or NumberVariable variable="Fiber" comparison_sign="<" value=4
do SetNumberObjectVariable object="TouchButton" variable="Enabled" modification_sign="=" value=0
do SetStringObjectVariable object="TouchButton" variable="Label" modification_sign="=" value="长矛 · 材料不足"

if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="!=" value=0
if NumberObjectVariable object="TouchButton" variable="Command" comparison_sign="=" value=114
if NumberVariable variable="Wood" comparison_sign="<" value=5
or NumberVariable variable="Stone" comparison_sign="<" value=3
or NumberVariable variable="Fiber" comparison_sign="<" value=4
do SetNumberObjectVariable object="TouchButton" variable="Enabled" modification_sign="=" value=0
do SetStringObjectVariable object="TouchButton" variable="Label" modification_sign="=" value="石斧 · 材料不足"
