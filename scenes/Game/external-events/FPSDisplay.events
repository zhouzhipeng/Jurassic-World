@event aiGeneratedEventId="fps-refresh-quarter-second"
if CompareTimer timer_name="FPSDisplayRefresh" comparison_sign=">=" time_in_seconds=0.25
do SetNumberObjectVariable object="FPSCounter" variable="MeasuredFPS" modification_sign="=" value=expr(FPS::FPS())
do TextContainerCapability::TextContainerBehavior::SetValue object="FPSCounter" behavior="Text" modification_sign="=" text=expr("FPS: " + ToString(round(FPSCounter.Variable(MeasuredFPS))))
do ResetTimer timer_name="FPSDisplayRefresh"

@event aiGeneratedEventId="fps-center-on-window"
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(FPSCounter.X()) comparison_sign="!=" second_expression=expr((SceneWindowWidth() - FPSCounter.Width()) / 2)
do SetX object="FPSCounter" modification_sign="=" value=expr((SceneWindowWidth() - FPSCounter.Width()) / 2)
