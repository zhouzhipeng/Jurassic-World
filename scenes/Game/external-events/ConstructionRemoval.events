@comment "Scene input adapter; extension selects and removes the target." background=[90,150,120] text=[255,255,255]

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
if KeyFromTextReleased key_to_check="Delete"
or NumberVariable variable="TouchDelete" comparison_sign="=" value=1
do EmitSceneSignal signal_name="Construction.RemoveAt" payload=""
