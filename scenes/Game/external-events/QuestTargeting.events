@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=0
if NumberObjectVariable object="BerryBush" variable="Cooldown" comparison_sign="<=" value=0
if PickNearest object="BerryBush" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
do SetNumberVariable variable="QuestTargetValid" modification_sign="=" value=1
do SetNumberVariable variable="QuestTargetX" modification_sign="=" value=expr(BerryBush.X())
do SetNumberVariable variable="QuestTargetY" modification_sign="=" value=expr(BerryBush.Y())
do SetStringVariable variable="QuestTargetName" modification_sign="=" value="浆果灌木"

