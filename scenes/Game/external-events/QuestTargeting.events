@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=11
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(GatherMetal-BaseMetal) comparison_sign="<" second_expression=6
if NumberObjectVariable object="MetalDeposit" variable="Cooldown" comparison_sign="<=" value=0
if PickNearest object="MetalDeposit" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
do SetNumberVariable variable="QuestTargetValid" modification_sign="=" value=1
do SetNumberVariable variable="QuestTargetX" modification_sign="=" value=expr(MetalDeposit.X())
do SetNumberVariable variable="QuestTargetY" modification_sign="=" value=expr(MetalDeposit.Y())
do SetStringVariable variable="QuestTargetName" modification_sign="=" value="金属矿脉"

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=11
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(GatherMetal-BaseMetal) comparison_sign=">=" second_expression=6
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(MealsCooked-BaseMeals) comparison_sign="<" second_expression=2
if PickNearest object="SurvivalFires" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
do SetNumberVariable variable="QuestTargetValid" modification_sign="=" value=1
do SetNumberVariable variable="QuestTargetX" modification_sign="=" value=expr(SurvivalFires.X())
do SetNumberVariable variable="QuestTargetY" modification_sign="=" value=expr(SurvivalFires.Y())
do SetStringVariable variable="QuestTargetName" modification_sign="=" value="篝火"

@event
if NumberVariable variable="QuestStage" comparison_sign="=" value=11
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(GatherMetal-BaseMetal) comparison_sign=">=" second_expression=6
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(MealsCooked-BaseMeals) comparison_sign=">=" second_expression=2
if NumberObjectVariable object="Predators" variable="HP" comparison_sign=">" value=0
if PickNearest object="Predators" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
do SetNumberVariable variable="QuestTargetValid" modification_sign="=" value=1
do SetNumberVariable variable="QuestTargetX" modification_sign="=" value=expr(Predators.X())
do SetNumberVariable variable="QuestTargetY" modification_sign="=" value=expr(Predators.Y())
do SetStringVariable variable="QuestTargetName" modification_sign="=" value="捕食者"

@event
if NumberVariable variable="QuestTargetValid" comparison_sign="=" value=1
do SetNumberVariable variable="QuestRight" modification_sign="=" value=expr((QuestTargetX-Player3D.X())*cos(ToRad(CameraYaw))-(QuestTargetY-Player3D.Y())*sin(ToRad(CameraYaw)))
do SetNumberVariable variable="QuestForward" modification_sign="=" value=expr(-(QuestTargetX-Player3D.X())*sin(ToRad(CameraYaw))-(QuestTargetY-Player3D.Y())*cos(ToRad(CameraYaw)))
do SetStringVariable variable="QuestDirection" modification_sign="=" value="前方"

@event
if NumberVariable variable="QuestForward" comparison_sign="<" value=0
do SetStringVariable variable="QuestDirection" modification_sign="=" value="后方"

@event
if NumberVariable variable="QuestRight" comparison_sign=">" value=expr(abs(QuestForward))
do SetStringVariable variable="QuestDirection" modification_sign="=" value="右侧"

@event
if NumberVariable variable="QuestRight" comparison_sign="<" value=expr(-abs(QuestForward))
do SetStringVariable variable="QuestDirection" modification_sign="=" value="左侧"
