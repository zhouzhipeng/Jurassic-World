@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=1
if NumberVariable variable="TouchPanel" comparison_sign="=" value=2
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="TouchCommand" comparison_sign=">=" value=400
if NumberVariable variable="TouchCommand" comparison_sign="<=" value=413
do SetNumberVariable variable="PackSelected" modification_sign="=" value=expr(TouchCommand-400)

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=1
if NumberVariable variable="TouchPanel" comparison_sign="=" value=2
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="TouchCommand" comparison_sign="=" value=451
if NumberVariable variable="Axe" comparison_sign=">" value=0
do SetNumberVariable variable="SelectedHotbar" modification_sign="=" value=1
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetStringVariable variable="TouchToast" modification_sign="=" value="已装备石斧"
do SetNumberVariable variable="TouchToastTime" modification_sign="=" value=2

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=1
if NumberVariable variable="TouchPanel" comparison_sign="=" value=2
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="TouchCommand" comparison_sign="=" value=452
if NumberVariable variable="Spear" comparison_sign=">" value=0
do SetNumberVariable variable="SelectedHotbar" modification_sign="=" value=2
do SetNumberVariable variable="Dirty" modification_sign="=" value=1
do SetStringVariable variable="TouchToast" modification_sign="=" value="已装备长矛"
do SetNumberVariable variable="TouchToastTime" modification_sign="=" value=2
