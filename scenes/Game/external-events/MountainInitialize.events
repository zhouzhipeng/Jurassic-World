@comment "Mountain profile generated from tools/mountain_profile.py; native elevation follows the visual mesh." background=[90,150,120] text=[255,255,255]

@event
if SceneJustBegins
> for each BerryBush
>> if SceneJustBegins
>> do Scene3D::Base3DBehavior::SetZ parameter_3d_object="BerryBush" behavior="Object3D" modification_sign="=" value=expr(1100*pow(max(0,1-pow(((BerryBush.X())-(800))/2000,2)-pow(((BerryBush.Y())-(-2100))/1700,2)),2)+650*pow(max(0,1-pow(((BerryBush.X())-(-2250))/1100,2)-pow(((BerryBush.Y())-(600))/1700,2)),2)+950*pow(max(0,1-pow(((BerryBush.X())-(2350))/1200,2)-pow(((BerryBush.Y())-(300))/1800,2)),2)+1000*pow(max(0,1-pow(((BerryBush.X())-(-2050))/1400,2)-pow(((BerryBush.Y())-(-2400))/1300,2)),2)+2350*pow(max(0,1-pow(((BerryBush.X())-(-4200))/2000,2)-pow(((BerryBush.Y())-(-4050))/2100,2)),2)+2800*pow(max(0,1-pow(((BerryBush.X())-(2200))/2600,2)-pow(((BerryBush.Y())-(-4450))/1600,2)),2)+1850*pow(max(0,1-pow(((BerryBush.X())-(4450))/1800,2)-pow(((BerryBush.Y())-(1400))/2700,2)),2)+1250*pow(max(0,1-pow(((BerryBush.X())-(-2900))/2500,2)-pow(((BerryBush.Y())-(3950))/1500,2)),2))

