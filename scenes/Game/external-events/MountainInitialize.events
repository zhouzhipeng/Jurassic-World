@event
for each Triceratops
> do SetNumberObjectVariable object="Triceratops" variable="HomeX" modification_sign="=" value=expr(Triceratops.X())
> do SetNumberObjectVariable object="Triceratops" variable="HomeY" modification_sign="=" value=expr(Triceratops.Y())
> do SetNumberObjectVariable object="Triceratops" variable="TargetX" modification_sign="=" value=expr(Triceratops.X())
> do SetNumberObjectVariable object="Triceratops" variable="TargetY" modification_sign="=" value=expr(Triceratops.Y())

@event
for each Stegosaur
> do SetNumberObjectVariable object="Stegosaur" variable="HomeX" modification_sign="=" value=expr(Stegosaur.X())
> do SetNumberObjectVariable object="Stegosaur" variable="HomeY" modification_sign="=" value=expr(Stegosaur.Y())
> do SetNumberObjectVariable object="Stegosaur" variable="TargetX" modification_sign="=" value=expr(Stegosaur.X())
> do SetNumberObjectVariable object="Stegosaur" variable="TargetY" modification_sign="=" value=expr(Stegosaur.Y())

