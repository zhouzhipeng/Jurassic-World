do SetNumberVariable variable="QuestRight" modification_sign="=" value=expr((QuestTargetX - Player3D.X()) * cos(ToRad(CameraYaw)) - (QuestTargetY - Player3D.Y()) * sin(ToRad(CameraYaw)))
do SetNumberVariable variable="QuestForward" modification_sign="=" value=expr(-(QuestTargetX - Player3D.X()) * sin(ToRad(CameraYaw)) - (QuestTargetY - Player3D.Y()) * cos(ToRad(CameraYaw)))
do SetStringVariable variable="QuestDirection" modification_sign="=" value="前方"

if NumberVariable variable="QuestForward" comparison_sign="<" value=0
do SetStringVariable variable="QuestDirection" modification_sign="=" value="后方"

if NumberVariable variable="QuestRight" comparison_sign=">" value=expr(abs(QuestForward))
do SetStringVariable variable="QuestDirection" modification_sign="=" value="右侧"

if NumberVariable variable="QuestRight" comparison_sign="<" value=expr(-abs(QuestForward))
do SetStringVariable variable="QuestDirection" modification_sign="=" value="左侧"

