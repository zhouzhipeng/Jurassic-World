if NumberVariable variable="BuildValid" comparison_sign="=" value=0
do SetX object="PartFoundationInvalid" modification_sign="=" value=expr(BuildX)
do SetY object="PartFoundationInvalid" modification_sign="=" value=expr(BuildY)
do SetAngle object="PartFoundationInvalid" modification_sign="=" angle_in_degrees=expr(BuildAngle)
do Scene3D::Base3DBehavior::SetZ parameter_3d_object="PartFoundationInvalid" behavior="Object3D" modification_sign="=" value=expr(BuildZ)
do Show object="PartFoundationInvalid"

