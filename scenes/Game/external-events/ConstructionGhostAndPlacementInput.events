@comment "Grid foundations require level valley ground; hills remain traversable." background=[90,150,120] text=[255,255,255]

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
if NumberVariable variable="BuildKind" comparison_sign="=" value=10
if NumberVariable variable="BuildValid" comparison_sign="=" value=1
do SetX object="PartFoundationValid" modification_sign="=" value=expr(BuildX)
do SetY object="PartFoundationValid" modification_sign="=" value=expr(BuildY)
do SetAngle object="PartFoundationValid" modification_sign="=" angle_in_degrees=expr(BuildAngle)
do Scene3D::Base3DBehavior::SetZ parameter_3d_object="PartFoundationValid" behavior="Object3D" modification_sign="=" value=expr(BuildZ)
do Show object="PartFoundationValid"

