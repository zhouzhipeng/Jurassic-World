if SceneJustBegins
do TouchSimulateMouse activate_yes_by_default_when_game_is_launched=false
do SetStringVariable variable="TouchLastNotice" modification_sign="=" value=expr(NoticeMessage)
do BuiltinExternalLayouts::CreateObjectsFromExternalLayout name_of_the_external_layout="GameTouch" x_position_of_the_origin=0 y_position_of_the_origin=0 z_position_of_the_origin=0
do BuiltinExternalLayouts::CreateObjectsFromExternalLayout name_of_the_external_layout="GameTouchInventory" x_position_of_the_origin=0 y_position_of_the_origin=0 z_position_of_the_origin=0
do BuiltinExternalLayouts::CreateObjectsFromExternalLayout name_of_the_external_layout="GameHUD" x_position_of_the_origin=0 y_position_of_the_origin=0 z_position_of_the_origin=0
do BuiltinExternalLayouts::CreateObjectsFromExternalLayout name_of_the_external_layout="GameInventory" x_position_of_the_origin=0 y_position_of_the_origin=0 z_position_of_the_origin=0
do BuiltinExternalLayouts::CreateObjectsFromExternalLayout name_of_the_external_layout="GamePause" x_position_of_the_origin=0 y_position_of_the_origin=0 z_position_of_the_origin=0
do BuiltinExternalLayouts::CreateObjectsFromExternalLayout name_of_the_external_layout="GameSettings" x_position_of_the_origin=0 y_position_of_the_origin=0 z_position_of_the_origin=0
do BuiltinExternalLayouts::CreateObjectsFromExternalLayout name_of_the_external_layout="GameTitle" x_position_of_the_origin=0 y_position_of_the_origin=0 z_position_of_the_origin=0
do BuiltinExternalLayouts::CreateObjectsFromExternalLayout name_of_the_external_layout="GamePhoto" x_position_of_the_origin=0 y_position_of_the_origin=0 z_position_of_the_origin=0
do BuiltinExternalLayouts::CreateObjectsFromExternalLayout name_of_the_external_layout="GameQuests" x_position_of_the_origin=0 y_position_of_the_origin=0 z_position_of_the_origin=0
do BuiltinExternalLayouts::CreateObjectsFromExternalLayout name_of_the_external_layout="GameSurvival" x_position_of_the_origin=0 y_position_of_the_origin=0 z_position_of_the_origin=0
