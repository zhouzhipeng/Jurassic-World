@event aiGeneratedEventId="weather-shelter-reset"
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
do SetNumberVariable variable="WeatherSheltered" modification_sign="=" value=0
> @event
> for each "PartCeiling"
>> @event
>> if PosX object="Player3D" comparison_sign=">" value=expr(PartCeiling.X() - 145)
>> if PosX object="Player3D" comparison_sign="<" value=expr(PartCeiling.X() + 145)
>> if PosY object="Player3D" comparison_sign=">" value=expr(PartCeiling.Y() - 145)
>> if PosY object="Player3D" comparison_sign="<" value=expr(PartCeiling.Y() + 145)
>> if NumberObjectVariable object="PartCeiling" variable="BaseZ" comparison_sign=">" value=expr(PlayerFloor + 180)
>> if NumberVariable variable="Riding" comparison_sign="=" value=0
>> do SetNumberVariable variable="WeatherSheltered" modification_sign="=" value=1

@event aiGeneratedEventId="weather-environment"
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
do ShowLayer layer="Weather"
do SetStringVariable variable="WeatherSky" modification_sign="=" value=expr(ToString(round((12 + 102 * Daylight + 125 * Twilight) * (1 - 0.386 * WeatherCloud) + WeatherMist * (8 + 42 * Daylight))) + ";" + ToString(round((20 + 167 * Daylight + 14 * Twilight) * (1 - 0.46 * WeatherCloud) + WeatherMist * (10 + 15 * Daylight))) + ";" + ToString(round((39 + 182 * Daylight - 8 * Twilight) * (1 - 0.457 * WeatherCloud) + WeatherMist * (14 - 12 * Daylight))))
do SceneBackground color=expr(WeatherSky)
do SetLayerEffectParameter layer="World3D" effect_name="Sun" property_name="intensity" new_value=expr(Daylight * max(0.08, 0.85 - WeatherCloud * 0.7 - WeatherMist * 0.18) + WeatherFlash * 0.6)
do SetLayerEffectParameter layer="World3D" effect_name="Sun" property_name="elevation" new_value=expr(SunElevation)
do SetLayerEffectParameter layer="World3D" effect_name="Sun" property_name="rotation" new_value=expr(SunRotation)
do SetLayerEffectStringParameter layer="World3D" effect_name="Sun" property_name="color" new_value=expr("255;" + ToString(round(244 - 65 * Twilight)) + ";" + ToString(round(218 - 100 * Twilight)))
do SetLayerEffectParameter layer="World3D" effect_name="Moon" property_name="intensity" new_value=expr((1 - Daylight) * max(0.12, 0.34 - WeatherCloud * 0.13 - WeatherMist * 0.06))
do SetLayerEffectParameter layer="World3D" effect_name="Moon" property_name="elevation" new_value=expr(max(12, -55 * sin(ToRad(WorldMinutes / 4 - 90))))
do SetLayerEffectParameter layer="World3D" effect_name="Moon" property_name="rotation" new_value=expr(mod(SunRotation + 180, 360))
do SetLayerEffectParameter layer="World3D" effect_name="Sky fill" property_name="intensity" new_value=expr((0.23 + 0.32 * Daylight) * (1 - WeatherCloud * 0.22) + WeatherFlash * 0.25)
do SetLayerEffectStringParameter layer="World3D" effect_name="Sky fill" property_name="skyColor" new_value=expr(ToString(round(120 + 105 * Daylight)) + ";" + ToString(round(154 + 89 * Daylight - 40 * Twilight)) + ";" + ToString(round(215 + 40 * Daylight - 55 * Twilight)))
do SetLayerEffectStringParameter layer="World3D" effect_name="Sky fill" property_name="groundColor" new_value=expr(ToString(round(65 + 80 * Daylight)) + ";" + ToString(round(84 + 68 * Daylight)) + ";" + ToString(round(125 - 7 * Daylight)))
do SetLayerEffectParameter layer="World3D" effect_name="Weather fog" property_name="near" new_value=expr(max(800, 6500 - WeatherCloud * 4500 - WeatherMist * 5700))
do SetLayerEffectParameter layer="World3D" effect_name="Weather fog" property_name="far" new_value=expr(max(3500, 26000 - WeatherCloud * 19500 - WeatherMist * 18500))
do SetLayerEffectStringParameter layer="World3D" effect_name="Weather fog" property_name="color" new_value=expr(WeatherSky)
do PrimitiveDrawing::Drawer::ClearShapes shape_painter_object="WeatherCanvas"
do TextContainerCapability::TextContainerBehavior::SetValue object="WeatherStatus" behavior="Text" modification_sign="=" text=expr(WeatherName + " · " + WeatherHint + NewLine() + "自动变化 · F6 切换天气")
do Show object="WeatherPanel"
do Show object="WeatherStatus"
> @event
> if NumberVariable variable="WeatherSheltered" comparison_sign="=" value=1
> if NumberVariable variable="WeatherRain" comparison_sign=">" value=0.05
> do TextContainerCapability::TextContainerBehavior::SetValue object="WeatherStatus" behavior="Text" modification_sign="=" text=expr(WeatherName + " · 屋顶下避雨中" + NewLine() + "自动变化 · F6 切换天气")

> @event aiGeneratedEventId="weather-draw-rain"
> local rainX = var(type="number",value=0,persistentUuid="",folded=false,hasMixedValues=false)
> local rainY = var(type="number",value=0,persistentUuid="",folded=false,hasMixedValues=false)
> if NumberVariable variable="WeatherRain" comparison_sign=">" value=0.015
> if NumberVariable variable="WeatherSheltered" comparison_sign="=" value=0
> do PrimitiveDrawing::OutlineColor shape_painter_object="WeatherCanvas" color="200;225;245"
>> @event
>> local drop = var(type="number",value=0,persistentUuid="",folded=false,hasMixedValues=false)
>> repeat "round(180 * WeatherRain)" index="drop"
>>> @event
>>> do SetNumberVariable variable="rainX" modification_sign="=" value=expr(mod(drop * 137.51 + WeatherMotion * (90 + WeatherCloud * 190), 1760) - 80)
>>> do SetNumberVariable variable="rainY" modification_sign="=" value=expr(mod(drop * 293.73 + WeatherMotion * (700 + mod(drop, 5) * 55), 1080) - 90)
>>> do PrimitiveDrawing::OutlineOpacity shape_painter_object="WeatherCanvas" modification_sign="=" opacity_0_255=expr(WeatherRain * (45 + mod(drop, 4) * 24))
>>> do PrimitiveDrawing::LineV2 shape_painter_object="WeatherCanvas" x_position_of_start_point=expr(rainX) y_position_of_start_point=expr(rainY) x_position_of_end_point=expr(rainX - 4 - WeatherCloud * 9) y_position_of_end_point=expr(rainY + 16 + WeatherRain * 22) thickness_in_pixels=expr(1 + mod(drop, 3) * 0.35)

> @event
> if NumberVariable variable="WeatherFlash" comparison_sign=">" value=0
> do PrimitiveDrawing::FillColor shape_painter_object="WeatherCanvas" fill_color="218;233;255"
> do PrimitiveDrawing::FillOpacity shape_painter_object="WeatherCanvas" modification_sign="=" opacity_0_255=expr(WeatherFlash * 30)
> do PrimitiveDrawing::Rectangle shape_painter_object="WeatherCanvas" left_x_position=0 top_y_position=0 right_x_position=1600 bottom_y_position=900

@event aiGeneratedEventId="weather-reference-mode"
if NumberVariable variable="RenderMode" comparison_sign="=" value=0
do HideLayer layer="Weather"
do Hide object="WeatherPanel"
do Hide object="WeatherStatus"

@event aiGeneratedEventId="weather-start-audio"
if NumberVariable variable="WeatherAudioStarted" comparison_sign="=" value=0
if NumberVariable variable="MusicStarted" comparison_sign="=" value=1
or KeyFromTextPressed key_to_check="F6"
do PlayMusicOnChannel audio_file_or_audio_resource_name="weather-rain.wav" channel_identifier=30 repeat_the_sound=true volume=0 pitch_speed=1
do SetNumberVariable variable="WeatherAudioStarted" modification_sign="=" value=1

@event aiGeneratedEventId="weather-mix-audio"
if NumberVariable variable="WeatherAudioStarted" comparison_sign="=" value=1
do SetNumberVariable variable="WeatherRainVolume" modification_sign="=" value=0
> @event
> if NumberVariable variable="RenderMode" comparison_sign="=" value=1
> if NumberVariable variable="Mode" comparison_sign="=" value=0
> if NumberVariable variable="Dead" comparison_sign="=" value=0
> do SetNumberVariable variable="WeatherRainVolume" modification_sign="=" value=expr(WeatherRain * (48 - WeatherSheltered * 36))

> @event
> if NumberVariable variable="WeatherAudioStarted" comparison_sign="=" value=1
> do SetMusicChannelVolume channel_identifier=30 modification_sign="=" volume_0_100=expr(WeatherRainVolume)

@event aiGeneratedEventId="weather-quiet-menu"
if NumberVariable variable="Mode" comparison_sign="!=" value=0
or NumberVariable variable="RenderMode" comparison_sign="=" value=0
do StopSoundChannel channel_identifier=31
