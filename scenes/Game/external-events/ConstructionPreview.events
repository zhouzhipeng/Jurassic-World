>> @comment "Test the building footprint against the dinosaur's oriented body bounds on all four separating axes. HalfLength is the longitudinal extent, not an extra radius in every direction." background=[90,150,180] text=[255,255,255]

>> @event
>> if NumberObjectVariable object="Wildlife" variable="HP" comparison_sign=">" value=0
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(BuildX-Wildlife.X())) comparison_sign="<" second_expression=expr(BuildWorldHX+abs(cos(ToRad(Wildlife.Angle())))*Wildlife.Variable(Radius)+abs(sin(ToRad(Wildlife.Angle())))*Wildlife.Variable(HalfLength))
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(BuildY-Wildlife.Y())) comparison_sign="<" second_expression=expr(BuildWorldHY+abs(sin(ToRad(Wildlife.Angle())))*Wildlife.Variable(Radius)+abs(cos(ToRad(Wildlife.Angle())))*Wildlife.Variable(HalfLength))
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs((BuildX-Wildlife.X())*cos(ToRad(Wildlife.Angle()))+(BuildY-Wildlife.Y())*sin(ToRad(Wildlife.Angle())))) comparison_sign="<" second_expression=expr(Wildlife.Variable(Radius)+BuildWorldHX*abs(cos(ToRad(Wildlife.Angle())))+BuildWorldHY*abs(sin(ToRad(Wildlife.Angle()))))
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(-(BuildX-Wildlife.X())*sin(ToRad(Wildlife.Angle()))+(BuildY-Wildlife.Y())*cos(ToRad(Wildlife.Angle())))) comparison_sign="<" second_expression=expr(Wildlife.Variable(HalfLength)+BuildWorldHX*abs(sin(ToRad(Wildlife.Angle())))+BuildWorldHY*abs(cos(ToRad(Wildlife.Angle()))))
>> do SetNumberVariable variable="BuildValid" modification_sign="=" value=0
