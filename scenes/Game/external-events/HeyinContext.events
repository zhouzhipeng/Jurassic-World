@event
if NumberVariable variable="HeyinStage" comparison_sign=">=" value=0
do SetNumberVariable variable="HeyinNear" modification_sign="=" value=0
do SetNumberVariable variable="HeyinDanger" modification_sign="=" value=0
do SetNumberVariable variable="HeyinDistance" modification_sign="=" value=expr(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),Heyin.X(),Heyin.Y()))

