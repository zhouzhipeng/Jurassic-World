@event
if NumberVariable variable="Mode" comparison_sign=">=" value=0
do Hide object="BuildGhosts"
do Hide object="BuildPanel"
do Hide object="BuildTitle"
do Hide object="BuildStatus"
do Hide object="BuildChoice1"
do Hide object="BuildChoiceLabel1"
do Hide object="BuildChoice2"
