@event
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(SceneInstancesCount(Heyin)) comparison_sign=">" second_expression=0
do SetNumberVariable variable="HeyinBubbleVisible" modification_sign="=" value=0
do SetStringVariable variable="HeyinDialogueLine" modification_sign="=" value="禾音：谢谢你愿意陪我。我们一起找家人吧。"

@event
if NumberVariable variable="HeyinStage" comparison_sign="<=" value=1
do SetStringVariable variable="HeyinDialogueLine" modification_sign="=" value="禾音：我和家人走散了……你能帮帮我吗？"

@event
if NumberObjectVariable object="Heyin" variable="Stay" comparison_sign="=" value=1
do SetStringVariable variable="HeyinDialogueLine" modification_sign="=" value="禾音：我在这里等你，路上小心。"

@event
if NumberObjectVariable object="Heyin" variable="Resting" comparison_sign="=" value=1
do SetStringVariable variable="HeyinDialogueLine" modification_sign="=" value="禾音：让我歇一会儿，很快就能继续走了。"

@event
if NumberVariable variable="HeyinMessageTime" comparison_sign=">" value=0
do SetStringVariable variable="HeyinDialogueLine" modification_sign="=" value=expr(HeyinMessage)

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="HeyinDistance" comparison_sign="<" value=650
if NumberObjectVariable object="Heyin" variable="Attention" comparison_sign="=" value=1
or NumberVariable variable="HeyinMessageTime" comparison_sign=">" value=0
do SetNumberVariable variable="HeyinBubbleVisible" modification_sign="=" value=1

@event
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(SceneInstancesCount(Heyin)) comparison_sign=">" second_expression=0
do JurassicActors::Heyin::UpdateDialogue object="Heyin" background="HeyinBubble" caption="HeyinBubbleText" message=expr(HeyinDialogueLine) visible=expr(HeyinBubbleVisible) cx=expr(CameraX("World3D",0)) cy=expr(CameraY("World3D",0)) cz=expr(Scene3D::CameraZ("World3D",0)) fov=expr(Scene3D::CameraFov("World3D",0)) fx=expr(Scene3D::CameraForwardX("World3D",0)) rx=expr(Scene3D::CameraRightX("World3D",0)) ux=expr(Scene3D::CameraUpX("World3D",0)) fy=expr(Scene3D::CameraForwardY("World3D",0)) ry=expr(Scene3D::CameraRightY("World3D",0)) uy=expr(Scene3D::CameraUpY("World3D",0)) fz=expr(Scene3D::CameraForwardZ("World3D",0)) rz=expr(Scene3D::CameraRightZ("World3D",0)) uz=expr(Scene3D::CameraUpZ("World3D",0))
