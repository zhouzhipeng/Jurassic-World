@comment "Grid foundations require level valley ground; hills remain traversable." background=[90,150,120] text=[255,255,255]
@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(1100*pow(max(0,1-pow(((BuildX-BuildHX)-(800))/2000,2)-pow(((BuildY-BuildHY)-(-2100))/1700,2)),2)+650*pow(max(0,1-pow(((BuildX-BuildHX)-(-2250))/1100,2)-pow(((BuildY-BuildHY)-(600))/1700,2)),2)+950*pow(max(0,1-pow(((BuildX-BuildHX)-(2350))/1200,2)-pow(((BuildY-BuildHY)-(300))/1800,2)),2)+1000*pow(max(0,1-pow(((BuildX-BuildHX)-(-2050))/1400,2)-pow(((BuildY-BuildHY)-(-2400))/1300,2)),2)+2350*pow(max(0,1-pow(((BuildX-BuildHX)-(-4200))/2000,2)-pow(((BuildY-BuildHY)-(-4050))/2100,2)),2)+2800*pow(max(0,1-pow(((BuildX-BuildHX)-(2200))/2600,2)-pow(((BuildY-BuildHY)-(-4450))/1600,2)),2)+1850*pow(max(0,1-pow(((BuildX-BuildHX)-(4450))/1800,2)-pow(((BuildY-BuildHY)-(1400))/2700,2)),2)+1250*pow(max(0,1-pow(((BuildX-BuildHX)-(-2900))/2500,2)-pow(((BuildY-BuildHY)-(3950))/1500,2)),2)) comparison_sign=">" second_expression=1
do SetNumberVariable variable="BuildValid" modification_sign="=" value=expr(0)
do SetStringVariable variable="BuildReason" modification_sign="=" value="山坡无法放置平地建筑，请到山谷或营地平地建造"

@event
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=1
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(1100*pow(max(0,1-pow(((BuildX-BuildHX)-(800))/2000,2)-pow(((BuildY+BuildHY)-(-2100))/1700,2)),2)+650*pow(max(0,1-pow(((BuildX-BuildHX)-(-2250))/1100,2)-pow(((BuildY+BuildHY)-(600))/1700,2)),2)+950*pow(max(0,1-pow(((BuildX-BuildHX)-(2350))/1200,2)-pow(((BuildY+BuildHY)-(300))/1800,2)),2)+1000*pow(max(0,1-pow(((BuildX-BuildHX)-(-2050))/1400,2)-pow(((BuildY+BuildHY)-(-2400))/1300,2)),2)+2350*pow(max(0,1-pow(((BuildX-BuildHX)-(-4200))/2000,2)-pow(((BuildY+BuildHY)-(-4050))/2100,2)),2)+2800*pow(max(0,1-pow(((BuildX-BuildHX)-(2200))/2600,2)-pow(((BuildY+BuildHY)-(-4450))/1600,2)),2)+1850*pow(max(0,1-pow(((BuildX-BuildHX)-(4450))/1800,2)-pow(((BuildY+BuildHY)-(1400))/2700,2)),2)+1250*pow(max(0,1-pow(((BuildX-BuildHX)-(-2900))/2500,2)-pow(((BuildY+BuildHY)-(3950))/1500,2)),2)) comparison_sign=">" second_expression=1
do SetNumberVariable variable="BuildValid" modification_sign="=" value=expr(0)
