@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="TouchAutoHarvest" comparison_sign="=" value=1
if NumberVariable variable="HarvestCount" comparison_sign=">" value=expr(TouchHarvestCount)
or NumberVariable variable="HarvestNear" comparison_sign="=" value=0
or BuiltinCommonInstructions::CompareNumbers first_expression=expr(abs(MoveX)+abs(MoveY)) comparison_sign=">" second_expression=0.15
or NumberVariable variable="BuildMode" comparison_sign="=" value=1
do SetNumberVariable variable="TouchAutoHarvest" modification_sign="=" value=0

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="TouchAutoHarvest" comparison_sign="=" value=1
if NumberObjectVariable object="HarvestNodes" variable="Target" comparison_sign="=" value=1
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(HarvestNodes.X(),HarvestNodes.Y(),TouchHarvestX,TouchHarvestY)) comparison_sign=">" second_expression=1
do SetNumberVariable variable="TouchAutoHarvest" modification_sign="=" value=0

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="TouchCommand" comparison_sign="=" value=301
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="HarvestNear" comparison_sign="=" value=1
if NumberObjectVariable object="HarvestNodes" variable="Target" comparison_sign="=" value=1
if NumberObjectVariable object="HarvestNodes" variable="Cooldown" comparison_sign="<=" value=0
do SetNumberVariable variable="TouchAutoHarvest" modification_sign="=" value=1
do SetNumberVariable variable="TouchHarvestX" modification_sign="=" value=expr(HarvestNodes.X())
do SetNumberVariable variable="TouchHarvestY" modification_sign="=" value=expr(HarvestNodes.Y())
do SetNumberVariable variable="TouchHarvestCount" modification_sign="=" value=expr(HarvestCount)

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="TouchAutoHarvest" comparison_sign="=" value=1
if NumberObjectVariable object="WoodSapling" variable="Target" comparison_sign="=" value=1
do SetNumberVariable variable="SelectedHotbar" modification_sign="=" value=1

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="TouchCommand" comparison_sign="=" value=302
if NumberVariable variable="Mode" comparison_sign="=" value=0
do SetNumberVariable variable="UseRequest" modification_sign="=" value=4

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="TouchCommand" comparison_sign="=" value=305
if NumberVariable variable="Mode" comparison_sign="=" value=0
do SetNumberVariable variable="Action" modification_sign="=" value=1

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="TouchCommand" comparison_sign="=" value=308
if NumberVariable variable="Mode" comparison_sign="=" value=0
do SetNumberVariable variable="TameRequest" modification_sign="=" value=1
do SetNumberVariable variable="FeedingDone" modification_sign="=" value=0

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="TouchCookPending" comparison_sign="=" value=1
if NumberVariable variable="NearFire" comparison_sign="=" value=1
do SetNumberVariable variable="UseRequest" modification_sign="=" value=3
do SetNumberVariable variable="TouchCookPending" modification_sign="=" value=0

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="NearFire" comparison_sign="=" value=0
or NumberVariable variable="Mode" comparison_sign="!=" value=0
do SetNumberVariable variable="TouchCookPending" modification_sign="=" value=0

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="TouchCommand" comparison_sign="=" value=303
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="NearFire" comparison_sign="=" value=1
if NumberVariable variable="Meat" comparison_sign=">" value=0
do SetNumberVariable variable="UseRequest" modification_sign="=" value=3

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="TouchCommand" comparison_sign="=" value=303
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="NearFire" comparison_sign="=" value=1
if PickNearest object="SurvivalFires" x_position=expr(Player3D.X()) y_position=expr(Player3D.Y())
if NumberObjectVariable object="SurvivalFires" variable="Fuel" comparison_sign="<=" value=0
if NumberVariable variable="Meat" comparison_sign=">" value=0
if NumberVariable variable="Wood" comparison_sign=">" value=0
do SetNumberVariable variable="UseRequest" modification_sign="=" value=5
do SetNumberVariable variable="TouchCookPending" modification_sign="=" value=1

@event
if NumberVariable variable="TouchMode" comparison_sign="=" value=1
if NumberVariable variable="TouchCommand" comparison_sign="=" value=303
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="NearFire" comparison_sign="=" value=1
if NumberVariable variable="Meat" comparison_sign="<=" value=0
do SetNumberVariable variable="UseRequest" modification_sign="=" value=5
