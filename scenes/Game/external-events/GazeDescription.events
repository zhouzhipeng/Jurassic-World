@comment "Look at a nearby 3D object to read its description above the object." background=[74,176,228] text=[0,0,0]

@event aiGeneratedEventId="gaze-description-clear"
if NumberVariable variable="Mode" comparison_sign=">=" value=0
do Hide object="GazeDescription"
do SetNumberVariable variable="GazeBest" modification_sign="=" value=100
do SetStringVariable variable="GazeName" modification_sign="=" value=""

@event aiGeneratedEventId="gaze-description-select"
if NumberVariable variable="Mode" comparison_sign="=" value=0
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
if NumberVariable variable="Dead" comparison_sign="=" value=0
if NumberVariable variable="BuildMode" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=0
if NumberVariable variable="Sailing" comparison_sign="=" value=0
> for each "GazeTargets"
>> if Visible object="GazeTargets"
>> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(DistanceBetweenPositions(Player3D.X(),Player3D.Y(),GazeTargets.X(),GazeTargets.Y())) comparison_sign="<" second_expression=1400
>> do SetNumberVariable variable="GazeDX" modification_sign="=" value=expr(GazeTargets.X()-CameraX("World3D",0))
>> do SetNumberVariable variable="GazeDY" modification_sign="=" value=expr(GazeTargets.Y()-CameraY("World3D",0))
>> do SetNumberVariable variable="GazeDZ" modification_sign="=" value=expr(GazeTargets.Object3D::Z()+GazeTargets.Object3D::Depth()*0.5-Scene3D::CameraZ("World3D",0))
>> do SetNumberVariable variable="GazeForward" modification_sign="=" value=expr(GazeDX*Scene3D::CameraForwardX("World3D",0)+GazeDY*Scene3D::CameraForwardY("World3D",0)+GazeDZ*Scene3D::CameraForwardZ("World3D",0))
>>> if NumberVariable variable="GazeForward" comparison_sign=">" value=30
>>> do SetNumberVariable variable="GazeRight" modification_sign="=" value=expr(GazeDX*Scene3D::CameraRightX("World3D",0)+GazeDY*Scene3D::CameraRightY("World3D",0)+GazeDZ*Scene3D::CameraRightZ("World3D",0))
>>> do SetNumberVariable variable="GazeUp" modification_sign="=" value=expr(GazeDX*Scene3D::CameraUpX("World3D",0)+GazeDY*Scene3D::CameraUpY("World3D",0)+GazeDZ*Scene3D::CameraUpZ("World3D",0))
>>> do SetNumberVariable variable="GazeFocal" modification_sign="=" value=expr(SceneWindowHeight()/2/tan(ToRad(Scene3D::CameraFov("World3D",0)/2)))
>>> do SetNumberVariable variable="GazeScreenX" modification_sign="=" value=expr(SceneWindowWidth()/2+GazeRight*GazeFocal/GazeForward)
>>> do SetNumberVariable variable="GazeScreenY" modification_sign="=" value=expr(SceneWindowHeight()/2-GazeUp*GazeFocal/GazeForward)
>>> do SetNumberVariable variable="GazeScore" modification_sign="=" value=expr(abs(GazeScreenX-SceneWindowWidth()/2)/150+abs(GazeScreenY-SceneWindowHeight()*0.38)/120)
>>>> if NumberVariable variable="GazeScore" comparison_sign="<" value=1.1
>>>> if NumberVariable variable="GazeScore" comparison_sign="<" value=expr(GazeBest)
>>>> do SetNumberVariable variable="GazeBest" modification_sign="=" value=expr(GazeScore)
>>>> do SetStringVariable variable="GazeName" modification_sign="=" value=expr(GazeTargets.ObjectName())
>>>> do SetNumberVariable variable="GazeAnchorX" modification_sign="=" value=expr(GazeScreenX)
>>>> do SetNumberVariable variable="GazeAnchorY" modification_sign="=" value=expr(GazeScreenY-max(42,GazeTargets.Object3D::Depth()*GazeFocal/GazeForward*0.35))

> if StringVariable variable="GazeName" comparison_sign="=" value="BerryBush"
> do SetStringVariable variable="GazeLabel" modification_sign="=" value=expr(GazeDescriptions.BerryBush)

> if StringVariable variable="GazeName" comparison_sign="=" value="FiberFern"
> do SetStringVariable variable="GazeLabel" modification_sign="=" value=expr(GazeDescriptions.FiberFern)

> if StringVariable variable="GazeName" comparison_sign="=" value="WoodSapling"
> do SetStringVariable variable="GazeLabel" modification_sign="=" value=expr(GazeDescriptions.WoodSapling)

> if StringVariable variable="GazeName" comparison_sign="=" value="StoneDeposit"
> do SetStringVariable variable="GazeLabel" modification_sign="=" value=expr(GazeDescriptions.StoneDeposit)

> if StringVariable variable="GazeName" comparison_sign="=" value="MetalDeposit"
> do SetStringVariable variable="GazeLabel" modification_sign="=" value=expr(GazeDescriptions.MetalDeposit)

> if StringVariable variable="GazeName" comparison_sign="=" value="SpringWater"
> do SetStringVariable variable="GazeLabel" modification_sign="=" value=expr(GazeDescriptions.SpringWater)

> if StringVariable variable="GazeName" comparison_sign="=" value="CampForge"
> do SetStringVariable variable="GazeLabel" modification_sign="=" value=expr(GazeDescriptions.CampForge)

> if StringVariable variable="GazeName" comparison_sign="=" value="CampHearth"
> do SetStringVariable variable="GazeLabel" modification_sign="=" value=expr(GazeDescriptions.CampHearth)

> if StringVariable variable="GazeName" comparison_sign="=" value="Rowboat"
> do SetStringVariable variable="GazeLabel" modification_sign="=" value=expr(GazeDescriptions.Rowboat)

> if StringVariable variable="GazeName" comparison_sign="=" value="Dinosaur3D"
> do SetStringVariable variable="GazeLabel" modification_sign="=" value=expr(GazeDescriptions.Dinosaur3D)

> if StringVariable variable="GazeName" comparison_sign="=" value="Triceratops"
> do SetStringVariable variable="GazeLabel" modification_sign="=" value=expr(GazeDescriptions.Triceratops)

> if StringVariable variable="GazeName" comparison_sign="=" value="Stegosaur"
> do SetStringVariable variable="GazeLabel" modification_sign="=" value=expr(GazeDescriptions.Stegosaur)

> if StringVariable variable="GazeName" comparison_sign="=" value="Raptor"
> do SetStringVariable variable="GazeLabel" modification_sign="=" value=expr(GazeDescriptions.Raptor)

> if StringVariable variable="GazeName" comparison_sign="=" value="Tyrannosaur"
> do SetStringVariable variable="GazeLabel" modification_sign="=" value=expr(GazeDescriptions.Tyrannosaur)

> if StringVariable variable="GazeName" comparison_sign="=" value="Pterosaur3D"
> do SetStringVariable variable="GazeLabel" modification_sign="=" value=expr(GazeDescriptions.Pterosaur3D)

> if NumberVariable variable="GazeBest" comparison_sign="<" value=1.1
> if StringVariable variable="GazeName" comparison_sign="!=" value=""
> do TextContainerCapability::TextContainerBehavior::SetValue object="GazeDescription" behavior="Text" modification_sign="=" text=expr(GazeLabel)
> do SetX object="GazeDescription" modification_sign="=" value=expr(clamp(GazeAnchorX-GazeDescription.Width()/2,16,SceneWindowWidth()-GazeDescription.Width()-16))
> do SetY object="GazeDescription" modification_sign="=" value=expr(clamp(GazeAnchorY-GazeDescription.Height()-20,68,SceneWindowHeight()-GazeDescription.Height()-16))
> do Show object="GazeDescription"
