@event
if NumberVariable variable="SaveRequested" comparison_sign="=" value=1
do EcrireFichierExp storage_name=expr(SaveStorage) group="HeyinVersion" expression=2
do EcrireFichierExp storage_name=expr(SaveStorage) group="HeyinStage" expression=expr(HeyinStage)
do EcrireFichierExp storage_name=expr(SaveStorage) group="HeyinStay" expression=expr(Heyin.Variable(Stay))
do EcrireFichierExp storage_name=expr(SaveStorage) group="HeyinEnergy" expression=expr(Heyin.Variable(Energy))
do EcrireFichierExp storage_name=expr(SaveStorage) group="HeyinResting" expression=expr(Heyin.Variable(Resting))
do EcrireFichierExp storage_name=expr(SaveStorage) group="HeyinX" expression=expr(Heyin.X())
do EcrireFichierExp storage_name=expr(SaveStorage) group="HeyinY" expression=expr(Heyin.Y())
do EcrireFichierExp storage_name=expr(SaveStorage) group="HeyinAngle" expression=expr(Heyin.Angle())

do EcrireFichierExp storage_name=expr(SaveStorage) group="HeyinHP" expression=expr(Heyin.Variable(HP))
do EcrireFichierExp storage_name=expr(SaveStorage) group="HeyinGrace" expression=expr(Heyin.Variable(Grace))
do EcrireFichierExp storage_name=expr(SaveStorage) group="HeyinTrust" expression=expr(Heyin.Variable(Trust))
do EcrireFichierExp storage_name=expr(SaveStorage) group="HeyinPromise" expression=expr(Heyin.Variable(Promise))
