>> do SetNumberObjectVariable object="PartWall" variable="WorldHY" modification_sign="=" value=expr(abs(sin(ToRad(BuildingRecords[i].Angle)))*150+abs(cos(ToRad(BuildingRecords[i].Angle)))*14)
