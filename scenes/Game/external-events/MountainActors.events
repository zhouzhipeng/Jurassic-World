@event
if NumberVariable variable="RenderMode" comparison_sign="=" value=1
> for each Dinosaur3D
>> if NumberVariable variable="RenderMode" comparison_sign="=" value=1
>> do Scene3D::Base3DBehavior::SetZ parameter_3d_object="Dinosaur3D" behavior="Object3D" modification_sign="=" value=expr(1100*pow(max(0,1-pow(((Dinosaur3D.X())-(800))/2000,2)-pow(((Dinosaur3D.Y())-(-2100))/1700,2)),2)+650*pow(max(0,1-pow(((Dinosaur3D.X())-(-2250))/1100,2)-pow(((Dinosaur3D.Y())-(600))/1700,2)),2)+950*pow(max(0,1-pow(((Dinosaur3D.X())-(2350))/1200,2)-pow(((Dinosaur3D.Y())-(300))/1800,2)),2)+1000*pow(max(0,1-pow(((Dinosaur3D.X())-(-2050))/1400,2)-pow(((Dinosaur3D.Y())-(-2400))/1300,2)),2)+2350*pow(max(0,1-pow(((Dinosaur3D.X())-(-4200))/2000,2)-pow(((Dinosaur3D.Y())-(-4050))/2100,2)),2)+2800*pow(max(0,1-pow(((Dinosaur3D.X())-(2200))/2600,2)-pow(((Dinosaur3D.Y())-(-4450))/1600,2)),2)+1850*pow(max(0,1-pow(((Dinosaur3D.X())-(4450))/1800,2)-pow(((Dinosaur3D.Y())-(1400))/2700,2)),2)+1250*pow(max(0,1-pow(((Dinosaur3D.X())-(-2900))/2500,2)-pow(((Dinosaur3D.Y())-(3950))/1500,2)),2))

