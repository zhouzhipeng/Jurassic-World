if NumberVariable variable="TouchMode" comparison_sign="=" value=expr(1)
if NumberVariable variable="Mode" comparison_sign="=" value=expr(0)
if NumberVariable variable="Dead" comparison_sign="=" value=expr(0)
if NumberVariable variable="RenderMode" comparison_sign="=" value=expr(1)
if NumberVariable variable="TouchMoveId" comparison_sign="!=" value=expr(-999)
do SetNumberVariable variable="MoveX" modification_sign="=" value=expr(TouchMoveX)
do SetNumberVariable variable="MoveY" modification_sign="=" value=expr(TouchMoveY)
do SetNumberVariable variable="MoveSpeed" modification_sign="=" value=expr(350)

if NumberVariable variable="TouchMode" comparison_sign="=" value=expr(1)
if NumberVariable variable="Mode" comparison_sign="=" value=expr(0)
if NumberVariable variable="Dead" comparison_sign="=" value=expr(0)
if NumberVariable variable="RenderMode" comparison_sign="=" value=expr(1)
if NumberVariable variable="TouchMoveId" comparison_sign="!=" value=expr(-999)
if NumberVariable variable="TouchLength" comparison_sign=">" value=expr(TouchRadius*0.95)
if NumberVariable variable="Stamina" comparison_sign=">" value=expr(1)
if NumberObjectVariable object="Player3D" variable="SprintExhausted" comparison_sign="=" value=0
if NumberVariable variable="Riding" comparison_sign="=" value=expr(0)
do SetNumberVariable variable="MoveSpeed" modification_sign="=" value=expr(500)
do SetNumberObjectVariable object="Player3D" variable="Sprinting" modification_sign="=" value=expr(1)
