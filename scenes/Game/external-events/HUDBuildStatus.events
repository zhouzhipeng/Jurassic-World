if NumberVariable variable="Mode" comparison_sign=">=" value=0
do SetNumberObjectVariable object="BuildStatus" variable="Mode" modification_sign="=" value=expr(BuildMode)
do SetNumberObjectVariable object="BuildStatus" variable="Kind" modification_sign="=" value=expr(BuildKind)
do SetNumberObjectVariable object="BuildStatus" variable="Valid" modification_sign="=" value=expr(BuildValid)
do SetNumberObjectVariable object="BuildStatus" variable="Count" modification_sign="=" value=expr(BuildCount)
do SetNumberObjectVariable object="BuildStatus" variable="X" modification_sign="=" value=expr(BuildX)
do SetNumberObjectVariable object="BuildStatus" variable="Y" modification_sign="=" value=expr(BuildY)
do SetNumberObjectVariable object="BuildStatus" variable="Angle" modification_sign="=" value=expr(BuildAngle)
do SetNumberObjectVariable object="BuildStatus" variable="Slot" modification_sign="=" value=expr(BuildSlot)
do SetNumberObjectVariable object="BuildStatus" variable="Warm" modification_sign="=" value=expr(BuildWarm)
do SetNumberObjectVariable object="BuildStatus" variable="Rest" modification_sign="=" value=expr(BuildRest)
do SetNumberObjectVariable object="BuildStatus" variable="Wood" modification_sign="=" value=expr(Wood)
do SetNumberObjectVariable object="BuildStatus" variable="Stone" modification_sign="=" value=expr(Stone)
do SetNumberObjectVariable object="BuildStatus" variable="Fiber" modification_sign="=" value=expr(Fiber)
do SetNumberObjectVariable object="BuildStatus" variable="Z" modification_sign="=" value=expr(BuildZ)
do SetNumberObjectVariable object="BuildStatus" variable="Level" modification_sign="=" value=expr(BuildLevel)
do SetNumberObjectVariable object="BuildStatus" variable="Parent" modification_sign="=" value=expr(BuildParent)
do SetNumberObjectVariable object="BuildStatus" variable="Blocked" modification_sign="=" value=expr(BuildDeleteBlocked)
do SetNumberObjectVariable object="BuildStatus" variable="Floor" modification_sign="=" value=expr(PlayerFloor)
do SetNumberObjectVariable object="BuildStatus" variable="Doors" modification_sign="=" value=expr(DoorSlot)
do SetNumberObjectVariable object="BuildStatus" variable="Placed" modification_sign="=" value=expr(BuildPlacedKind)
