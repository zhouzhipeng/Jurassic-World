@event
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Construction.ToggleDoor"
> @js objects=Object strict=true
const world = objects[0] ? objects[0].getRuntimeScene() : runtimeScene;
const slot = Number(eventsFunctionContext.getArgument("Payload"));
const door = world.getObjects("PartDoor").find(item =>
  item.getVariables().get("Slot").getAsNumber() === slot);
if (!door) return;
const state = 1 - door.getVariables().get("Open").getAsNumber();
door.getVariables().get("Open").setNumber(state);
for (const controller of objects) controller.getVariables().get("DoorJSON")
  .setString(JSON.stringify({ Slot: slot, Open: state }));
> @end js

