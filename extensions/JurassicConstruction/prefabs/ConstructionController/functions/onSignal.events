@event
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Construction.Restore"
> @js objects=Object strict=true
const names = new Map([[1, "BuiltShelter"], [2, "BuiltPalisade"], [3, "BuiltCampfire"],
  [10, "PartFoundation"], [11, "PartPillar"], [12, "PartWall"],
  [13, "PartDoorframe"], [14, "PartCeiling"], [15, "PartDoor"], [16, "PartStairs"]]);
let records = [];
try {
  const parsed = JSON.parse(String(eventsFunctionContext.getArgument("Payload")));
  if (Array.isArray(parsed)) records = parsed;
} catch (error) {
  records = [];
}
for (const name of names.values()) {
  for (const instance of runtimeScene.getObjects(name).slice()) instance.deleteFromScene();
}
let count = 0;
for (let slot = 0; slot < Math.min(128, records.length); slot++) {
  const record = records[slot];
  if (!record || typeof record !== "object") continue;
  const name = names.get(Number(record.Kind));
  if (!name) continue;
  const instance = runtimeScene.createObject(name);
  if (!instance) continue;
  const x = Number(record.X) || 0;
  const y = Number(record.Y) || 0;
  const z = Number(record.Z) || 0;
  const angle = Number(record.Angle) || 0;
  instance.setLayer("World3D");
  instance.setPosition(x, y);
  instance.setAngle(angle);
  const variables = instance.getVariables();
  variables.get("Slot").setNumber(slot);
  if (Number(record.Kind) >= 10) {
    variables.get("BaseZ").setNumber(z);
    variables.get("Level").setNumber(Number(record.Level) || 0);
    variables.get("Parent").setNumber(Number(record.Parent) || 0);
    variables.get("Open").setNumber(Number(record.Open) || 0);
    variables.get("BaseAngle").setNumber(angle);
  }
  const radians = angle * Math.PI / 180;
  const hx = variables.get("HX").getAsNumber();
  const hy = variables.get("HY").getAsNumber();
  variables.get("WorldHX").setNumber(Math.abs(Math.cos(radians)) * hx + Math.abs(Math.sin(radians)) * hy);
  variables.get("WorldHY").setNumber(Math.abs(Math.sin(radians)) * hx + Math.abs(Math.cos(radians)) * hy);
  count++;
}
for (const controller of objects) controller.getVariables().get("RestoreCount").setNumber(count);
> @end js

@event
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Construction.Restore"
do EmitSceneSignal signal_name="Construction.Restored" payload=expr(ToString(Object.Variable(RestoreCount)))
