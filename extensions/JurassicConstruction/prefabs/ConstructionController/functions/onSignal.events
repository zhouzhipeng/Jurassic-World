@event
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Construction.Restore"
> @js objects=Object strict=true
const names = new Map([[1, "BuiltShelter"], [2, "BuiltPalisade"], [3, "BuiltCampfire"],
  [10, "PartFoundation"], [11, "PartPillar"], [12, "PartWall"],
  [13, "PartDoorframe"], [14, "PartCeiling"], [15, "PartDoor"], [16, "PartStairs"]]);
let records = [];
const payload = String(eventsFunctionContext.getArgument("Payload"));
const worldScene = objects[0] ? objects[0].getRuntimeScene() : runtimeScene;
try {
  const parsed = JSON.parse(payload);
  if (Array.isArray(parsed)) records = parsed;
} catch (error) {
  records = [];
}
for (const name of names.values()) {
  for (const instance of worldScene.getObjects(name).slice()) instance.deleteFromScene();
}
let count = 0;
for (let slot = 0; slot < Math.min(128, records.length); slot++) {
  const record = records[slot];
  if (!record || typeof record !== "object") continue;
  const name = names.get(Number(record.Kind));
  if (!name) continue;
  const instance = worldScene.createObject(name);
  if (!instance) continue;
  const x = Number(record.X) || 0;
  const y = Number(record.Y) || 0;
  const z = Number(record.Z) || 0;
  const angle = Number(record.Angle) || 0;
  instance.setLayer("World3D");
  instance.setPosition(x, y);
  instance.setAngle(angle);
  const variables = instance.getVariables();
  variables.get("Slot").setNumber(slot);
  if (Number(record.Kind) >= 10) {
    variables.get("BaseZ").setNumber(z);
    variables.get("Level").setNumber(Number(record.Level) || 0);
    variables.get("Parent").setNumber(Number(record.Parent) || 0);
    variables.get("Open").setNumber(Number(record.Open) || 0);
    variables.get("BaseAngle").setNumber(angle);
  }
  const radians = angle * Math.PI / 180;
  const hx = variables.get("HX").getAsNumber();
  const hy = variables.get("HY").getAsNumber();
  variables.get("WorldHX").setNumber(Math.abs(Math.cos(radians)) * hx + Math.abs(Math.sin(radians)) * hy);
  variables.get("WorldHY").setNumber(Math.abs(Math.sin(radians)) * hx + Math.abs(Math.cos(radians)) * hy);
  count++;
}
for (const controller of objects) {
  controller.getVariables().get("RestoreCount").setNumber(count);
  controller.getVariables().get("LastPayloadLength").setNumber(payload.length);
  controller.getVariables().get("LastParsedCount").setNumber(records.length);
}
> @end js

@event
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Construction.Restore"
do EmitSceneSignal signal_name="Construction.Restored" payload=expr(ToString(Object.Variable(RestoreCount)))
do EmitSceneSignal signal_name="Construction.RecordsRestored" payload=expr(Payload)

@event
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Construction.Save"
> @js objects=Object strict=true
const worldScene = objects[0] ? objects[0].getRuntimeScene() : runtimeScene;
const names = [{ kind: 1, name: "BuiltShelter" }, { kind: 2, name: "BuiltPalisade" },
  { kind: 3, name: "BuiltCampfire" }, { kind: 10, name: "PartFoundation" },
  { kind: 11, name: "PartPillar" }, { kind: 12, name: "PartWall" },
  { kind: 13, name: "PartDoorframe" }, { kind: 14, name: "PartCeiling" },
  { kind: 15, name: "PartDoor" }, { kind: 16, name: "PartStairs" }];
const records = Array.from({ length: 128 }, () =>
  ({ Kind: 0, X: 0, Y: 0, Z: 0, Angle: 0, Level: 0, Parent: -1, Open: 0 }));
for (const { kind, name } of names) {
  for (const instance of worldScene.getObjects(name)) {
    const vars = instance.getVariables();
    const slot = vars.get("Slot").getAsNumber();
    if (!Number.isInteger(slot) || slot < 0 || slot >= records.length) continue;
    records[slot] = { Kind: kind, X: instance.getX(), Y: instance.getY(),
      Z: vars.get("BaseZ").getAsNumber(), Angle: instance.getAngle(),
      Level: vars.get("Level").getAsNumber(), Parent: vars.get("Parent").getAsNumber(),
      Open: vars.get("Open").getAsNumber() };
  }
}
for (const controller of objects) controller.getVariables().get("SaveJSON").setString(JSON.stringify(records));
> @end js

@event
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Construction.Save"
do EcrireFichierTxt storage_name=expr(Payload) group="BuildingsV2" text=expr(Object.VariableString(SaveJSON))

@event
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Construction.Load"
do SetStringVariable variable="ConstructionLoadedJSON" modification_sign="=" value="[]"
> @js objects=Object strict=true
for (const controller of objects) {
  const variables = controller.getVariables();
  variables.get("LoadRequests").add(1);
  variables.get("LastLoadStorage").setString(String(eventsFunctionContext.getArgument("Payload")));
}
> @end js

