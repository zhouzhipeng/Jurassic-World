@event
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Construction.Remove"
> @js objects=Object strict=true
const world = objects[0] ? objects[0].getRuntimeScene() : runtimeScene;
const slot = Number(eventsFunctionContext.getArgument("Payload"));
if (!Number.isInteger(slot) || slot < 0 || slot >= 128) return;
/** @type {Array<[number, string]>} */
const types = [[1, "BuiltShelter"], [2, "BuiltPalisade"], [3, "BuiltCampfire"],
  [10, "PartFoundation"], [11, "PartPillar"], [12, "PartWall"],
  [13, "PartDoorframe"], [14, "PartCeiling"], [15, "PartDoor"], [16, "PartStairs"]];
let target = null;
let kind = 0;
for (const [type, name] of types) {
  target = world.getObjects(name).find(item => item.getVariables().get("Slot").getAsNumber() === slot);
  if (target) { kind = type; break; }
}
if (!target) return;
for (const name of ["PartFoundation", "PartPillar", "PartWall", "PartDoorframe",
  "PartCeiling", "PartDoor", "PartStairs"]) {
  if (world.getObjects(name).some(item => item.getVariables().get("Parent").getAsNumber() === slot)) return;
}
target.deleteFromScene();
/** @type {Record<number, number[]>} */
const costs = { 1: [10, 5, 8], 2: [4, 0, 2], 3: [3, 3, 0],
  10: [6, 2, 3], 11: [3, 0, 1], 12: [4, 0, 2], 13: [4, 0, 2],
  14: [5, 0, 3], 15: [3, 0, 1], 16: [6, 0, 3] };
const refund = costs[kind].map(value => Math.floor(value / 2));
for (const controller of objects) controller.getVariables().get("RemoveJSON")
  .setString(JSON.stringify({ Slot: slot, Kind: kind, Wood: refund[0],
    Stone: refund[1], Fiber: refund[2] }));
> @end js

