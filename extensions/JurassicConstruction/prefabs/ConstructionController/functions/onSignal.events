@event
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Construction.Save"
> @js objects=Object strict=true
const worldScene = objects[0] ? objects[0].getRuntimeScene() : runtimeScene;
const names = [{ kind: 1, name: "BuiltShelter" }, { kind: 2, name: "BuiltPalisade" },
  { kind: 3, name: "BuiltCampfire" }, { kind: 10, name: "PartFoundation" },
  { kind: 11, name: "PartPillar" }, { kind: 12, name: "PartWall" },
  { kind: 13, name: "PartDoorframe" }, { kind: 14, name: "PartCeiling" },
  { kind: 15, name: "PartDoor" }, { kind: 16, name: "PartStairs" }];
const records = Array.from({ length: 128 }, () =>
  ({ Kind: 0, X: 0, Y: 0, Z: 0, Angle: 0, Level: 0, Parent: -1, Open: 0 }));
for (const { kind, name } of names) {
  for (const instance of worldScene.getObjects(name)) {
    const vars = instance.getVariables();
    const slot = vars.get("Slot").getAsNumber();
    if (!Number.isInteger(slot) || slot < 0 || slot >= records.length) continue;
    records[slot] = { Kind: kind,
      X: kind === 15 ? vars.get("BaseX").getAsNumber() : instance.getX(),
      Y: kind === 15 ? vars.get("BaseY").getAsNumber() : instance.getY(),
      Z: vars.get("BaseZ").getAsNumber(),
      Angle: kind === 15 ? vars.get("BaseAngle").getAsNumber() : instance.getAngle(),
      Level: vars.get("Level").getAsNumber(), Parent: vars.get("Parent").getAsNumber(),
      Open: vars.get("Open").getAsNumber() };
  }
}
for (const controller of objects) controller.getVariables().get("SaveJSON").setString(JSON.stringify(records));
> @end js

