@event
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Active) comparison_sign="=" second_expression=1
do ModVarObjet object="Object" variable="Moving" modification_sign="=" value=expr(0)
do ModVarObjet object="Object" variable="Blocked" modification_sign="=" value=expr(0)
do ModVarObjet object="Object" variable="PX" modification_sign="=" value=expr(Object.X())
do ModVarObjet object="Object" variable="PY" modification_sign="=" value=expr(Object.Y())
do ModVarObjet object="Object" variable="Distance" modification_sign="=" value=expr(DistanceBetweenPositions(Object.X(),Object.Y(),Player.X(),Player.Y()))

@event
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Active) comparison_sign="=" second_expression=1
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Object.Variable(Distance)) comparison_sign="<" second_expression=230
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(CanTalk) comparison_sign="=" second_expression=1
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Danger) comparison_sign="=" second_expression=0
do ModVarObjet object="Object" variable="Attention" modification_sign="=" value=expr(1)

