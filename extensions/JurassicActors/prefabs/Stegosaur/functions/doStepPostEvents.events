if VarObjet object="Object" variable="SpawnReady" comparison_sign="=" value=0
do ModVarObjet object="Object" variable="HomeX" modification_sign="=" value=expr(Object.X())
do ModVarObjet object="Object" variable="HomeY" modification_sign="=" value=expr(Object.Y())
do ModVarObjet object="Object" variable="PX" modification_sign="=" value=expr(Object.X())
do ModVarObjet object="Object" variable="PY" modification_sign="=" value=expr(Object.Y())
do ModVarObjet object="Object" variable="TargetX" modification_sign="=" value=expr(Object.X())
do ModVarObjet object="Object" variable="TargetY" modification_sign="=" value=expr(Object.Y())
do ModVarObjet object="Object" variable="SpawnReady" modification_sign="=" value=1

if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Object.Variable(AnimationState)) comparison_sign="=" second_expression=0
do AnimatableCapability::AnimatableBehavior::SetName object="Body" behavior="Animation" modification_sign="=" animation_name="Idle"

if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Object.Variable(AnimationState)) comparison_sign="=" second_expression=1
do AnimatableCapability::AnimatableBehavior::SetName object="Body" behavior="Animation" modification_sign="=" animation_name="Walk"

if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Object.Variable(AnimationPlaying)) comparison_sign="=" second_expression=1
do AnimatableCapability::AnimatableBehavior::PlayAnimation object="Body" behavior="Animation"

if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Object.Variable(AnimationPlaying)) comparison_sign="=" second_expression=0
do AnimatableCapability::AnimatableBehavior::PauseAnimation object="Body" behavior="Animation"

